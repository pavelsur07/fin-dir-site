{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Ваш Финдир · Design Tokens v2.0 · единственный источник правды. Формат W3C DTCG.",
  "primitive": {
    "color": {
      "$type": "color",
      "white": { "$value": "#FFFFFF" },
      "ink": {
        "50": { "$value": "#F4F6F9" }, "100": { "$value": "#E8EBF1" }, "200": { "$value": "#D2D8E2" },
        "300": { "$value": "#AEB7C8" }, "400": { "$value": "#8490A8" }, "500": { "$value": "#5E6A85" },
        "600": { "$value": "#434F6B" }, "700": { "$value": "#2E3953" }, "800": { "$value": "#1F2840" },
        "900": { "$value": "#141B2E" }, "950": { "$value": "#0B1020", "$description": "Бренд · rgb(11 16 32)" }
      },
      "crimson": {
        "50": { "$value": "#FEF2F3" }, "100": { "$value": "#FDE4E7" }, "200": { "$value": "#FAC8CE" },
        "300": { "$value": "#F59DA8" }, "400": { "$value": "#EE6B7C" }, "500": { "$value": "#E23B52" },
        "600": { "$value": "#CC1A36" }, "700": { "$value": "#B00020", "$description": "Бренд · rgb(176 0 32)" },
        "800": { "$value": "#8A001B" }, "900": { "$value": "#5E0012" }, "950": { "$value": "#3D000B" }
      }
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "{primitive.color.white}" },
      "subtle": { "$value": "{primitive.color.ink.50}" },
      "muted": { "$value": "{primitive.color.ink.100}" },
      "inverse": { "$value": "{primitive.color.ink.950}" },
      "inverse-raised": { "$value": "{primitive.color.ink.900}" }
    },
    "fg": {
      "default": { "$value": "{primitive.color.ink.950}" },
      "secondary": { "$value": "{primitive.color.ink.600}" },
      "muted": { "$value": "{primitive.color.ink.500}" },
      "disabled": { "$value": "{primitive.color.ink.400}" },
      "inverse": { "$value": "{primitive.color.white}" },
      "on-accent": { "$value": "{primitive.color.white}" }
    },
    "border": {
      "default": { "$value": "{primitive.color.ink.200}" },
      "subtle": { "$value": "{primitive.color.ink.100}" },
      "strong": { "$value": "{primitive.color.ink.300}" }
    },
    "accent": {
      "default": { "$value": "{primitive.color.crimson.700}" },
      "hover": { "$value": "{primitive.color.crimson.800}" },
      "active": { "$value": "{primitive.color.crimson.900}" },
      "text": { "$value": "{primitive.color.crimson.700}" },
      "subtle": { "$value": "{primitive.color.crimson.100}" },
      "subtle-fg": { "$value": "{primitive.color.crimson.800}" }
    },
    "focus": { "$value": "{primitive.color.crimson.700}" },
    "success": { "fg": { "$value": "#0F6B40" }, "bg": { "$value": "#E3F3EA" }, "border": { "$value": "#A8D9BD" } },
    "warning": { "fg": { "$value": "#8A4B00" }, "bg": { "$value": "#FFF2DB" }, "border": { "$value": "#F5C979" } },
    "error":   { "fg": { "$value": "#B3300A" }, "bg": { "$value": "#FDECE6" }, "border": { "$value": "#F4B39E" } },
    "info":    { "fg": { "$value": "#1D4FA8" }, "bg": { "$value": "#E6EEFB" }, "border": { "$value": "#A9C2EE" } },
    "chart": {
      "1": { "$value": "#2E3953" }, "2": { "$value": "#B00020" }, "3": { "$value": "#3A7CA5" }, "4": { "$value": "#D98E04" },
      "5": { "$value": "#2A9D8F" }, "6": { "$value": "#7B5BA8" }, "7": { "$value": "#8490A8" }, "8": { "$value": "#6B8F3A" },
      "income": { "$value": "#1F9D63" }, "expense": { "$value": "#AEB7C8" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "display": { "$value": ["Manrope", "Inter", "system-ui", "sans-serif"] }
    }
  },
  "typography": {
    "$type": "typography",
    "t1": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "48px", "lineHeight": "56px", "letterSpacing": "-0.02em" }, "$description": "Display / H1 · моб 36/44" },
    "t2": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "36px", "lineHeight": "44px", "letterSpacing": "-0.02em" }, "$description": "H2 · моб 30/38" },
    "t3": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "20px", "lineHeight": "28px", "letterSpacing": "-0.02em" }, "$description": "H3" },
    "t4": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "18px", "lineHeight": "28px", "letterSpacing": "0" }, "$description": "Lead" },
    "t5": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "16px", "lineHeight": "26px", "letterSpacing": "0" }, "$description": "Body" },
    "t6": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 500, "fontSize": "14px", "lineHeight": "22px", "letterSpacing": "0" }, "$description": "Small / UI" },
    "t7": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 500, "fontSize": "12px", "lineHeight": "18px", "letterSpacing": "0" }, "$description": "Caption" },
    "button": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "16px", "lineHeight": "26px" } },
    "button-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "14px", "lineHeight": "22px" } },
    "control": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "16px", "lineHeight": "26px" }, "$description": "Текст в полях ввода — 16 px, чтобы iOS не зумил" },
    "table": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "22px" } },
    "t8": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "30px", "lineHeight": "38px", "letterSpacing": "0" }, "$description": "Число, tabular-nums" }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" }, "0-5": { "$value": "2px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" },
    "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" },
    "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" }, "xs": { "$value": "4px" }, "sm": { "$value": "8px" }, "md": { "$value": "12px" },
    "lg": { "$value": "16px" }, "xl": { "$value": "24px" }, "full": { "$value": "9999px" }
  },
  "control": {
    "$type": "dimension",
    "lg": { "$value": "48px" }, "md": { "$value": "40px" }, "sm": { "$value": "32px" }, "touch-min": { "$value": "44px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": [
      { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "rgba(11,16,32,0.06)" },
      { "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0", "color": "rgba(11,16,32,0.10)" } ] },
    "md": { "$value": [
      { "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "-2px", "color": "rgba(11,16,32,0.12)" },
      { "offsetX": "0", "offsetY": "2px", "blur": "4px", "spread": "0", "color": "rgba(11,16,32,0.06)" } ] },
    "lg": { "$value": { "offsetX": "0", "offsetY": "24px", "blur": "48px", "spread": "-12px", "color": "rgba(11,16,32,0.28)" } }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "0ms" }, "fast": { "$value": "120ms" }, "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }, "deliberate": { "$value": "480ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": { "$value": [0.2, 0, 0, 1] }, "in": { "$value": [0.4, 0, 1, 1] }, "standard": { "$value": [0.4, 0, 0.2, 1] }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 }, "sticky": { "$value": 100 }, "dropdown": { "$value": 200 }, "overlay": { "$value": 300 },
    "modal": { "$value": 400 }, "toast": { "$value": 500 }, "tooltip": { "$value": 600 }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1440px" }
  }
}
