# Скопировать рядом в .env -- он в git не попадает (см. .gitignore).
# Репозиторий ПУБЛИЧНЫЙ: реальные значения сюда не вписывать, только плейсхолдеры.

# Аккаунт Let's Encrypt: на этот адрес приходят уведомления об истечении
# сертификатов. Используется только при регистрации ACME-аккаунта.
ACME_EMAIL=admin@example.com
