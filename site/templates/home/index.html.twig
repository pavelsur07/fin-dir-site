{% extends 'base.html.twig' %}
{% block body %}

<!-- Section 2: Hero -->
<section id="hero" class="section hero-section py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="section-eyebrow">Финансовый директор + SaaS-платформа</div>
                <h1 class="hero-title mb-4">Финансовый учёт для селлеров <em>маркетплейсов</em></h1>
                <p class="lead hero-lead mb-4">ДДС, ОПиУ, Баланс, планирование и unit-экономика — управляйте бизнесом по цифрам, а не по ощущениям.</p>
                <div class="hero-actions d-flex flex-column flex-md-row gap-2 gap-md-3">
                    <a href="#contact" class="btn btn-primary btn-lg js-cta-click">Получить консультацию</a>
                    <a href="https://t.me/your_channel" class="btn btn-outline-secondary btn-lg js-telegram-click" target="_blank" rel="noopener">Читать канал</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-card">
                    <div class="hero-card-header d-flex align-items-center justify-content-between px-4 py-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="hero-dot"></span>
                            <span class="hero-dot"></span>
                            <span class="hero-dot"></span>
                        </div>
                        <span class="metric-label">Dashboard</span>
                    </div>
                    <div class="p-4 p-lg-5">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <div class="metric-card p-3">
                                    <div class="metric-label mb-2">Выручка</div>
                                    <div class="metric-value">5,8 млн</div>
                                    <div class="text-muted-brand small">+18% MoM</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-card p-3">
                                    <div class="metric-label mb-2">EBITDA</div>
                                    <div class="metric-value">14,2%</div>
                                    <div class="text-muted-brand small">после расходов</div>
                                </div>
                            </div>
                        </div>
                        <div class="metric-card p-4 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="metric-label">Unit-экономика</span>
                                <span class="badge rounded-pill text-bg-light">WB / Ozon</span>
                            </div>
                            <div class="progress mb-3" role="progressbar" aria-label="Доля прибыльных SKU" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: 72%; background: var(--ink);"></div>
                            </div>
                            <div class="d-flex justify-content-between small text-muted-brand">
                                <span>72% SKU прибыльные</span>
                                <span>18 SKU требуют решения</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3">
                            <span class="icon-pill"><i class="bi bi-shield-check"></i></span>
                            <p class="mb-0 text-ink-soft">Единая система: интеграции, отчёты, контроль кассового разрыва и управленческие решения.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Problems -->
<section id="problems" class="section py-5 bg-white">
    <div class="container">
        <div class="row justify-content-between align-items-end mb-4 mb-lg-5">
            <div class="col-lg-7">
                <div class="section-eyebrow">Боли собственника</div>
                <h2 class="section-title display-5 mb-3">Знакомо?</h2>
                <p class="section-subtitle mb-0">Когда цифры живут в разных таблицах, бизнес растёт вслепую: оборот есть, а управляемости нет.</p>
            </div>
        </div>
        <div class="row g-3 g-lg-4">
            <div class="col-md-6 col-lg-3">
                <div class="card-ui p-4">
                    <span class="icon-pill mb-4"><i class="bi bi-question-circle"></i></span>
                    <p class="h5 mb-0">Не понимаю, зарабатываю я или нет</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card-ui p-4">
                    <span class="icon-pill mb-4"><i class="bi bi-cash-stack"></i></span>
                    <p class="h5 mb-0">Выручка растёт, а денег нет</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card-ui p-4">
                    <span class="icon-pill mb-4"><i class="bi bi-calculator"></i></span>
                    <p class="h5 mb-0">Unit-экономику считаю на глаз</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card-ui p-4">
                    <span class="icon-pill mb-4"><i class="bi bi-compass"></i></span>
                    <p class="h5 mb-0">Решения принимаю по ощущениям, а не по цифрам</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 4: Services -->
<section id="services" class="section py-5" style="background: var(--bg);">
    <div class="container">
        <div class="text-center mx-auto mb-4 mb-lg-5" style="max-width: 760px;">
            <div class="section-eyebrow">Система управления финансами</div>
            <h2 class="section-title display-5 mb-3">Что вы получите</h2>
            <p class="section-subtitle mx-auto mb-0">Не набор отчётов ради отчётов, а рабочую систему, которая помогает видеть прибыль, деньги, риски и решения.</p>
        </div>
        <div class="row g-3 g-lg-4">
            <div class="col-md-6 col-lg-4">
                <div class="card-ui service-card-main p-4 p-lg-5">
                    <span class="icon-pill mb-4"><i class="bi bi-wallet2"></i></span>
                    <h5 class="mb-3">ДДС</h5>
                    <p class="mb-0">Движение денежных средств: видно, куда уходят деньги и где возникает кассовый разрыв.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card-ui p-4 p-lg-5">
                    <span class="icon-pill mb-4"><i class="bi bi-graph-up-arrow"></i></span>
                    <h5 class="mb-3">ОПиУ</h5>
                    <p class="mb-0 text-muted-brand">Отчёт о прибылях и убытках: реальная прибыль, а не оборот в личном кабинете маркетплейса.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card-ui p-4 p-lg-5">
                    <span class="icon-pill mb-4"><i class="bi bi-columns-gap"></i></span>
                    <h5 class="mb-3">Баланс</h5>
                    <p class="mb-0 text-muted-brand">Полная картина активов, обязательств, запасов, денег и капитала собственника.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card-ui p-4 p-lg-5">
                    <span class="icon-pill mb-4"><i class="bi bi-calendar3"></i></span>
                    <h5 class="mb-3">Планирование</h5>
                    <p class="mb-0 text-muted-brand">Финансовые планы, бюджеты, платежный календарь и прогноз денег на ближайшие периоды.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card-ui service-card-accent p-4 p-lg-5">
                    <span class="icon-pill mb-4"><i class="bi bi-box-seam"></i></span>
                    <h5 class="mb-3">Unit-экономика</h5>
                    <p class="mb-0">Прибыльность каждого товара, направления и канала с учётом комиссий, логистики и себестоимости.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card-ui p-4 p-lg-5">
                    <span class="icon-pill mb-4"><i class="bi bi-plug"></i></span>
                    <h5 class="mb-3">Интеграция с маркетплейсами</h5>
                    <p class="mb-0 text-muted-brand">Автоматический сбор данных с Wildberries и Ozon, меньше ручного труда и ошибок в таблицах.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 5: How it works -->
<section id="how-it-works" class="section dark-section py-5">
    <div class="container">
        <div class="text-center mx-auto mb-4 mb-lg-5" style="max-width: 720px;">
            <div class="section-eyebrow">Процесс</div>
            <h2 class="section-title display-5 mb-3">Как это работает</h2>
            <p class="mb-0" style="color: var(--white-muted);">Внедряем финансовую систему без лишней бюрократии: подключаем данные, строим отчёты, превращаем цифры в управленческие решения.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card p-4 p-lg-5">
                    <div class="step-number mb-4">1</div>
                    <h5 class="mb-3">Подключаемся</h5>
                    <p class="mb-0" style="color: var(--white-muted);">Настраиваем интеграцию с вашим маркетплейсом и банком, собираем исходные данные.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card p-4 p-lg-5">
                    <div class="step-number mb-4">2</div>
                    <h5 class="mb-3">Строим учёт</h5>
                    <p class="mb-0" style="color: var(--white-muted);">Формируем ДДС, ОПиУ, Баланс, настраиваем аналитику и правила распределения.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card p-4 p-lg-5">
                    <div class="step-number mb-4">3</div>
                    <h5 class="mb-3">Вы управляете</h5>
                    <p class="mb-0" style="color: var(--white-muted);">Принимаете решения на основе цифр, моделируете последствия и контролируете прибыль.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 6: Case -->
<section id="case" class="section case-section py-5">
    <div class="container">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-5">
                <div class="section-eyebrow">Кейс</div>
                <h2 class="section-title display-5 mb-3">Результат клиента</h2>
                <p class="section-subtitle mb-0">Пример, как финансовая система превращает разрозненные цифры маркетплейса в понятную картину бизнеса.</p>
            </div>
            <div class="col-lg-7">
                <div class="case-card p-4 p-lg-5">
                    <h3 class="h4 mb-4">Селлер на Wildberries, оборот 5 млн/мес</h3>
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="case-label mb-2">Проблема</div>
                            <p class="mb-0 text-ink-soft">Оборот рос, но собственник не видел реальную прибыль, кассовые разрывы и товары с отрицательной маржинальностью.</p>
                        </div>
                        <div class="col-md-4">
                            <div class="case-label mb-2">Что сделали</div>
                            <p class="mb-0 text-ink-soft">Собрали ДДС, ОПиУ, баланс, unit-экономику SKU и правила контроля платежей.</p>
                        </div>
                        <div class="col-md-4">
                            <div class="case-label mb-2">Результат</div>
                            <p class="mb-0 text-ink-soft">Нашли слабые SKU, пересобрали закупки и сделали прогноз денег на 30 дней.</p>
                        </div>
                    </div>
                    <div class="row g-3 align-items-stretch mb-4">
                        <div class="col-sm-4">
                            <div class="metric-card p-3">
                                <div class="result-number">30</div>
                                <div class="text-muted-brand small">дней прогноза денег</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="metric-card p-3">
                                <div class="result-number">18</div>
                                <div class="text-muted-brand small">SKU на пересмотр</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="metric-card p-3">
                                <div class="result-number">1</div>
                                <div class="text-muted-brand small">единый источник правды</div>
                            </div>
                        </div>
                    </div>
                    <blockquote class="quote-card p-4 mb-0">
                        <p class="mb-2">«Стало понятно, какие решения дают деньги, а какие просто увеличивают оборот».</p>
                        <footer class="text-muted-brand small">Собственник e-commerce бизнеса</footer>
                    </blockquote>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 7: Telegram -->
<section id="telegram" class="section py-5 bg-white">
    <div class="container">
        <div class="telegram-card p-4 p-lg-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="section-eyebrow">Telegram-канал</div>
                    <h2 class="section-title display-6 mb-3">Разбираю реальные кейсы финучёта</h2>
                    <p class="section-subtitle mb-0">Показываю, как читать ДДС, ОПиУ, Баланс и unit-экономику без сложной теории. Практические разборы для собственников маркетплейс-бизнеса.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="https://t.me/vashfindir_ru" class="btn btn-primary btn-lg w-100 w-lg-auto js-telegram-click" target="_blank" rel="noopener">
                        <i class="bi bi-telegram me-2"></i>Подписаться на канал
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 8: Contact -->
<section id="contact" class="section contact-section py-5">
    <div class="container">
        <div class="text-center mx-auto mb-4 mb-lg-5" style="max-width: 720px;">
            <div class="section-eyebrow">Заявка</div>
            <h2 class="section-title display-5 mb-3">Получить консультацию</h2>
            <p class="section-subtitle mx-auto mb-0">Обсудим, как навести порядок в финансах вашего бизнеса и какие отчёты нужны в первую очередь.</p>
        </div>
        <div class="row">
            <div class="col-md-8 col-lg-6 mx-auto">
                <div class="contact-card p-4 p-lg-5">
                    <form id="leadForm" action="/landing/contact" method="post" novalidate>
                        <div class="mb-3">
                            <label for="leadName" class="form-label">Имя</label>
                            <input type="text" class="form-control" id="leadName" name="name" placeholder="Как к вам обращаться" required>
                        </div>
                        <div class="mb-4">
                            <label for="leadContact" class="form-label">Telegram или телефон</label>
                            <input type="text" class="form-control" id="leadContact" name="contact" placeholder="@username или номер телефона" required>
                        </div>
                        <button type="submit" class="btn btn-light-ink btn-lg w-100">Отправить</button>
                        <div id="leadSuccess" class="success-message mt-4 p-3" role="status" aria-live="polite">
                            Спасибо! Свяжусь с вами в ближайшее время.
                        </div>
                        <p class="small text-muted-brand mt-3 mb-0">Нажимая кнопку, вы соглашаетесь с обработкой персональных данных.</p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}
