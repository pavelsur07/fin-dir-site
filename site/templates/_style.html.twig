    }

    .blog-author-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        flex: 0 0 auto;
        border-radius: var(--radius-brand);
        color: var(--white);
        background: var(--ink);
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1;
    }

    .blog-author-name {
        margin: 0;
        color: var(--ink);
        font-weight: 800;
        letter-spacing: -.025em;
        line-height: 1.2;
    }

    .blog-author-role {
        margin: .15rem 0 0;
