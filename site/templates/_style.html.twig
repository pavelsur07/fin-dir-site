<style>
    :root {
        /* Brand colors */
        --brand-red: #B00020;
        --brand-dark: #8A0019;
        --brand: var(--brand-red);

        /* Text colors */
        --ink: #0B1020;
        --ink-soft: #1A2033;
        --muted: #5C677D;

        /* Surface colors */
        --bg: #F5F6F8;
        --bg-soft: #ECEEF2;
        --white: #FFFFFF;
        --line: rgba(10,21,72,.14);

        /* Radius system */
        --radius-brand: .625rem;

        /* Bootstrap radius bridge */
        --bs-border-radius: var(--radius-brand);
        --bs-border-radius-sm: var(--radius-brand);
        --bs-border-radius-lg: var(--radius-brand);
        --bs-border-radius-xl: var(--radius-brand);
        --bs-border-radius-xxl: var(--radius-brand);
        --bs-border-radius-pill: var(--radius-brand);

        /* Bootstrap base bridge */
        --bs-body-color: var(--ink);
        --bs-body-bg: var(--bg);
        --bs-primary: var(--ink);
        --bs-primary-rgb: 11, 16, 32;
        --bs-link-color: var(--ink);
        --bs-link-hover-color: var(--brand);

        /* Additional derived tokens */
        --shadow-soft: 0 18px 60px rgba(10,21,72,.08);
        --shadow-strong: 0 24px 70px rgba(10,21,72,.14);
        --white-soft-line: rgba(255,255,255,.14);
        --white-muted: rgba(255,255,255,.76);
        --white-faint: rgba(255,255,255,.08);
        --brand-light-bg: color-mix(in srgb, var(--brand) 8%, var(--white));
        --ink-light-bg: color-mix(in srgb, var(--ink) 5%, var(--white));
        --header-height: 4.5rem;
        --header-anchor-offset: calc(var(--header-height) + 1rem);
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: var(--header-anchor-offset);
    }

    body {
        padding-top: var(--header-height);
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
    }

    a {
        color: inherit;
    }

    .section {
        position: relative;
        overflow: hidden;
    }

    .section[id] {
        scroll-margin-top: var(--header-anchor-offset);
    }

    .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1rem;
        color: var(--muted);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .12em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .section-eyebrow::before {
        content: '';
        width: .5rem;
        height: .5rem;
        border-radius: var(--radius-brand);
        background: var(--brand);
        flex: 0 0 auto;
    }

    .section-title {
        color: var(--ink);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.08;
    }

    .section-subtitle {
        color: var(--ink-soft);
        max-width: 720px;
    }

    .text-muted-brand {
        color: var(--muted) !important;
    }

    .text-ink-soft {
        color: var(--ink-soft) !important;
    }

    /* Reusable UI primitives for base template */
    .vf-radius,
    .vf-card,
    .vf-chip,
    .vf-control,
    .brand-mark,
    .btn,
    .card,
    .form-control,
    .form-check-input,
    .cookie-notice-card,
    .footer-social-link {
        border-radius: var(--radius-brand);
    }

    .vf-card {
        border: 1px solid var(--line);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .vf-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        border: 1px solid var(--line);
        color: var(--ink-soft);
        background: var(--white);
        text-decoration: none;
    }

    .site-header {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        z-index: 1030;
    }

    .navbar-wrap {
        min-height: var(--header-height);
        background: color-mix(in srgb, var(--white) 92%, transparent);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(16px);
    }

    .brand-logo {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        color: var(--ink);
        font-size: 1.08rem;
        font-weight: 800;
        letter-spacing: -.02em;
        text-decoration: none;
        white-space: nowrap;
    }

    .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: var(--radius-brand);
        color: var(--white);
        background: var(--ink);
        font-size: .9rem;
        font-weight: 800;
        letter-spacing: -.04em;
        line-height: 1;
        text-align: center;
    }

    .header-menu {
        align-items: center;
        justify-content: center;
        gap: 1.6rem;
        flex: 1 1 auto;
        margin: 0 1.5rem;
    }

    .header-menu-link {
        position: relative;
        color: var(--ink-soft);
        font-size: .96rem;
        font-weight: 700;
        letter-spacing: -.015em;
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        transition: color .2s ease;
    }

    .header-menu-link::after {
        content: '';
        position: absolute;
        right: 0;
        bottom: -.45rem;
        left: 0;
        height: 2px;
        border-radius: var(--radius-brand);
        background: var(--brand);
        opacity: 0;
        transform: scaleX(.4);
        transform-origin: center;
        transition: opacity .2s ease, transform .2s ease;
    }

    .header-menu-link:hover,
    .header-menu-link:focus {
        color: var(--brand);
    }

    .header-menu-link:hover::after,
    .header-menu-link:focus::after {
        opacity: 1;
        transform: scaleX(1);
    }

    .mobile-menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        min-height: 2.75rem;
        padding: .65rem .95rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        color: var(--ink);
        background: var(--white);
        font-weight: 800;
        letter-spacing: -.015em;
        line-height: 1;
        transition: color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease;
    }

    .mobile-menu-toggle:hover,
    .mobile-menu-toggle:focus {
        color: var(--white);
        background: var(--ink);
        border-color: var(--ink);
        transform: translateY(-1px);
    }

    .mobile-menu-toggle i {
        font-size: 1.2rem;
        line-height: 1;
    }

    .vf-mobile-menu {
        width: min(22.5rem, calc(100vw - 1rem));
        color: var(--ink);
        background: var(--white);
        border-left: 1px solid var(--line);
    }

    .vf-mobile-menu-header {
        min-height: var(--header-height);
        padding: 1rem;
        border-bottom: 1px solid var(--line);
    }

    .vf-mobile-menu-body {
        display: flex;
        flex-direction: column;
        padding: 1rem;
    }

    .vf-mobile-menu-nav {
        display: flex;
        flex-direction: column;
    }

    .vf-mobile-menu-link {
        display: flex;
        align-items: center;
        min-height: 3.25rem;
        border-bottom: 1px solid var(--line);
        color: var(--ink-soft);
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -.025em;
        line-height: 1.2;
        text-decoration: none;
        transition: color .2s ease, background-color .2s ease, padding-left .2s ease;
    }

    .vf-mobile-menu-link:hover,
    .vf-mobile-menu-link:focus {
        color: var(--brand);
        background: var(--brand-light-bg);
        padding-left: .75rem;
    }

    .btn {
        border-radius: var(--radius-brand);
        font-weight: 700;
        letter-spacing: -.01em;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn-primary,
    .btn-primary:focus {
        color: var(--white);
        background-color: var(--ink);
        border-color: var(--ink);
        box-shadow: none;
    }

    .btn-primary:hover,
    .btn-primary:active {
        color: var(--white) !important;
        background-color: var(--brand) !important;
        border-color: var(--brand) !important;
        box-shadow: var(--shadow-soft);
    }

    .btn-outline-secondary,
    .btn-outline-secondary:focus {
        color: var(--ink);
        background: transparent;
        border-color: var(--ink);
        box-shadow: none;
    }

    .btn-outline-secondary:hover,
    .btn-outline-secondary:active {
        color: var(--white) !important;
        background-color: var(--ink) !important;
        border-color: var(--ink) !important;
    }

    .btn-light-ink,
    .btn-light-ink:focus {
        color: var(--white);
        background-color: var(--ink);
        border-color: var(--ink);
    }

    .btn-light-ink:hover,
    .btn-light-ink:active {
        color: var(--ink) !important;
        background-color: var(--white) !important;
        border-color: var(--white) !important;
    }

    .hero-section {
        min-height: 100vh;
        min-height: 100svh;
        margin-top: calc(-1 * var(--header-height));
        padding-top: calc(var(--header-height) + 3rem) !important;
        display: flex;
        align-items: center;
        background:
            radial-gradient(circle at top right, var(--brand-light-bg), transparent 34rem),
            var(--bg);
    }

    .hero-title {
        max-width: 920px;
        color: var(--ink);
        font-size: clamp(2.55rem, 6vw, 5.55rem);
        font-weight: 800;
        letter-spacing: -.065em;
        line-height: .96;
    }

    .hero-title em {
        color: var(--brand);
        font-style: italic;
        white-space: nowrap;
    }

    .hero-lead {
        max-width: 680px;
        color: var(--ink-soft);
        font-size: clamp(1.08rem, 2vw, 1.35rem);
        font-weight: 500;
    }

    .hero-card {
        position: relative;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-strong);
        overflow: hidden;
    }

    .hero-card-header {
        border-bottom: 1px solid var(--line);
        background: var(--ink-light-bg);
    }

    .hero-dot {
        width: .62rem;
        height: .62rem;
        border-radius: var(--radius-brand);
        background: var(--brand);
    }

    .metric-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        height: 100%;
    }

    .metric-label {
        color: var(--muted);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .metric-value {
        color: var(--ink);
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -.04em;
    }

    .card-ui {
        height: 100%;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .icon-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: var(--radius-brand);
        color: var(--brand);
        background: var(--brand-light-bg);
        font-size: 1.35rem;
    }

    .service-card-main {
        color: var(--white);
        background: var(--ink);
        border-color: var(--ink);
    }

    .service-card-main .icon-pill {
        color: var(--white);
        background: var(--white-faint);
    }

    .service-card-main p,
    .service-card-main .service-caption {
        color: var(--white-muted);
    }

    .service-card-accent {
        color: var(--white);
        background: var(--brand);
        border-color: var(--brand);
    }

    .service-card-accent .icon-pill {
        color: var(--white);
        background: var(--white-faint);
    }

    .service-card-accent p,
    .service-card-accent .service-caption {
        color: var(--white-muted);
    }

    .dark-section {
        color: var(--white);
        background: var(--ink);
    }

    .dark-section .section-title,
    .dark-section h5,
    .dark-section p {
        color: var(--white);
    }

    .dark-section .section-eyebrow {
        color: var(--white-muted);
    }

    .step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        border-radius: var(--radius-brand);
        color: var(--white);
        background: var(--brand);
        font-size: 1.45rem;
        font-weight: 800;
        box-shadow: 0 0 0 .7rem var(--white-faint);
    }

    .step-card {
        height: 100%;
        border: 1px solid var(--white-soft-line);
        border-radius: var(--radius-brand);
        background: var(--white-faint);
    }

    .case-section {
        background: var(--bg-soft);
    }

    .case-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .case-label {
        color: var(--muted);
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .result-number {
        color: var(--brand);
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -.06em;
        line-height: 1;
    }

    .quote-card {
        border-left: 4px solid var(--brand);
        border-radius: var(--radius-brand);
        background: var(--bg);
    }

    .telegram-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .contact-section {
        color: var(--white);
        background: var(--brand);
    }

    .contact-section .section-eyebrow,
    .contact-section .section-title,
    .contact-section .section-subtitle {
        color: var(--white);
    }

    .contact-section .section-eyebrow::before {
        background: var(--white);
    }

    .contact-card {
        border: 1px solid var(--white-soft-line);
        border-radius: var(--radius-brand);
        color: var(--ink);
        background: var(--white);
        box-shadow: var(--shadow-strong);
    }

    .form-label {
        color: var(--ink-soft);
        font-weight: 700;
    }

    .form-control {
        min-height: 3.35rem;
        color: var(--ink);
        border-color: var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
    }

    .form-control:focus {
        color: var(--ink);
        border-color: var(--ink);
        box-shadow: 0 0 0 .25rem var(--brand-light-bg);
    }

    .success-message {
        display: none;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        color: var(--ink);
        background: var(--brand-light-bg);
    }

    .success-message.is-visible {
        display: block;
    }

    .footer-section {
        color: var(--white);
        background: var(--ink);
    }

    .footer-section a {
        color: var(--white);
        text-decoration: none;
        transition: color .2s ease, opacity .2s ease, border-color .2s ease, background-color .2s ease, transform .2s ease;
    }

    .footer-section a:hover {
        color: var(--white);
        opacity: .9;
    }

    .footer-muted {
        color: var(--white-muted);
    }

    .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: .9rem;
        margin-bottom: 1.6rem;
        color: var(--white);
        font-size: clamp(1.65rem, 2vw, 2rem);
        font-weight: 800;
        letter-spacing: -.05em;
        line-height: 1;
    }

    .footer-brand:hover {
        color: var(--white);
        opacity: 1;
    }

    .footer-brand .brand-mark {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-brand);
        color: var(--white);
        background: var(--brand);
        font-size: 1.05rem;
    }

    .footer-brand-text {
        color: var(--white);
    }

    .footer-description {
        max-width: 25rem;
        color: var(--white-muted);
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .footer-socials {
        display: flex;
        flex-wrap: wrap;
        gap: .8rem;
        margin-top: 2rem;
    }

    .footer-social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3.1rem;
        height: 3.1rem;
        border: 1px solid var(--white-soft-line);
        border-radius: var(--radius-brand);
        color: var(--white);
        background: var(--white-faint);
        font-size: 1.1rem;
    }

    .footer-social-link:hover {
        color: var(--white);
        background: color-mix(in srgb, var(--white) 10%, transparent);
        border-color: color-mix(in srgb, var(--white) 22%, transparent);
        opacity: 1;
        transform: translateY(-1px);
    }

    .footer-title {
        margin-bottom: 1.85rem;
        color: var(--white-muted);
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .28em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .footer-contact-list,
    .footer-docs-list {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }

    .footer-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .footer-contact-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.55rem;
        height: 2.55rem;
        flex: 0 0 auto;
        border: 1px solid var(--white-soft-line);
        border-radius: var(--radius-brand);
        color: var(--white-muted);
        background: var(--white-faint);
        font-size: 1rem;
    }

    .footer-kicker {
        margin-bottom: .35rem;
        color: var(--white-muted);
        font-size: .74rem;
        font-weight: 600;
        letter-spacing: .24em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .footer-contact-link {
        color: var(--white);
        font-size: clamp(1.05rem, 1.15vw, 1.28rem);
        font-weight: 600;
        letter-spacing: -.03em;
        line-height: 1.2;
    }

    .footer-docs-list a {
        color: var(--white-muted);
        font-size: clamp(1rem, 1.05vw, 1.14rem);
        font-weight: 400;
        letter-spacing: -.025em;
        line-height: 1.35;
    }

    .footer-docs-list a:hover {
        color: var(--white);
    }

    .footer-divider {
        height: 1px;
        margin-top: 3.4rem;
        margin-bottom: 2rem;
        background: var(--white-soft-line);
    }

    .footer-bottom {
        color: var(--white-muted);
        font-size: .98rem;
    }

    .footer-legal {
        font-size: .9rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        white-space: nowrap;
    }


    .cookie-notice {
        position: fixed;
        right: 0;
        bottom: 1.25rem;
        left: 0;
        z-index: 1080;
        padding-right: 1rem;
        padding-left: 1rem;
        pointer-events: none;
        opacity: 0;
        transform: translateY(1rem);
        transition: opacity .25s ease, transform .25s ease;
    }

    .cookie-notice.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .cookie-card {
        position: relative;
        max-width: 58rem;
        margin-right: auto;
        margin-left: auto;
        padding: 1.75rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        color: var(--ink);
        background: var(--white);
        box-shadow: var(--shadow-strong);
        pointer-events: auto;
    }

    .cookie-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        color: var(--ink-soft);
        background: var(--white);
        transition: color .2s ease, border-color .2s ease, background-color .2s ease, transform .2s ease;
    }

    .cookie-close:hover {
        color: var(--white);
        border-color: var(--ink);
        background: var(--ink);
        transform: translateY(-1px);
    }

    .cookie-title {
        max-width: 42rem;
        margin-bottom: .65rem;
        padding-right: 2.5rem;
        color: var(--ink);
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.15;
    }

    .cookie-text {
        max-width: 43rem;
        margin-bottom: 0;
        color: var(--ink-soft);
        font-size: 1rem;
        line-height: 1.6;
    }

    .cookie-text a {
        color: var(--brand);
        font-weight: 700;
        text-decoration: none;
    }

    .cookie-text a:hover {
        color: var(--brand-dark);
        text-decoration: underline;
    }

    .cookie-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
    }

    @media (max-width: 767.98px) {
        :root {
            --header-height: 4.25rem;
            --header-anchor-offset: calc(var(--header-height) + .75rem);
        }


        .cookie-notice {
            bottom: 1rem;
        }

        .cookie-card {
            padding: 1.35rem;
            border-radius: var(--radius-brand);
        }

        .cookie-actions {
            justify-content: stretch;
        }

        .cookie-actions .btn {
            width: 100%;
        }

        .brand-logo {
            gap: .45rem;
            font-size: .95rem;
        }

        .brand-mark {
            width: 2rem;
            height: 2rem;
            border-radius: var(--radius-brand);
            font-size: .76rem;
        }

        .navbar .btn {
            padding: .58rem .85rem;
            font-size: .88rem;
        }

        .hero-section {
            min-height: 80vh;
            min-height: 80svh;
            padding-top: calc(var(--header-height) + 2rem) !important;
        }

        .hero-actions .btn {
            width: 100%;
        }

        .section-title {
            letter-spacing: -.045em;
        }

        .step-card {
            text-align: center;
        }
    }

    @media (max-width: 991.98px) {
        .footer-description {
            max-width: none;
        }

        .footer-divider {
            margin-top: 2.6rem;
        }

        .footer-legal {
            white-space: normal;
            display: inline-block;
            line-height: 1.8;
        }
    }

    @media (max-width: 767.98px) {
        .footer-brand {
            justify-content: center;
        }

        .footer-socials,
        .footer-contact-item {
            justify-content: center;
        }
    }

    @media (min-width: 768px) {
        .hero-actions .btn {
            width: auto;
        }
    }


    /* Informational pages */
    .info-hero {
        background:
            radial-gradient(circle at top right, var(--brand-light-bg), transparent 32rem),
            var(--white);
    }

    .info-hero-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .info-summary-card {
        height: 100%;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .info-summary-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.8rem;
        height: 2.8rem;
        border-radius: var(--radius-brand);
        color: var(--brand);
        background: var(--brand-light-bg);
        font-size: 1.2rem;
        flex: 0 0 auto;
    }

    .info-layout {
        background: var(--bg);
    }

    .info-sidebar {
        position: sticky;
        top: calc(var(--header-height) + 1.25rem);
    }

    .info-toc {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
    }

    .info-toc-head {
        padding: 1.15rem 1.25rem;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .14em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .info-toc-list {
        max-height: calc(100svh - var(--header-height) - 6rem);
        overflow: auto;
        padding: .6rem;
    }

    .info-toc-link {
        display: block;
        padding: .7rem .75rem;
        border-radius: var(--radius-brand);
        color: var(--ink-soft);
        font-size: .92rem;
        font-weight: 600;
        line-height: 1.28;
        text-decoration: none;
    }

    .info-toc-link:hover {
        color: var(--brand);
        background: var(--brand-light-bg);
    }

    .info-content {
        max-width: 58rem;
    }

    .info-card {
        scroll-margin-top: var(--header-anchor-offset);
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .info-card + .info-card {
        margin-top: 1rem;
    }

    .info-card-head {
        padding: clamp(1.4rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.25rem) 1rem;
        border-bottom: 1px solid var(--line);
    }

    .info-card-body {
        padding: clamp(1.4rem, 3vw, 2.25rem);
    }

    .info-section-number {
        display: inline-flex;
        align-items: center;
        margin-bottom: .85rem;
        color: var(--muted);
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .14em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .info-card h2 {
        margin: 0;
        color: var(--ink);
        font-size: clamp(1.45rem, 2.2vw, 2rem);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.12;
    }

    .info-card h3 {
        margin-top: 1.6rem;
        margin-bottom: .85rem;
        color: var(--ink);
        font-size: 1.08rem;
        font-weight: 800;
        letter-spacing: -.02em;
        line-height: 1.25;
    }

    .info-card h3:first-child {
        margin-top: 0;
    }

    .info-card p {
        max-width: 74ch;
        margin-bottom: 1rem;
        color: var(--ink-soft);
        font-size: 1rem;
        line-height: 1.78;
    }

    .info-card p:last-child {
        margin-bottom: 0;
    }

    .info-card a {
        color: var(--ink);
        font-weight: 700;
        text-decoration-color: var(--line);
        text-underline-offset: .18em;
    }

    .info-card a:hover {
        color: var(--brand);
        text-decoration-color: var(--brand);
    }

    .info-card .quote-card {
        max-width: none;
        margin-top: 1rem;
    }

    .info-alert {
        border: 1px solid var(--line);
        border-left: 4px solid var(--brand);
        border-radius: var(--radius-brand);
        background: var(--brand-light-bg);
    }

    .info-requisites-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .info-requisite-item {
        padding: 1rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--bg);
    }

    .info-requisite-label {
        margin-bottom: .35rem;
        color: var(--muted);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .12em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .info-requisite-value {
        margin: 0;
        color: var(--ink);
        font-weight: 700;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    @media (max-width: 991.98px) {
        .info-sidebar {
            position: static;
        }

        .info-toc-list {
            max-height: none;
        }

        .info-content {
            max-width: none;
        }
    }

    @media (max-width: 575.98px) {
        .info-requisites-grid {
            grid-template-columns: 1fr;
        }

        .info-toc-link {
            font-size: .9rem;
        }

        .info-card p {
            font-size: .97rem;
            line-height: 1.72;
        }
    }


    /* Blog page styles */
    .blog-hero {
        background:
            radial-gradient(circle at top right, var(--brand-light-bg), transparent 34rem),
            var(--bg);
    }

    .breadcrumbs-wrap {
        margin-bottom: 2.5rem;
        color: var(--muted);
        font-size: .95rem;
        line-height: 1.3;
    }

    .vf-breadcrumb {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .55rem;
        margin: 0;
        padding: 0;
        color: var(--muted);
    }

    .vf-breadcrumb .breadcrumb-item {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding-left: 0;
        color: var(--muted);
    }

    .vf-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
        content: "\F285";
        padding: 0;
        color: var(--muted);
        font-family: "bootstrap-icons";
        font-size: .8rem;
        line-height: 1;
    }

    .vf-breadcrumb a {
        color: var(--muted);
        text-decoration: none;
    }

    .vf-breadcrumb a:hover {
        color: var(--brand);
    }

    .vf-breadcrumb .active {
        color: var(--ink);
    }

    .blog-meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.4rem;
        color: var(--muted);
        font-size: .98rem;
    }

    .blog-category-pill {
        display: inline-flex;
        align-items: center;
        padding: .42rem .85rem;
        border-radius: var(--radius-brand);
        color: var(--brand);
        background: var(--white);
        font-weight: 700;
        line-height: 1;
        box-shadow: var(--shadow-soft);
    }

    .blog-meta-item {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--muted);
        line-height: 1;
    }

    .blog-title {
        max-width: 920px;
        color: var(--ink);
        font-size: clamp(2.4rem, 5.2vw, 5.15rem);
        font-weight: 800;
        letter-spacing: -.065em;
        line-height: .98;
    }

    .blog-title em {
        color: var(--brand);
        font-style: italic;
    }

    .blog-lead {
        max-width: 780px;
