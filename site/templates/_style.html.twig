        color: var(--ink-soft);
        font-size: 1.08rem;
        line-height: 1.75;
    }

    .blog-article p + p {
        margin-top: 1rem;
    }

    .blog-article h2 {
        margin-top: 3rem;
        margin-bottom: 1rem;
        color: var(--ink);
        font-size: clamp(1.85rem, 3vw, 2.55rem);
        font-weight: 800;
        letter-spacing: -.045em;
        line-height: 1.12;
    }

    .blog-article h3 {
        margin-top: 2rem;
        margin-bottom: .8rem;
        color: var(--ink);
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.2;
    }

    .blog-article a {
        color: var(--brand);
        font-weight: 700;
        text-decoration: none;
    }

    .blog-article a:hover {
        color: var(--brand-dark);
    }

    .blog-article .blog-chip:hover {
        color: var(--white);
        background: var(--ink);
        border-color: var(--ink);
    }

    .blog-article-cover {
        margin-bottom: 2rem;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .blog-article-cover img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 7;
        object-fit: cover;
    }

    .blog-intro-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--bg);
    }

    .blog-content-list {
        margin: 1rem 0 0;
        padding: 0;
        list-style: none;
    }

    .blog-content-list li {
        position: relative;
        padding-left: 1.4rem;
    }

    .blog-content-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: .78rem;
        width: .45rem;
        height: .45rem;
        border-radius: var(--radius-brand);
        background: var(--brand);
    }

    .blog-callout {
        margin: 2rem 0;
        padding: 1.4rem;
        border: 1px solid var(--line);
        border-left: 4px solid var(--brand);
        border-radius: var(--radius-brand);
        background: var(--bg);
    }

    .blog-callout strong {
        color: var(--ink);
    }

    .blog-table-wrap {
        margin: 1.5rem 0;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
    }

    .blog-table {
        margin: 0;
        --bs-table-bg: transparent;
        --bs-table-striped-bg: transparent;
        --bs-table-hover-bg: transparent;
    }

    .blog-table th {
        padding: 1rem 1.15rem;
        color: var(--white);
        background: var(--ink);
        font-weight: 800;
        line-height: 1.25;
        border-color: var(--white-soft-line);
