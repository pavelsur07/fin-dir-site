    .blog-cta-inline .section-eyebrow::before {
        background: var(--white);
    }

    .blog-cta-inline .contact-card .form-check-label {
        color: var(--ink-soft) !important;
        font-size: .95rem;
        line-height: 1.45;
    }

    .blog-cta-inline .contact-card .form-check-label a {
        color: var(--brand);
        font-weight: 700;
    }

    .blog-cta-inline .form-check-input {
        width: 1.15rem;
        height: 1.15rem;
        margin-top: .2rem;
    }

    .blog-cta-copy {
