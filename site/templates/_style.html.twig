        gap: .45rem;
    }

    .blog-visual-dot {
        width: .75rem;
        height: .75rem;
        border-radius: var(--radius-brand);
        background: var(--brand);
    }

    .blog-visual-label {
        color: var(--muted);
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .blog-visual-body {
        padding: 2rem;
    }

    .blog-market-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
        margin-bottom: 1.4rem;
    }

    .blog-market-card {
        min-height: 12rem;
        padding: 1.2rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--bg);
    }

    .blog-market-card h3 {
        margin: 0 0 .8rem;
        color: var(--ink);
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .blog-market-card ul {
        margin: 0;
        padding-left: 1.1rem;
        color: var(--ink-soft);
        font-size: .95rem;
    }

    .blog-market-card li + li {
        margin-top: .45rem;
    }

    .blog-mini-chart {
        padding: 1.25rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
    }

    .blog-chart-row {
        display: grid;
        grid-template-columns: 7rem 1fr auto;
        align-items: center;
        gap: .85rem;
        color: var(--ink-soft);
        font-size: .95rem;
    }

    .blog-chart-row + .blog-chart-row {
        margin-top: .9rem;
    }

    .blog-chart-track {
        height: .7rem;
        border-radius: var(--radius-brand);
        background: var(--bg-soft);
        overflow: hidden;
    }

    .blog-chart-fill {
        height: 100%;
        border-radius: var(--radius-brand);
        background: var(--ink);
    }

    .blog-chart-fill-accent {
        background: var(--brand);
    }

    .blog-share-card,
    .blog-ai-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .blog-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
    }

    .blog-chip {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .62rem .9rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        color: var(--ink);
        background: var(--white);
        font-weight: 700;
        text-decoration: none;
        line-height: 1;
    }

    .blog-chip:hover {
        color: var(--white);
        background: var(--ink);
        border-color: var(--ink);
    }

    .blog-layout {
        background: var(--white);
    }

    .blog-sidebar {
        position: sticky;
        top: calc(var(--header-height) + 1.25rem);
    }

    .blog-toc-card,
    .blog-side-cta,
    .blog-side-note {
        border: 1px solid var(--line);
        border-radius: var(--radius-brand);
        background: var(--white);
        box-shadow: var(--shadow-soft);
    }

    .blog-toc-title {
        margin: 0 0 1rem;
        color: var(--ink);
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -.02em;
    }

    .blog-toc-list {
        display: flex;
        flex-direction: column;
        gap: .7rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .blog-toc-list a {
        display: block;
        color: var(--muted);
        font-size: .95rem;
        line-height: 1.35;
        text-decoration: none;
    }

    .blog-toc-list a:hover {
        color: var(--brand);
    }

    .blog-side-cta {
        color: var(--white);
        background: var(--ink);
        border-color: var(--ink);
    }

    .blog-side-cta p {
        color: var(--white-muted);
    }

    .blog-side-cta .btn {
        color: var(--ink);
        background: var(--white);
        border-color: var(--white);
    }

    .blog-side-cta .btn:hover {
        color: var(--white) !important;
        background: var(--brand) !important;
        border-color: var(--brand) !important;
    }

    .blog-side-cta {
        position: relative;
        overflow: hidden;
    }

    .blog-side-cta-content {
        position: relative;
        z-index: 2;
        max-width: none;
    }

    .blog-side-cta-figure {
