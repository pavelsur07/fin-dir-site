<div class="flex flex-wrap gap-2">
    {% for transition in actions %}
        <form method="post" action="{{ path('admin_post_status', {id: id, action: transition.action}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('post-status') }}">
            {% if back is defined %}<input type="hidden" name="back" value="{{ back }}">{% endif %}
            <button type="submit" class="{{ transition.class }}">{{ transition.label }}</button>
        </form>
    {% endfor %}
</div>
