{% extends 'admin/layout.html.twig' %}

{% block title %}Предпросмотр{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap gap-2">
        <a class="text-red-700 underline hover:text-red-800 focus-visible:outline-2 focus-visible:outline-red-700" href="{{ path('admin_post_edit', {id: post.id}) }}">← К редактированию</a>
        <span class="inline-block rounded-full px-2 py-1 text-xs font-semibold {{ post.status.value == 'published' ? 'bg-green-700 text-white' : 'bg-slate-600 text-white' }}">{{ post.status.label }}</span>
    </div>

    <article class="max-w-3xl rounded-lg border border-slate-200 bg-white p-6">
        <h1 class="mb-6 text-3xl font-bold">{{ post.title }}</h1>
        {% if post.excerpt %}<p class="text-sm text-slate-600">{{ post.excerpt }}</p>{% endif %}
        {# body_html -- выход MarkdownRenderer: HTML из текста вырезан, небезопасные ссылки отброшены. #}
        {{ body_html|raw }}
    </article>
{% endblock %}
