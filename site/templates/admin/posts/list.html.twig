{% extends 'admin/layout.html.twig' %}

{% block title %}Публикации{% endblock %}

{% block body %}
    <div class="toolbar">
        <h1>Публикации</h1>
        <a class="button" href="{{ path('admin_post_new') }}">Новая статья</a>
    </div>

    <div class="filters">
        <span>Статус:</span>
        <a href="{{ path('admin_post_list', {sort: criteria.sort.value}) }}" {{ criteria.status is null ? 'aria-current="true"' }}>Все</a>
        {% for status in statuses %}
            <a href="{{ path('admin_post_list', {status: status.value, sort: criteria.sort.value}) }}" {{ criteria.status == status ? 'aria-current="true"' }}>{{ status.label }}</a>
        {% endfor %}
    </div>
    <div class="filters">
        <span>Сортировка:</span>
        {% for sort in sorts %}
            <a href="{{ path('admin_post_list', criteria.status ? {status: criteria.status.value, sort: sort.value} : {sort: sort.value}) }}" {{ criteria.sort == sort ? 'aria-current="true"' }}>{{ sort.label }}</a>
        {% endfor %}
    </div>

    {% if pager.nbResults == 0 %}
        <p class="panel">Статей пока нет.</p>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">Заголовок</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Изменена</th>
                    <th scope="col">Опубликована</th>
                    <th scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for post in pager.currentPageResults %}
                    <tr>
                        <td>
                            <a href="{{ path('admin_post_edit', {id: post.id}) }}">{{ post.title }}</a>
                            <div class="muted">
                                {% if post.status.value == 'published' %}
                                    <a href="{{ path('gazeta_post', {slug: post.slug}) }}" target="_blank" rel="noopener">/gazeta/{{ post.slug }}</a>
                                {% else %}
                                    /gazeta/{{ post.slug }}
                                {% endif %}
                            </div>
                        </td>
                        <td><span class="badge badge-{{ post.status.value }}">{{ post.status.label }}</span></td>
                        <td>{{ post.updatedAt|date('d.m.Y H:i') }}</td>
                        <td>{{ post.publishedAt ? post.publishedAt|date('d.m.Y') : '—' }}</td>
                        <td>
                            {# Нативный popover: закрытие по Esc и клику вне -- браузер, позицию под кнопкой ставит admin.js. #}
                            <button type="button" class="secondary menu-toggle" popovertarget="post-actions-{{ post.id }}" aria-label="Действия: {{ post.title }}">…</button>
                            <div class="row-menu" id="post-actions-{{ post.id }}" popover>
                                <a href="{{ path('admin_post_edit', {id: post.id}) }}">Редактировать</a>
                                {% include 'admin/posts/_status_actions.html.twig' with {id: post.id, status: post.status, back: 'list'} only %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pager.haveToPaginate %}
            <nav class="pagination" aria-label="Страницы">
                {{ pagerfanta(pager, {omitFirstPage: true, prev_message: '←', next_message: '→'}) }}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
