{% extends 'admin/layout.html.twig' %}

{% block title %}Публикации{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap gap-2">
        <h1 class="mb-6 type-t2-article">Публикации</h1>
        {% include 'admin/_button.html.twig' with {label: 'Новая статья', href: path('admin_post_new'), variant: 'primary'} only %}
    </div>

    <div class="mb-4 flex flex-wrap gap-4">
        <span>Статус:</span>
        <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_post_list', {sort: criteria.sort.value}) }}" {{ criteria.status is null ? 'aria-current="true"' }}>Все</a>
        {% for status in statuses %}
            <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_post_list', {status: status.value, sort: criteria.sort.value}) }}" {{ criteria.status == status ? 'aria-current="true"' }}>{{ status.label }}</a>
        {% endfor %}
    </div>
    <div class="mb-4 flex flex-wrap gap-4">
        <span>Сортировка:</span>
        {% for sort in sorts %}
            <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_post_list', criteria.status ? {status: criteria.status.value, sort: sort.value} : {sort: sort.value}) }}" {{ criteria.sort == sort ? 'aria-current="true"' }}>{{ sort.label }}</a>
        {% endfor %}
    </div>

    {% if pager.nbResults == 0 %}
        <p class="max-w-container rounded-lg border bg-white p-6">Статей пока нет.</p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full border-collapse border bg-white type-t6">
                <thead>
                <tr>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Заголовок</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Статус</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Изменена</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Опубликована</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for post in pager.currentPageResults %}
                    <tr>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">
                            <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_post_edit', {id: post.id}) }}">{{ post.title }}</a>
                            <div class="type-t6 text-fg-secondary">
                                {% if post.status.value == 'published' %}
                                    <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('gazeta_post', {slug: post.slug}) }}" target="_blank" rel="noopener">/gazeta/{{ post.slug }}</a>
                                {% else %}
                                    /gazeta/{{ post.slug }}
                                {% endif %}
                            </div>
                        </td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top"><span class="inline-block rounded-full px-2 py-1 type-t7 font-semibold {{ post.status.value == 'published' ? 'bg-success-bg text-success' : 'bg-surface-muted text-fg-secondary' }}">{{ post.status.label }}</span></td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ post.updatedAt|date('d.m.Y H:i') }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ post.publishedAt ? post.publishedAt|date('d.m.Y') : '—' }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">
                            <details class="relative"><summary data-admin-menu-toggle class="w-fit cursor-pointer list-none rounded-md border border-border-strong bg-white px-3 py-1 type-t3 text-fg hover:bg-surface-muted" aria-controls="post-actions-{{ post.id }}" aria-label="Действия: {{ post.title }}">…</summary>
                            <div data-admin-row-menu class="absolute right-0 top-full z-20 grid min-w-sidebar gap-2 rounded-lg border bg-white p-2 shadow-lg" id="post-actions-{{ post.id }}">
                                <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_post_edit', {id: post.id}) }}">Редактировать</a>
                                {% include 'admin/posts/_status_actions.html.twig' with {id: post.id, actions: status_actions[post.status.value], back: 'list'} only %}
                            </div>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pager.haveToPaginate %}
            <nav class="mt-4 flex flex-wrap gap-2" aria-label="Страницы">
                {{ pagerfanta(pager, {omitFirstPage: true, prev_message: '←', next_message: '→'}) }}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
