<div class="flex flex-wrap gap-2">
    {% for transition in actions %}
        <form method="post" action="{{ path('admin_case_status', {id: id, action: transition.action}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('case-status') }}">
            {% if back is defined %}<input type="hidden" name="back" value="{{ back }}">{% endif %}
            {% include 'admin/_button.html.twig' with {label: transition.label} only %}
        </form>
    {% endfor %}
</div>
