{% extends 'admin/layout.html.twig' %}

{% block title %}Кейсы{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-start gap-2">
        <h1 class="min-w-0 type-t2-article">Кейсы</h1>
        {% include 'admin/_button.html.twig' with {label: 'Новый кейс', href: path('admin_case_new'), variant: 'primary'} only %}
    </div>

    <div class="mb-4 flex flex-wrap gap-4">
        <span>Статус:</span>
        <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_case_list') }}" {{ status is null ? 'aria-current="true"' }}>Все</a>
        {% for item in statuses %}
            <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_case_list', {status: item.value}) }}" {{ status == item ? 'aria-current="true"' }}>{{ item.label }}</a>
        {% endfor %}
    </div>

    {% if cases is empty %}
        <p class="max-w-container rounded-lg border bg-white p-6">Кейсов пока нет.</p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full border-collapse border bg-white type-t6">
                <thead>
                <tr>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Заголовок</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Отрасль</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Статус</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Изменён</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Опубликован</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for case in cases %}
                    <tr>
                        <td class="admin-cell-text border-b border-border-subtle px-3 py-2 align-top">
                            <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_case_edit', {id: case.id}) }}">{{ case.title }}</a>
                            {% if case.featured %}<span class="ml-2 inline-block rounded-full bg-surface-muted px-2 py-1 type-t7 font-semibold text-fg-secondary">Главный</span>{% endif %}
                            <div class="type-t6 text-fg-secondary">
                                {% if case.status.value == 'published' %}
                                    <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('app_cases_show', {slug: case.slug}) }}" target="_blank" rel="noopener">/cases/{{ case.slug }}</a>
                                {% else %}
                                    /cases/{{ case.slug }}
                                {% endif %}
                            </div>
                        </td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ case.industry.label }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top"><span class="inline-block rounded-full px-2 py-1 type-t7 font-semibold {{ case.status.value == 'published' ? 'bg-success-bg text-success' : 'bg-surface-muted text-fg-secondary' }}">{{ case.status.label }}</span></td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ case.updatedAt|date('d.m.Y H:i') }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ case.publishedAt ? case.publishedAt|date('d.m.Y') : '—' }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">
                            {% embed 'admin/_row_menu.html.twig' with {menu_id: 'case-actions-' ~ case.id, menu_label: 'Действия: ' ~ case.title, case: case} only %}
                                {% block actions %}
                                {% include 'admin/_menu_item.html.twig' with {label: 'Редактировать', href: path('admin_case_edit', {id: case.id})} only %}
                                {% include 'admin/cases/_status_actions.html.twig' with {id: case.id, actions: case.status.actions, back: 'list', as_menu: true} only %}
                                {% endblock %}
                            {% endembed %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
