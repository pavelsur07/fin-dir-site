{% extends 'admin/layout.html.twig' %}

{% block title %}Вход{% endblock %}

{# Страница входа -- без сайдбара и меню: только карточка по центру. #}
{% block page %}
    <main class="p-4 lg:p-8">
        <form class="rounded-lg border bg-white p-6" method="post" action="{{ path('admin_login') }}">
            <h1 class="mb-6 type-t2-article">Вход в админку</h1>

            {% if error %}
                <p class="rounded-lg border border-error-border bg-error-bg p-4 text-error" role="alert">
                    {% if error.messageKey starts with 'Too many failed login attempts' %}
                        Слишком много попыток входа. Попробуйте через минуту.
                    {% elseif error.messageKey == 'Invalid CSRF token.' %}
                        Страница входа устарела. Попробуйте ещё раз.
                    {% else %}
                        Неверный логин или пароль.
                    {% endif %}
                </p>
            {% endif %}

            <label class="grid gap-1 font-medium" for="username">Логин</label>
            <input class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>

            <label class="grid gap-1 font-medium" for="password">Пароль</label>
            <input class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" type="password" id="password" name="_password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="rounded-md bg-accent-fill px-4 py-2 font-semibold text-white hover:bg-accent-fill-hover focus-visible:shadow-focus" type="submit">Войти</button>
        </form>
    </main>
{% endblock %}
