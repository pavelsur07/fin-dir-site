{# Меню админки. Вход: menu (list<{label, route, active_prefix, counter?}>), route (текущий), counter (готовый HTML счётчика). #}
<nav data-admin-menu class="py-3" aria-label="Разделы админки">
    <ul class="grid gap-1">
        {% for item in menu %}
            <li>
                <a class="flex items-center justify-between gap-2 rounded-md px-3 py-2 text-white no-underline hover:bg-navy-700 focus-visible:shadow-focus {{ route starts with item.active_prefix ? 'bg-navy-600' : '' }}" href="{{ path(item.route) }}"{{ route starts with item.active_prefix ? ' aria-current="page"' }}>
                    <span>{{ item.label }}</span>
                    {% if item.counter|default(false) %}{{ counter }}{% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
<form data-admin-account class="mt-auto grid gap-2 border-t px-2 pt-4" method="post" action="{{ logout_path('admin') }}">
    <span class="type-t6 text-fg-secondary">{{ app.user.userIdentifier }}</span>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
    {% include 'admin/_button.html.twig' with {label: 'Выйти'} only %}
</form>
