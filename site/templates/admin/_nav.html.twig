{# Меню админки. Вход: menu (list<{label, route, active_prefix, counter?}>), route (текущий), counter (готовый HTML счётчика). #}
<nav data-admin-menu class="py-3" aria-label="Разделы админки">
    <ul class="grid gap-1">
        {% for item in menu %}
            <li>
                <a class="flex items-center justify-between gap-2 rounded-md px-3 py-2 text-white no-underline hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-white {{ route starts with item.active_prefix ? 'bg-red-700' : '' }}" href="{{ path(item.route) }}"{{ route starts with item.active_prefix ? ' aria-current="page"' }}>
                    <span>{{ item.label }}</span>
                    {% if item.counter|default(false) %}{{ counter }}{% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
<form data-admin-account class="mt-auto grid gap-2 border-t border-slate-700 px-2 pt-4" method="post" action="{{ logout_path('admin') }}">
    <span class="text-sm text-slate-300">{{ app.user.userIdentifier }}</span>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
    <button type="submit" class="rounded-md border border-slate-500 bg-white px-4 py-2 text-slate-950 hover:bg-slate-50">Выйти</button>
</form>
