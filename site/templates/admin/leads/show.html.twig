{% extends 'admin/layout.html.twig' %}

{% block title %}Обращение №{{ lead.id }}{% endblock %}

{% block body %}
    {% set token = csrf_token('lead-admin') %}
    <div class="mb-4 flex flex-wrap gap-2">
        <h1 class="mb-6 type-t2-article">Обращение №{{ lead.id }}</h1>
        <span class="inline-block rounded-full px-2 py-1 type-t7 font-semibold {{ lead.status.value == 'new' ? 'bg-accent-fill text-white' : (lead.status.value == 'qualified' ? 'bg-success-bg text-success' : 'bg-surface-muted text-fg-secondary') }}">{{ lead.status.label }}</span>
    </div>
    <p><a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_lead_list') }}">← Все обращения</a></p>

    {% for message in app.flashes('error') %}<p class="rounded-lg border border-error-border bg-error-bg p-4 text-error" role="alert">{{ message }}</p>{% endfor %}

    <div class="max-w-page rounded-lg border bg-white p-6">
        <dl class="grid gap-2 md:grid-cols-2">
            <dt>Получено</dt><dd>{{ lead.createdAt|date('d.m.Y H:i') }}</dd>
            <dt>Форма</dt><dd>{{ forms[lead.formKey].title ?? lead.formKey }}</dd>
            <dt>Имя</dt><dd>{{ lead.name }}</dd>
            <dt>Контакт</dt><dd>{{ lead.contact }}</dd>
            {% if lead.task %}<dt>Задача</dt><dd class="whitespace-pre-wrap">{{ lead.task }}</dd>{% endif %}
            {% for answer in lead.answers %}<dt>{{ answer.questionLabel }}</dt><dd>{{ answer.answerLabel }}</dd>{% endfor %}
            <dt>Страница</dt><dd>{{ lead.pageUrl ?? '—' }}</dd>
            {% if lead.referrer %}<dt>Откуда пришли</dt><dd>{{ lead.referrer }}</dd>{% endif %}
            {% for key, value in lead.utm %}<dt>{{ key }}</dt><dd>{{ value }}</dd>{% endfor %}
            {% if lead.firstTouch %}
                <dt>Первый визит</dt><dd>{% include 'admin/leads/_touch.html.twig' with {touch: lead.firstTouch} only %}</dd>
                {% if lead.lastTouch %}<dt>Последний значимый визит</dt><dd>{% include 'admin/leads/_touch.html.twig' with {touch: lead.lastTouch} only %}</dd>{% endif %}
                {% if lead.visits %}<dt>Визитов до заявки</dt><dd>{{ lead.visits }}</dd>{% endif %}
                {% if lead.daysToLead is not null %}<dt>Дней до заявки</dt><dd>{{ lead.daysToLead }}</dd>{% endif %}
            {% endif %}
            {% if lead.ymClientId %}<dt>ClientID Метрики</dt><dd>{{ lead.ymClientId }} <span class="type-t6 text-fg-secondary">— Метрика → Отчёты → Посетители, фильтр по ClientID</span></dd>{% endif %}
            <dt>Согласие на ПД</dt><dd>{{ lead.consentAt|date('d.m.Y H:i') }}, версия {{ lead.consentVersion }}</dd>
            {% if lead.spamReasonLabel %}<dt>Признак спама</dt><dd>{{ lead.spamReasonLabel }}</dd>{% endif %}
            <dt>Уведомление</dt>
            <dd>
                {% if lead.notifiedAt %}
                    отправлено {{ lead.notifiedAt|date('d.m.Y H:i') }}
                {% elseif not lead.needsNotification %}
                    не отправляется для спама
                {% elseif not notifications_enabled %}
                    уведомления выключены (нет настроек Telegram)
                {% else %}
                    не отправлено{% if lead.notificationError %}: {{ lead.notificationError }}{% endif %}
                    <form method="post" action="{{ path('admin_lead_notify', {id: lead.id}) }}" class="inline ml-2">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button type="submit" class="rounded-md border border-border-strong bg-white px-4 py-2 text-fg hover:bg-surface-muted">Отправить повторно</button>
                    </form>
                {% endif %}
            </dd>
        </dl>
    </div>

    <h2 class="mb-3 mt-8 type-t3">Работа с обращением</h2>
    <form class="max-w-page rounded-lg border bg-white p-6" method="post" action="{{ path('admin_lead_update', {id: lead.id}) }}">
        <input type="hidden" name="_token" value="{{ token }}">
        <input type="hidden" name="version" value="{{ lead.version }}">
        <div class="mb-4">
            <label class="grid gap-1 font-medium" for="lead-status">Статус</label>
            <select class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" id="lead-status" name="status">
                {% for status in statuses %}<option value="{{ status.value }}"{{ lead.status == status ? ' selected' }}>{{ status.label }}</option>{% endfor %}
            </select>
        </div>
        <div class="mb-4">
            <label class="grid gap-1 font-medium" for="lead-next-contact">Следующий контакт</label>
            <input class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" id="lead-next-contact" type="date" name="next_contact_at" value="{{ lead.nextContactAt ? lead.nextContactAt|date('Y-m-d') }}">
        </div>
        <button class="rounded-md bg-accent-fill px-4 py-2 font-semibold text-white hover:bg-accent-fill-hover focus-visible:shadow-focus" type="submit">Сохранить</button>
    </form>

    <h2 class="mb-3 mt-8 type-t3">Заметки</h2>
    <form class="max-w-page rounded-lg border bg-white p-6" method="post" action="{{ path('admin_lead_note', {id: lead.id}) }}">
        <input type="hidden" name="_token" value="{{ token }}">
        <div class="mb-4">
            <label class="grid gap-1 font-medium" for="lead-note">Новая заметка</label>
            <textarea class="min-h-24 w-full rounded-md border border-border-strong bg-white px-3 py-2 type-t5" id="lead-note" name="text" rows="3" required maxlength="5000"></textarea>
        </div>
        <button class="rounded-md bg-accent-fill px-4 py-2 font-semibold text-white hover:bg-accent-fill-hover focus-visible:shadow-focus" type="submit">Добавить заметку</button>
    </form>
    {% for note in lead.notes %}
        <div class="mb-3 rounded-lg border bg-white p-3"><div class="type-t6 text-fg-secondary">{{ note.createdAt|date('d.m.Y H:i') }}</div><p class="whitespace-pre-wrap">{{ note.text }}</p></div>
    {% else %}
        <p class="type-t6 text-fg-secondary">Заметок пока нет.</p>
    {% endfor %}

    {% if lead.sameContact %}
        <h2 class="mb-3 mt-8 type-t3">Другие обращения с этим контактом</h2>
        <ul>
            {% for other in lead.sameContact %}
                <li><a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_lead_show', {id: other.id}) }}">№{{ other.id }}</a> от {{ other.createdAt|date('d.m.Y') }} — {{ other.status.label }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2 class="mb-3 mt-8 type-t3">Удаление</h2>
    <form method="post" action="{{ path('admin_lead_delete', {id: lead.id}) }}" class="max-w-page rounded-lg border bg-white p-6" onsubmit="return confirm('Удалить обращение №{{ lead.id }} без возможности восстановления?');">
        <input type="hidden" name="_token" value="{{ token }}">
        <p class="type-t6 text-fg-secondary">Удаляет обращение и заметки без возможности восстановления — например, по запросу человека на удаление персональных данных.</p>
        <button class="rounded-md bg-accent-fill px-4 py-2 font-semibold text-white hover:bg-accent-fill-hover focus-visible:shadow-focus" type="submit">Удалить обращение</button>
    </form>
{% endblock %}
