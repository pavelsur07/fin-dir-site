{% extends 'admin/layout.html.twig' %}

{% block title %}Обращения{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap gap-2">
        <h1 class="mb-6 type-t2-article">Обращения</h1>
    </div>

    {% for message in app.flashes('error') %}<p class="rounded-lg border border-error-border bg-error-bg p-4 text-error" role="alert">{{ message }}</p>{% endfor %}

    <form class="mb-4 flex flex-wrap gap-4" method="get" action="{{ path('admin_lead_list') }}">
        <label class="grid gap-1 font-medium">Статус
            <select class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" name="status">
                <option value="">Все</option>
                {% for status in statuses %}<option value="{{ status.value }}"{{ criteria.status == status ? ' selected' }}>{{ status.label }}</option>{% endfor %}
            </select>
        </label>
        <label class="grid gap-1 font-medium">Форма
            <select class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" name="form">
                <option value="">Все</option>
                {% for key, definition in forms %}<option value="{{ key }}"{{ criteria.form == key ? ' selected' }}>{{ definition.title }}</option>{% endfor %}
            </select>
        </label>
        <label class="grid gap-1 font-medium">Поиск по имени или контакту
            <input class="min-h-control-touch rounded-md border border-border-strong bg-white px-3 py-2 type-t5" type="search" name="q" value="{{ criteria.search }}">
        </label>
        <button type="submit" class="rounded-md border border-border-strong bg-white px-4 py-2 text-fg hover:bg-surface-muted">Показать</button>
    </form>

    {% if pager.nbResults == 0 %}
        <p class="max-w-page rounded-lg border bg-white p-6">Обращений не найдено.</p>
    {% else %}
        {% set token = csrf_token('lead-admin') %}
        {# Куда вернуться после действия из меню: тот же список с фильтрами. Удаление и смена
           статуса при фильтре по статусу убирают строку из выборки -- тогда на первую
           страницу, иначе последняя страница может опустеть и ответить 404. #}
        {% set list_url = app.request.requestUri %}
        {% set list_url_first_page = path('admin_lead_list', app.request.query.all|filter((value, key) => key != 'page')) %}
        <div class="overflow-x-auto">
            <table class="w-full border-collapse border bg-white type-t6">
                <thead>
                <tr>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">№</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Дата</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Имя и контакт</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Форма</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Статус</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Контакт запланирован</th>
                    <th class="border-b border-border-subtle px-3 py-2 text-left font-semibold" scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for lead in pager.currentPageResults %}
                    <tr>
                        <td class="border-b border-border-subtle px-3 py-2 align-top"><a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_lead_show', {id: lead.id}) }}">{{ lead.id }}</a></td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ lead.createdAt|date('d.m.Y H:i') }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">
                            <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_lead_show', {id: lead.id}) }}">{{ lead.name }}</a>
                            <div class="type-t6 text-fg-secondary">{{ lead.contact }}</div>
                        </td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ forms[lead.formKey].title ?? lead.formKey }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">
                            <span class="inline-block rounded-full px-2 py-1 type-t7 font-semibold {{ lead.status.value == 'new' ? 'bg-accent-fill text-white' : (lead.status.value == 'qualified' ? 'bg-success-bg text-success' : 'bg-surface-muted text-fg-secondary') }}">{{ lead.status.label }}</span>
                            {% if lead.needsNotification %}<div class="type-t6 text-fg-secondary">без уведомления</div>{% endif %}
                        </td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">{{ lead.nextContactAt ? lead.nextContactAt|date('d.m.Y') : '—' }}</td>
                        <td class="border-b border-border-subtle px-3 py-2 align-top">
                            <details class="relative"><summary data-admin-menu-toggle class="w-fit cursor-pointer list-none rounded-md border border-border-strong bg-white px-3 py-1 type-t3 text-fg hover:bg-surface-muted" aria-controls="lead-actions-{{ lead.id }}" aria-label="Действия: обращение №{{ lead.id }}">…</summary>
                            <div data-admin-row-menu class="absolute right-0 top-full z-20 grid min-w-sidebar gap-2 rounded-lg border bg-white p-2 shadow-lg" id="lead-actions-{{ lead.id }}">
                                <a class="text-accent underline hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('admin_lead_show', {id: lead.id}) }}">Открыть</a>
                                <hr class="my-1 border-t border-border-subtle">
                                {% for status in statuses|filter(status => status != lead.status) %}
                                    {# Меняем только статус: дата контакта уходит текущей, версия ловит правку из другого окна. #}
                                    <form method="post" action="{{ path('admin_lead_update', {id: lead.id}) }}">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <input type="hidden" name="version" value="{{ lead.version }}">
                                        <input type="hidden" name="status" value="{{ status.value }}">
                                        <input type="hidden" name="next_contact_at" value="{{ lead.nextContactAt ? lead.nextContactAt|date('Y-m-d') }}">
                                        <input type="hidden" name="back" value="{{ criteria.status ? list_url_first_page : list_url }}">
                                        <button class="rounded-md bg-accent-fill px-4 py-2 font-semibold text-white hover:bg-accent-fill-hover focus-visible:shadow-focus" type="submit">Статус: {{ status.label }}</button>
                                    </form>
                                {% endfor %}
                                <hr class="my-1 border-t border-border-subtle">
                                {% if notifications_enabled and lead.needsNotification %}
                                    <form method="post" action="{{ path('admin_lead_notify', {id: lead.id}) }}">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <input type="hidden" name="back" value="{{ list_url }}">
                                        <button class="rounded-md bg-accent-fill px-4 py-2 font-semibold text-white hover:bg-accent-fill-hover focus-visible:shadow-focus" type="submit">Отправить уведомление</button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('admin_lead_delete', {id: lead.id}) }}" onsubmit="return confirm('Удалить обращение №{{ lead.id }} без возможности восстановления?');">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <input type="hidden" name="back" value="{{ list_url_first_page }}">
                                    <button type="submit" class="text-accent">Удалить</button>
                                </form>
                            </div>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pager.haveToPaginate %}
            <nav class="mt-4 flex flex-wrap gap-2" aria-label="Страницы">
                {{ pagerfanta(pager, {omitFirstPage: true, prev_message: '←', next_message: '→'}) }}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
