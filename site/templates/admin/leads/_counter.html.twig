{# aria-label на span без роли не озвучивается: число для глаз, текст -- для экранных дикторов. #}
{% if count > 0 %}<span data-admin-count class="inline-flex min-w-6 items-center justify-center rounded-full bg-accent-fill px-2 type-t7 font-bold text-on-accent"><span aria-hidden="true">{{ count }}</span><span class="sr-only">новых обращений: {{ count }}</span></span>{% endif %}
