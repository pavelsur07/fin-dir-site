{# ponytail: временная Twig-админка до React Admin (AGENTS.md §8). Свой минимальный
   CSS в public/assets/admin/admin.css -- вне сборки и design system публичного сайта.
   После правки CSS/JS: cat site/public/assets/admin/admin.{css,js} | sha256sum | cut -c1-12 → admin_asset_version. #}
{% set admin_asset_version = 'a2c6ae67401c' %}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Админка{% endblock %} — Ваш Финдир</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="/assets/admin/admin.css?v={{ admin_asset_version }}" rel="stylesheet">
    <script src="/assets/admin/admin.js?v={{ admin_asset_version }}" defer></script>
</head>
<body>
{% block page %}
    {% set route = app.request.attributes.get('_route') ?? '' %}
    {# Один список разделов: новый раздел админки -- одна строка здесь. #}
    {% set menu = [
        {label: 'Панель', route: 'admin_dashboard', active_prefix: 'admin_dashboard'},
        {label: 'Публикации', route: 'admin_post_list', active_prefix: 'admin_post'},
        {label: 'Обращения', route: 'admin_lead_list', active_prefix: 'admin_lead', counter: true},
    ] %}
    {# Счётчик считается один раз (фрагмент-контроллер) и выводится в обоих местах меню. #}
    {% set counter %}{{ render(controller('App\\Lead\\Controller\\Admin\\LeadCounterController')) }}{% endset %}
    <a class="skip-link" href="#main">К содержимому</a>
    <div class="shell">
        <div class="sidebar">
            <a class="brand" href="{{ path('admin_dashboard') }}">Ваш Финдир <small>Админка</small></a>
            {% include 'admin/_nav.html.twig' with {menu: menu, route: route, counter: counter} only %}
        </div>
        <div class="workspace">
            {# Узкий экран: сайдбар скрыт, меню раскрывается нативным details без JS. #}
            <details class="mobile-bar">
                <summary>
                    {# Бренд скрыт от дикторов: кнопка должна называться «Меню», а не всей строкой. #}
                    <span class="brand" aria-hidden="true">Ваш Финдир · Админка</span>
                    <span class="menu-button">Меню{{ counter }}</span>
                </summary>
                {% include 'admin/_nav.html.twig' with {menu: menu, route: route, counter: counter} only %}
            </details>
            <main class="main" id="main">
                {% for message in app.flashes('success') %}
                    <p class="flash" role="status">{{ message }}</p>
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}
</body>
</html>
