{% set vf_asset_version = '57ee4f7ff008' %}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Админка{% endblock %} — Ваш Финдир</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="/assets/website/app.css?v={{ vf_asset_version }}" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-950">
{% block page %}
    {% set route = app.request.attributes.get('_route') ?? '' %}
    {# Один список разделов: новый раздел админки -- одна строка здесь. #}
    {% set menu = [
        {label: 'Панель', route: 'admin_dashboard', active_prefix: 'admin_dashboard'},
        {label: 'Публикации', route: 'admin_post_list', active_prefix: 'admin_post'},
        {label: 'Обращения', route: 'admin_lead_list', active_prefix: 'admin_lead', counter: true},
    ] %}
    {# Счётчик считается один раз (фрагмент-контроллер) и выводится в обоих местах меню. #}
    {% set counter %}{{ render(controller('App\\Lead\\Controller\\Admin\\LeadCounterController')) }}{% endset %}
    <a class="fixed left-4 top-2 z-20 -translate-y-24 rounded bg-white px-3 py-2 text-slate-950 focus:translate-y-0" href="#main">К содержимому</a>
    <div class="flex min-h-screen">
        <div data-admin-sidebar class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col overflow-y-auto bg-slate-950 px-4 py-6 text-white lg:flex">
            <a class="mb-6 block font-bold text-white no-underline" href="{{ path('admin_dashboard') }}">Ваш Финдир <small>Админка</small></a>
            {% include 'admin/_nav.html.twig' with {menu: menu, route: route, counter: counter} only %}
        </div>
        <div class="min-w-0 flex-1">
            {# Узкий экран: сайдбар скрыт, меню раскрывается нативным details без JS. #}
            <details data-admin-mobile-menu class="sticky top-0 z-10 bg-slate-950 p-4 text-white lg:hidden">
                <summary>
                    {# Бренд скрыт от дикторов: кнопка должна называться «Меню», а не всей строкой. #}
                    <span class="mb-6 block font-bold text-white no-underline" aria-hidden="true">Ваш Финдир · Админка</span>
                    <span class="inline-flex items-center rounded border border-slate-400 px-3 py-1">Меню{{ counter }}</span>
                </summary>
                {% include 'admin/_nav.html.twig' with {menu: menu, route: route, counter: counter} only %}
            </details>
            <main class="p-4 lg:p-8" id="main">
                {% for message in app.flashes('success') %}
                    <p class="rounded-lg border border-green-300 bg-green-50 p-4 text-green-800" role="status">{{ message }}</p>
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}
</body>
</html>
