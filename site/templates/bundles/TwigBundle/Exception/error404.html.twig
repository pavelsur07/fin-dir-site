{% extends 'base.html.twig' %}
{% block body %}
    <main class="tech-page">
        <section class="section tech-hero py-5" id="error-404">
            <div class="container">
                <nav aria-label="Хлебные крошки" class="breadcrumbs-wrap">
                    <ol class="breadcrumb vf-breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Главная</a></li>
                        <li aria-current="page" class="breadcrumb-item active">Страница не найдена</li>
                    </ol>
                </nav>
                <div class="tech-shell p-4 p-md-5">
                    <div class="row g-5 align-items-center">
                        <div class="col-lg-7">
                            <div class="tech-kicker">Ошибка 404</div>
                            <h1 class="tech-title mb-4">Такой страницы <em>нет</em></h1>
                            <p class="tech-lead mb-4">Возможно, ссылка устарела, адрес набран с ошибкой или страница была перенесена. Поможем быстро вернуться к полезным материалам и услугам.</p>
                            <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                                <a class="btn btn-primary btn-lg" href="/">На главную</a>
                                <a class="btn btn-outline-secondary btn-lg" href="/blog">Перейти в газету</a>
                            </div>
                            <p class="tech-meta mb-0"><strong>Совет:</strong> если вы попали сюда из письма, рекламы или старой закладки — откройте главную страницу и выберите нужный раздел заново.</p>
                        </div>
                        <div class="col-lg-5">
                            <div class="tech-panel p-4 p-md-5 text-center">
                                <div class="tech-code mb-4">404</div>
                                <div class="row g-3 text-start">
                                    <div class="col-12">
                                        <a class="tech-action-card" href="/services">
                                            <span class="tech-panel-icon"><i class="bi bi-grid-1x2"></i></span>
                                            <span><h2>Услуги</h2><p>Финансовый учёт, отчётность и планирование.</p></span>
                                        </a>
                                    </div>
                                    <div class="col-12">
                                        <a class="tech-action-card" href="/cases">
                                            <span class="tech-panel-icon"><i class="bi bi-graph-up-arrow"></i></span>
                                            <span><h2>Кейсы</h2><p>Как порядок в цифрах влияет на решения.</p></span>
                                        </a>
                                    </div>
                                    <div class="col-12">
                                        <a class="tech-action-card" href="/partners">
                                            <span class="tech-panel-icon"><i class="bi bi-people"></i></span>
                                            <span><h2>Партнёрам</h2><p>Сотрудничество для сервисов и экспертов.</p></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
