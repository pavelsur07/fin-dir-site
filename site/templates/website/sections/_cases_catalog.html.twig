{#
    Каталог кейсов: фильтр по отрасли (ссылки, без JS), счётчик, главный кейс и сетка карточек.
    Аргументы: industry (CaseIndustry|null), industries, featured (FeaturedCaseView|null), cases, total.
#}
<section class="bg-surface py-12 md:py-16" aria-labelledby="cases-filter-title">
    <div class="mx-auto flex max-w-container flex-col gap-8 px-4 md:px-8">
        <nav class="flex flex-col gap-4" aria-labelledby="cases-filter-title" data-vf-component="cases-filter">
            <h2 class="font-display font-extrabold type-t3 text-fg" id="cases-filter-title">Отрасль клиента</h2>
            <ul class="scrollbar-none flex gap-2 overflow-x-auto px-1 py-1 md:flex-wrap md:overflow-visible">
                <li class="shrink-0">
                    <a class="inline-flex h-control-md items-center whitespace-nowrap rounded-full px-4 type-t6 font-medium no-underline focus-visible:shadow-focus {{ industry ? 'border border-border-strong bg-surface-raised text-fg hover:bg-surface-muted' : 'bg-ink-950 text-white' }}" href="{{ path('app_cases_index') }}"{% if not industry %} aria-current="true"{% endif %}>Все</a>
                </li>
                {% for item in industries %}
                    <li class="shrink-0">
                        <a class="inline-flex h-control-md items-center whitespace-nowrap rounded-full px-4 type-t6 font-medium no-underline focus-visible:shadow-focus {{ industry == item ? 'bg-ink-950 text-white' : 'border border-border-strong bg-surface-raised text-fg hover:bg-surface-muted' }}" href="{{ path('app_cases_index', {industry: item.value}) }}"{% if industry == item %} aria-current="true"{% endif %}>{{ item.label }}</a>
                    </li>
                {% endfor %}
            </ul>
            <p class="type-t6 text-fg-secondary" role="status">Показано кейсов: {{ total }}</p>
        </nav>

        {% if featured %}
            {% include 'website/sections/_case_featured.html.twig' with {case: featured} only %}
        {% endif %}

        {% if cases is not empty %}
            <h2 class="sr-only">Все кейсы</h2>
            <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                {% for case in cases %}
                    <li>{% include 'website/components/_case_card.html.twig' with {case: case} only %}</li>
                {% endfor %}
            </ul>
        {% elseif not featured %}
            <p class="type-t4 text-fg-secondary">В этой отрасли кейсов пока нет.</p>
        {% endif %}
    </div>
</section>
