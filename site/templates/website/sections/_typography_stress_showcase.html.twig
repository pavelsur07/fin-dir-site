{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-white' %}
{% set section_id = id|default('vf-typography-stress') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = 'typography-stress' %}

{% block section_content %}
    <div class="mb-8 max-w-3xl">
        <p class="mb-4 text-xs leading-5 font-medium text-slate-600 uppercase">Typography stress test</p>
        <h2 id="{{ labelled_by }}" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">Кириллица, числа и длинные строки</h2>
        <p class="mb-0 text-lg leading-7 text-slate-600">Техническая проверка текста на разных ширинах экрана.</p>
    </div>

    <div class="grid max-w-3xl gap-4" data-vf-showcase="typography-stress">
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H1 / короткий</p>
        <p class="mb-0 text-4xl leading-tight md:text-5xl font-extrabold font-bold">Финансы без догадок</p>
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H1 / средний</p>
        <p class="mb-0 text-4xl leading-tight md:text-5xl font-extrabold font-bold">Финансовая система для устойчивого роста бизнеса</p>
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H1 / длинный</p>
        <p class="mb-0 text-4xl leading-tight md:text-5xl font-extrabold font-bold">Управляйте финансами бизнеса на основе данных, а не ощущения остатка на счёте</p>
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H2 / средний</p>
        <p class="mb-0 text-3xl leading-tight md:text-4xl font-extrabold font-bold">Планируйте движение денежных средств без кассовых разрывов</p>
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H2 / 100+ символов</p>
        <p class="mb-0 text-3xl leading-tight md:text-4xl font-extrabold font-bold">Собирайте план, факт и прогноз движения денег в одном управленческом контуре, чтобы обсуждать отклонения до принятия решения</p>
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H3 / средний</p>
        <p class="mb-0 text-xl leading-7 font-bold font-bold">Сверяйте план и факт по каждому направлению</p>
        <p class="mb-0 text-xs leading-5 font-medium text-slate-600 uppercase">H3 / 100+ символов</p>
        <p class="mb-0 text-xl leading-7 font-bold font-bold">Определите единые правила подготовки финансовых данных и регулярно проверяйте результат вместе с ответственными участниками</p>
        <p class="mb-0 text-xl leading-7 font-bold font-bold">Проверяйте отклонения до управленческой встречи</p>
        <p class="mb-0 text-lg leading-7">Проверка символов: 2 450 000 ₽ · 18,5% · −7% · «план» (факт).</p>
        <p class="mb-0">Аа Бб Вв Ёё Йй Фф Щщ Ъъ Ыы Ьь Ээ Юю Яя · 0123456789 · ₽ % № — «» () / + − =</p>
        <p class="mb-0 text-sm leading-6">Small: пояснение к данным за выбранный период.</p>
        <p class="mb-0 text-xs leading-5 font-medium uppercase">Caption: план / факт</p>
    </div>
{% endblock %}
