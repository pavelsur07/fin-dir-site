{#
    Содержание отдельного кейса: проблема и шаги слева, панель результатов справа. Вход: case (CaseDetailView).
    Метрики не заданы -- панель показывает ключевой результат кейса.
#}
{% set metrics = case.metrics is not empty ? case.metrics : [{value: case.resultValue, label: case.resultLabel}] %}
<section class="bg-surface py-12 md:py-16" aria-labelledby="case-problem-title">
    <div class="mx-auto grid max-w-container grid-cols-1 gap-8 px-4 md:px-8 lg:grid-cols-2 lg:gap-12">
        <div class="flex flex-col items-start gap-4">
            <ul class="flex flex-wrap gap-2">
                <li class="rounded-xs bg-surface-muted px-2 py-1 type-t7 font-medium text-fg-secondary">{{ case.industry.label }}</li>
                {% for tag in case.tags %}
                    <li class="rounded-xs border border-border px-2 py-1 type-t7 text-fg-secondary">{{ tag }}</li>
                {% endfor %}
            </ul>
            <h2 class="type-t2-article text-fg md:type-t2" id="case-problem-title">Была проблема</h2>
            <p class="type-t4 text-fg-secondary">{{ case.task ?? case.problem }}</p>
            {% if case.steps is not empty %}
                <h2 class="mt-4 type-t3 text-fg">Что сделали</h2>
                <ol class="flex flex-col gap-3">
                    {% for step in case.steps %}
                        <li class="flex gap-3 type-t5 text-fg-secondary">
                            {% include 'website/components/_icon.html.twig' with {name: 'check', class: 'size-icon-md shrink-0 text-accent'} only %}
                            <span>{{ step }}</span>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </div>
        <div class="flex flex-col gap-6 self-start rounded-lg bg-surface-muted p-6 md:p-8">
            <h2 class="type-t3 text-fg">Что увидел собственник</h2>
            <dl class="flex flex-col gap-6">
                {% for metric in metrics %}
                    {# Подпись (dt) в разметке идёт первой, визуально число стоит над ней. #}
                    <div class="flex flex-col-reverse gap-1">
                        <dt class="type-t6 text-fg-secondary">{{ metric.label }}</dt>
                        <dd class="type-t8 text-accent">{{ metric.value }}</dd>
                    </div>
                {% endfor %}
            </dl>
            {% if case.source %}<p class="type-t7 text-fg-muted">{{ case.source }}</p>{% endif %}
        </div>
    </div>
</section>
