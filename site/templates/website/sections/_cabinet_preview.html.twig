<section class="dark bg-surface py-16 md:py-24" aria-labelledby="home-cabinet-preview-title">
    <div class="mx-auto max-w-page px-4 md:px-8">
        <h2 id="home-cabinet-preview-title" class="type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <p class="mt-3 mb-12 max-w-text type-t4 text-fg-secondary">{{ subtitle }}</p>
        <ul class="grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-6">
            {% for card in cards %}
                <li class="max-w-text">
                    <figure class="flex flex-col gap-4">
                        <picture>
                            <source type="image/webp" srcset="/assets/screens/{{ card.image }}-720.webp 720w, /assets/screens/{{ card.image }}-1440.webp 1440w" sizes="(min-width: 1024px) 360px, (min-width: 768px) 720px, 100vw">
                            <img class="w-full aspect-screenshot rounded-lg bg-white shadow-md" src="/assets/screens/{{ card.image }}-720.webp" width="720" height="450" loading="lazy" decoding="async" alt="{{ card.alt }}">
                        </picture>
                        <figcaption class="type-t6 font-semibold text-fg">{{ card.caption }}</figcaption>
                    </figure>
                </li>
            {% endfor %}
        </ul>
        <p class="mt-8 type-t7 text-fg-muted">{{ note }}</p>
    </div>
</section>
