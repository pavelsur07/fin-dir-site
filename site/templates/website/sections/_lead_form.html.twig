{#
    Lead Form -- виджет формы обращения (Stage 7). Отправляет на POST /lead.
    Раскладка -- паттерн 25.4 ДС (экскурсия): секция на всю ширину, слева описание, справа карточка формы.
    Вход: form ('consultation' | 'excursion' | 'diagnostics' -- ключ LeadFormCatalog), title,
    optional: id, text, badge, points [{icon, title, text}], person {name, role, quote, image, alt},
    form_title, action_label, note, variant ('panel' -- светлая панель на bg-surface; badge тогда меткой text-accent;
    'brand' -- синяя карточка главной: текст, фото person.photo_800 на наклонной полосе, белая карточка формы; subtext -- второй абзац),
    with_task (false -- без поля «Коротко о задаче»; по умолчанию true).
    Поля формы -- components/_lead_form_body (общие с окном sections/_lead_modal); вопросы выводятся чипами из LeadFormCatalog.
    Контракт POST /lead (поля, CSRF, data-vf-* хуки) общий для всех вариантов: меняется только оформление.
#}
{% set section_id = id|default('vf-lead-form') %}
{% set labelled_by = section_id ~ '-title' %}
{% set definition = lead_form(form|default('consultation')) %}
{% set with_contact_type = definition.key == 'excursion' %}
{% set panel = variant|default('default') == 'panel' %}
{% set brand = variant|default('default') == 'brand' %}
{% set field_tone = brand ? 'muted' : 'default' %}

{% set lead_form_html %}
        <form class="{{ brand ? 'flex w-full flex-col gap-4 rounded-xl bg-surface p-6 text-fg' : (panel ? 'order-2 flex w-full max-w-modal-md flex-col gap-5 rounded-lg border border-border bg-surface p-6 md:order-none md:justify-self-end md:p-8' : 'flex flex-col gap-6 order-2 rounded-xl bg-surface p-8 shadow-md md:order-none') }}" method="post" action="{{ path('lead_submit') }}" data-vf-lead-form data-vf-form-key="{{ definition.key }}" aria-labelledby="{{ form_title|default(null) ? section_id ~ '-form-title' : labelled_by }}" novalidate>
            {% if form_title|default(null) %}<h3 class="type-t3 text-fg" id="{{ section_id }}-form-title">{{ form_title }}</h3>{% endif %}
            {% include 'website/components/_lead_form_body.html.twig' with {
                id: section_id,
                definition: definition,
                tone: field_tone,
                with_contact_type: with_contact_type,
                with_task: with_task is not defined or with_task,
                link_class: panel or brand ? 'rounded-xs text-accent underline focus-visible:shadow-focus' : 'rounded-xs underline focus-visible:shadow-focus',
                agreement_after_submit: brand,
                submit_label: action_label|default('Отправить заявку'),
                submit_size: brand ? 'xl' : 'lg',
                note: note|default(null),
            } only %}
        </form>
{% endset %}

<section class="{{ panel or brand ? 'scroll-mt-16 bg-surface' : 'scroll-mt-16 bg-surface-muted' }}" id="{{ section_id }}" aria-labelledby="{{ labelled_by }}" data-vf-section="lead-form">
    {% if brand %}
    {# brand: до md -- текст, фото, форма друг под другом; md -- текст и фото в ряд, форма ниже; с lg -- три колонки 3/3/4. #}
    <div class="mx-auto w-full max-w-container px-4 pt-16 pb-16 md:px-8">
        <div class="grid overflow-hidden rounded-xl bg-accent-fill text-white md:grid-cols-2 lg:grid-cols-10">
            <div class="flex flex-col justify-center gap-5 px-5 pt-8 md:px-10 md:py-12 lg:col-span-3 lg:py-16 lg:pr-8 lg:pl-12">
                <h2 class="font-display type-t2-article text-balance text-white md:type-t2" id="{{ labelled_by }}">{{ title }}</h2>
                {% if text|default(null) %}<p class="max-w-lead type-t4 text-cobalt-100">{{ text }}</p>{% endif %}
                {% if subtext|default(null) %}<p class="max-w-lead type-t5 text-cobalt-100">{{ subtext }}</p>{% endif %}
            </div>
            {% if person|default(null) %}
                <div class="relative isolate mt-6 aspect-4/3 overflow-hidden md:mt-0 md:aspect-auto lg:col-span-3">
                    <div class="absolute -top-1/10 -bottom-1/10 left-9/50 w-16/25 -skew-x-12 bg-cobalt-100" aria-hidden="true"></div>
                    <picture>
                        {% if person.photo_800|default(null) %}
                            <source srcset="{{ person.photo_800 }}-800.avif" type="image/avif">
                            <source srcset="{{ person.photo_800 }}-800.webp" type="image/webp">
                        {% endif %}
                        <img class="absolute bottom-0 left-1/2 h-11/12 w-auto max-w-none -translate-x-1/2" src="{{ person.image }}" alt="{{ person.alt }}" width="1122" height="1402" loading="lazy" decoding="async">
                    </picture>
                </div>
            {% endif %}
            <div class="flex items-center p-4 md:col-span-2 md:p-8 lg:col-span-4 lg:py-10 lg:pr-10 lg:pl-6">
                {{ lead_form_html }}
            </div>
        </div>
    </div>
    {% else %}
    {% if panel %}<div class="mx-auto w-full max-w-page px-4 py-16 md:px-8 md:py-24"><div class="rounded-xl border border-border-subtle bg-surface-muted p-6 md:p-12">{% endif %}
    <div class="{{ panel ? 'grid w-full grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12' : 'mx-auto grid w-full max-w-container items-start gap-8 px-4 py-16 md:grid-cols-2 md:gap-x-12 md:px-8 md:py-24' }}">
        {# Левая колонка: на мобильном «contents» -- блоки встают в общую сетку (описание → форма → сотрудник), с md -- одна колонка. #}
        <div class="contents md:flex md:flex-col md:gap-8">
            <div class="order-1 flex flex-col gap-4">
                {% if badge|default(null) %}<span class="{{ panel ? 'self-start type-t7 font-medium text-accent' : 'self-start whitespace-nowrap rounded-full border border-border-subtle bg-surface px-3 py-1 type-t7 font-medium text-fg-secondary' }}">{{ badge }}</span>{% endif %}
                <h2 class="font-display font-extrabold type-t2-article text-fg md:type-t2" id="{{ labelled_by }}">{{ title }}</h2>
                {% if text|default(null) %}<p class="{{ panel ? 'max-w-text type-t4 text-fg-secondary' : 'type-t4 text-fg-secondary' }}">{{ text }}</p>{% endif %}
            </div>
            {% if points|default([]) is not empty %}
                <ul class="order-1 flex flex-col">
                    {% for point in points %}
                        <li class="flex gap-4 border-t border-border py-4">
                            <span class="flex size-control-md shrink-0 items-center justify-center rounded-sm bg-surface text-accent">
                                {% include 'website/components/_icon.html.twig' with {name: point.icon, class: 'size-icon-md'} only %}
                            </span>
                            <div class="flex flex-col gap-1">
                                <span class="type-t5 font-semibold text-fg">{{ point.title }}</span>
                                {% if point.text|default(null) %}<span class="type-t6 text-fg-secondary">{{ point.text }}</span>{% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if person|default(null) %}
                <figure class="flex items-end gap-5 rounded-lg border border-border-subtle bg-surface p-5 order-3">
                    <div class="aspect-4/5 w-24 shrink-0 overflow-hidden rounded-md bg-border-subtle">
                        {% include 'website/components/_portrait.html.twig' with {
                            src: person.image,
                            webp_base: person.image_webp|default(null),
                            alt: person.alt,
                            class: 'size-full object-cover object-top',
                            sizes: '96px',
                        } only %}
                    </div>
                    <div class="flex min-w-0 flex-col gap-2">
                        {% if person.quote|default(null) %}<blockquote class="type-t6 text-fg">«{{ person.quote }}»</blockquote>{% endif %}
                        <figcaption class="flex flex-col">
                            <span class="type-t6 font-semibold text-fg">{{ person.name }}</span>
                            <span class="type-t7 font-medium text-fg-muted">{{ person.role }}</span>
                        </figcaption>
                    </div>
                </figure>
            {% endif %}
        </div>
        {{ lead_form_html }}
    </div>
    {% if panel %}</div></div>{% endif %}
    {% endif %}
</section>
