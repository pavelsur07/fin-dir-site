{#
    Lead Form -- виджет формы обращения (Stage 7). Отправляет на POST /lead.
    Вход: form ('consultation' | 'diagnostics' -- ключ LeadFormCatalog), title,
    optional: id, text, action_label, note.
    Раскладка -- паттерн 25.4 ДС (экскурсия): секция на всю ширину, слева описание, справа карточка формы.
#}
{% set section_id = id|default('vf-lead-form') %}
{% set labelled_by = section_id ~ '-title' %}
{% set definition = lead_form(form|default('consultation')) %}

{% set points = [
    {icon: 'calendar-check', title: '45 минут'},
    {icon: 'chart-no-axes-column', title: 'Разберём на ваших цифрах'},
    {icon: 'check', title: 'Без продажи с порога'},
] %}
<section class="bg-surface-muted" id="{{ section_id }}" aria-labelledby="{{ labelled_by }}" data-vf-section="lead-form">
    <div class="mx-auto grid w-full max-w-container items-start gap-8 px-4 py-16 md:grid-cols-2 md:gap-x-12 md:px-8 md:py-24">
        <div class="flex flex-col gap-8">
            <div class="flex flex-col gap-4">
                <span class="self-start whitespace-nowrap rounded-full border border-border-subtle bg-surface px-3 py-1 type-t7 font-medium text-fg-secondary">Экскурсия · 45 минут</span>
                <h2 class="type-t2 text-fg" id="{{ labelled_by }}">{{ title }}</h2>
                {% if text|default(null) %}<p class="type-t4 text-fg-secondary">{{ text }}</p>{% endif %}
            </div>
            <ul class="flex flex-col">
                {% for point in points %}
                    <li class="flex items-center gap-4 border-t border-border py-4">
                        <span class="flex size-control-md shrink-0 items-center justify-center rounded-sm bg-surface text-accent">
                            {% include 'website/components/_icon.html.twig' with {name: point.icon, class: 'size-icon-md'} only %}
                        </span>
                        <span class="type-t5 font-semibold text-fg">{{ point.title }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <form class="md:col-start-2 md:row-span-2 md:row-start-1 flex flex-col gap-6 rounded-xl bg-surface p-8 shadow-md" method="post" action="{{ path('lead_submit') }}" data-vf-lead-form data-vf-form-key="{{ definition.key }}" aria-labelledby="{{ labelled_by }}" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('lead_submit') }}">
            <input type="hidden" name="form" value="{{ definition.key }}">
            {# Заполняет JS: id отправки (защита от дублей), время открытия (антиспам), источник. #}
            <input type="hidden" name="submission_id" value="">
            <input type="hidden" name="fill_ms" value="">
            <input type="hidden" name="page_url" value="">
            <input type="hidden" name="referrer" value="">
            {# Honeypot: человек поле не видит и не заполняет; заполнил -- бот. #}
            <div class="hidden" aria-hidden="true">
                <label for="{{ section_id }}-website">Сайт компании</label>
                <input id="{{ section_id }}-website" name="website" type="text" value="" tabindex="-1" autocomplete="off">
            </div>

            {% include 'website/components/_form_input.html.twig' with {
                id: section_id ~ '-name',
                name: 'name',
                label: 'Имя',
                required: true,
                autocomplete: 'name',
                placeholder: 'Как к вам обращаться',
                analytics_private: true,
            } only %}
            {% include 'website/components/_form_input.html.twig' with {
                id: section_id ~ '-contact',
                name: 'contact',
                label: 'Телефон, email или Telegram',
                required: true,
                placeholder: 'Телефон, email или @telegram',
                analytics_private: true,
            } only %}
            {% for question in definition.questions %}
                {% set options = [{value: '', label: 'Выберите вариант'}] %}
                {% for value, label in question.options %}{% set options = options|merge([{value: value, label: label}]) %}{% endfor %}
                {% include 'website/components/_form_select.html.twig' with {
                    id: section_id ~ '-' ~ question.key,
                    name: 'answers[' ~ question.key ~ ']',
                    label: question.label,
                    required: true,
                    options: options,
                } only %}
            {% endfor %}
            {% include 'website/components/_form_textarea.html.twig' with {
                id: section_id ~ '-task',
                name: 'task',
                label: 'Коротко о задаче',
                placeholder: 'Контекст для первого разговора',
                analytics_private: true,
            } only %}
            {% set agreement_links %}<a class="rounded-xs underline focus-visible:shadow-focus" href="{{ path('consent') }}">Согласие на обработку данных</a> и <a class="rounded-xs underline focus-visible:shadow-focus" href="{{ path('privacy') }}">политика конфиденциальности</a>.{% endset %}
            {% include 'website/components/_form_checkbox.html.twig' with {
                id: section_id ~ '-agreement',
                name: 'agreement',
                label: 'Согласен на обработку персональных данных',
                note_html: agreement_links,
                required: true,
            } only %}
            {% include 'website/components/_button.html.twig' with {label: action_label|default('Отправить заявку'), type: 'submit', class: 'w-full'} only %}
            <p class="rounded-md border border-success-border bg-success-bg p-4 type-t6 text-success" role="status" data-vf-lead-success hidden>Спасибо! Заявка отправлена, мы свяжемся с вами в ближайшее время.</p>
            <p class="rounded-md border border-error-border bg-error-bg p-4 type-t6 text-error" role="alert" data-vf-lead-error hidden></p>
            </form>
        <figure class="md:col-start-1 md:row-start-2 flex w-fit items-center gap-4 rounded-lg border border-border-subtle bg-surface p-5">
            <img class="aspect-4/5 w-24 shrink-0 rounded-md bg-surface-raised object-cover object-top" src="/assets/people/pavel-novikov.png" alt="Павел Новиков, управляющий партнёр" width="1122" height="1402" loading="lazy">
            <figcaption class="flex flex-col">
                <span class="type-t6 font-semibold text-fg">Павел Новиков</span>
                <span class="type-t7 font-medium text-fg-muted">Управляющий партнёр</span>
            </figcaption>
        </figure>
    </div>
</section>
