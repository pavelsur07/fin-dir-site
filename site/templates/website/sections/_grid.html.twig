{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-white' %}
{% set section_id = id|default('vf-grid') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = marker|default('grid') %}

{% block section_content %}
    <div class="mb-8 max-w-3xl">
        {% if eyebrow|default(null) %}<p class="mb-4 text-xs leading-5 font-medium text-slate-600 uppercase">{{ eyebrow }}</p>{% endif %}
        <h2 id="{{ labelled_by }}" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">{{ title }}</h2>
        {% if text|default(null) %}<p class="mb-0 text-lg leading-7 text-slate-600">{{ text }}</p>{% endif %}
    </div>

    <ul class="grid grid md:grid-cols-2 lg:grid-cols-3 gap-6" role="list" data-vf-layout="grid">
        {% for item in items %}
            <li class="border-t border-slate-200 pt-4">
                <h3 class="text-xl leading-7 font-bold">{% if item.href|default(null) %}<a href="{{ item.href }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
                {% if item.meta|default(null) %}<p class="text-sm leading-6 text-slate-600">{% if item.meta_datetime|default(null) %}<time datetime="{{ item.meta_datetime }}">{{ item.meta }}</time>{% else %}{{ item.meta }}{% endif %}</p>{% endif %}
                {% if item.text|default(null) %}<p class="text-slate-600">{{ item.text }}</p>{% endif %}
                {% if item.details|default([]) %}
                    <ul class="grid gap-3" role="list">
                        {% for detail in item.details %}<li class="flex gap-3"><span class="text-slate-600" aria-hidden="true">—</span><span>{{ detail }}</span></li>{% endfor %}
                    </ul>
                {% endif %}
                {% if item.action|default(null) %}
                    {% include 'website/components/_button.html.twig' with {
                        label: item.action.label,
                        href: item.action.href,
                        variant: 'secondary',
                        class: 'mt-4',
                    } only %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {% if pagination|default(null) %}
        {% include 'website/components/_pagination.html.twig' with pagination only %}
    {% endif %}
{% endblock %}
