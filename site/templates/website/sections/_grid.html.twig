{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-bg' %}
{% set section_id = id|default('vf-grid') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = marker|default('grid') %}

{% block section_content %}
    <div class="mb-8 max-w-content">
        {% if eyebrow|default(null) %}<p class="mb-4 text-t7 font-medium text-fg-secondary uppercase">{{ eyebrow }}</p>{% endif %}
        <h2 id="{{ labelled_by }}">{{ title }}</h2>
        {% if text|default(null) %}<p class="mb-0 text-t4 text-fg-secondary">{{ text }}</p>{% endif %}
    </div>

    <ul class="grid grid-auto-fit gap-6" role="list" data-vf-layout="grid">
        {% for item in items %}
            <li class="border-t border-border pt-4">
                <h3 class="text-t3">{% if item.href|default(null) %}<a href="{{ item.href }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
                {% if item.meta|default(null) %}<p class="text-t6 text-fg-secondary">{% if item.meta_datetime|default(null) %}<time datetime="{{ item.meta_datetime }}">{{ item.meta }}</time>{% else %}{{ item.meta }}{% endif %}</p>{% endif %}
                {% if item.text|default(null) %}<p class="text-fg-secondary">{{ item.text }}</p>{% endif %}
                {% if item.details|default([]) %}
                    <ul class="grid gap-3" role="list">
                        {% for detail in item.details %}<li class="flex gap-3"><span class="text-fg-secondary" aria-hidden="true">—</span><span>{{ detail }}</span></li>{% endfor %}
                    </ul>
                {% endif %}
                {% if item.action|default(null) %}
                    {% include 'website/components/_button.html.twig' with {
                        label: item.action.label,
                        href: item.action.href,
                        variant: 'secondary',
                        class: 'mt-4',
                    } only %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {% if pagination|default(null) %}
        {% include 'website/components/_pagination.html.twig' with pagination only %}
    {% endif %}
{% endblock %}
