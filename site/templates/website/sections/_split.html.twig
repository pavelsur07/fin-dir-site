{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-white' %}
{% set section_id = id|default('vf-split') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = marker|default('feature') %}
{% set media_position = media_position|default('right') == 'left' ? 'left' : 'right' %}
{% set has_media = media|default(null) or demo_media|default(false) %}

{% block section_content %}
    <div class="grid items-center gap-8{% if has_media %} md:grid-cols-2{% endif %}" data-vf-layout="split" data-vf-media-position="{{ media_position }}" data-vf-has-media="{{ has_media ? 'true' : 'false' }}">
        <div class="max-w-3xl">
            {% if eyebrow|default(null) %}<p class="mb-4 text-xs leading-5 font-medium text-slate-600 uppercase">{{ eyebrow }}</p>{% endif %}
            <h2 id="{{ labelled_by }}" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">{{ title }}</h2>
            <p class="text-lg leading-7 text-slate-600">{{ text }}</p>
            {% if items|default([]) %}
                <ul class="grid gap-3" role="list">
                    {% for item in items %}<li class="flex gap-3"><span class="text-slate-600" aria-hidden="true">—</span><span>{{ item }}</span></li>{% endfor %}
                </ul>
            {% endif %}
            {% if action|default(null) %}
                {% include 'website/components/_button.html.twig' with {
                    label: action.label,
                    href: action.href,
                    variant: 'secondary',
                    class: 'mt-4',
                } only %}
            {% endif %}
        </div>

        {% if has_media %}
            <div class="{% if media_position == 'left' %}md:order-first{% endif %}">
                {% if media|default(null) %}
                    <img class="aspect-16/10 block w-full rounded-lg object-cover" src="{{ media.src }}" alt="{{ media.alt }}">
                {% else %}
                    <div class="grid aspect-16/10 place-content-center gap-2 rounded-lg border border-slate-500 bg-slate-50 text-center text-slate-600" aria-hidden="true" data-vf-demo-media>
                        <strong>Demo media</strong>
                        <span>16:10</span>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
