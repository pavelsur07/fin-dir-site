{#
    «Вопросы и ответы» главной: слева заголовок и тёмная карточка «Не нашли свой вопрос?», справа список вопросов.
    Аккордеон без JS: <details name> -- браузер держит открытым один вопрос; первый открыт.
    Аргументы: id (id секции, заголовок -- id ~ '-title'), title, subtitle, items [{question, answer}],
    aside {title, text, cta {label, href}}.
    До md: заголовок, список, карточка (side -- contents, порядок через order); md -- side над списком; с lg -- две колонки, side прилипает.
    Общий sections/_faq.html.twig (страница «Финансовый директор») не меняется.
#}
<section class="bg-surface pt-16 pb-10" id="{{ id }}" aria-labelledby="{{ id }}-title" data-vf-section="faq-split">
    <div class="mx-auto grid w-full max-w-container gap-5 px-4 md:gap-10 md:px-8 lg:grid-cols-3 lg:gap-16">
        <div class="contents md:flex md:flex-col md:gap-5 lg:sticky lg:top-sticky lg:self-start">
            <div class="order-1 flex flex-col gap-5 md:order-none">
                <h2 class="font-display type-t2-article text-balance text-fg md:type-t2 lg:type-t1" id="{{ id }}-title">{{ title }}</h2>
                {% if subtitle|default(null) %}<p class="hidden type-t4 text-fg-secondary md:block">{{ subtitle }}</p>{% endif %}
            </div>
            {% if aside|default(null) %}
                <div class="dark order-3 flex flex-col items-start gap-3 rounded-xl bg-surface p-5 md:order-none md:p-6">
                    <p class="type-t4 font-semibold text-fg">{{ aside.title }}</p>
                    <p class="type-t6 text-fg-secondary">{{ aside.text }}</p>
                    {% include 'website/components/_button.html.twig' with {label: aside.cta.label, href: aside.cta.href, attrs: aside.cta.attrs|default({}), variant: 'inverse', size: 'xl', arrow: true} only %}
                </div>
            {% endif %}
        </div>
        <ul class="order-2 flex flex-col gap-2 md:order-none lg:col-span-2">
            {% for item in items %}
                <li>
                    <details class="group rounded-lg border border-border-subtle bg-surface transition-colors duration-base open:border-surface-muted open:bg-surface-muted motion-reduce:transition-none" name="{{ id }}"{% if loop.first %} open{% endif %}>
                        <summary class="flex min-h-control-xl cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-5 py-4 type-t5 font-semibold text-fg focus-visible:shadow-focus md:px-6 md:py-5 md:type-t4 md:font-semibold">
                            {{ item.question }}
                            <span class="flex size-icon-lg shrink-0 items-center justify-center rounded-full border border-border-subtle bg-surface text-accent transition-transform duration-base group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">
                                {% include 'website/components/_icon.html.twig' with {name: 'plus', class: 'size-icon-sm'} only %}
                            </span>
                        </summary>
                        <p class="max-w-measure px-5 pb-5 type-t5 text-fg-secondary md:px-6">{{ item.answer }}</p>
                    </details>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
