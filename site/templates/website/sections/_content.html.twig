{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-white' %}
{% set section_id = id|default('vf-content') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = 'content' %}

{% block section_content %}
    <div class="mb-8 max-w-3xl">
        <h2 id="{{ labelled_by }}" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">{{ title }}</h2>
        <p class="mb-0 text-lg leading-7 text-slate-600">{{ text }}</p>
    </div>
    {% if cards|default([]) %}
        <div class="grid gap-6 md:grid-cols-2">
            {% for card in cards %}
                <div class="min-w-0">
                    {% include 'website/components/_card.html.twig' with card only %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
