{#
    Секция «Реквизиты компании».
    Аргументы: title, subtitle, items [{label, value}].
#}
<section class="bg-surface-muted py-16 md:py-24" aria-labelledby="about-requisites-title">
    <div class="mx-auto grid max-w-container grid-cols-1 gap-8 px-4 md:grid-cols-12 md:gap-12 md:px-8">
        <div class="md:col-span-4">
            <h2 id="about-requisites-title" class="font-display font-extrabold type-t2-article text-fg md:type-t2">{{ title }}</h2>
            <p class="mt-3 type-t4 text-fg-secondary">{{ subtitle }}</p>
        </div>
        <dl class="divide-y divide-border-subtle rounded-lg border border-border-subtle bg-surface md:col-span-8">
            {% for item in items %}
                <div class="grid grid-cols-1 gap-1 px-6 py-4 md:grid-cols-3 md:gap-6">
                    <dt class="type-t6 text-fg-muted">{{ item.label }}</dt>
                    <dd class="type-t5 tabular-nums text-fg md:col-span-2">{{ item.value }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>
</section>
