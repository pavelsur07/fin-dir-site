<section class="bg-surface-muted py-16 md:py-24" aria-labelledby="{{ id|default('home-trust-data-title') }}">
    <div class="mx-auto max-w-container px-4 md:px-8">
        <h2 id="{{ id|default('home-trust-data-title') }}" class="font-display font-extrabold type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <p class="mt-3 mb-12 max-w-measure type-t4 text-fg-secondary">{{ subtitle }}</p>
        <ol class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
            {% for card in cards %}
                <li class="flex flex-col gap-2 rounded-lg bg-surface p-6 shadow-sm">
                    <span class="type-t-mono-sm text-fg-muted" aria-hidden="true">{{ card.number }}</span>
                    <h3 class="type-h4 text-fg">{{ card.title }}</h3>
                    <p class="type-t6 text-fg-secondary">{{ card.text }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
