<section class="bg-surface-muted py-16 md:py-24" aria-labelledby="{{ id|default('home-trust-data-title') }}">
    <div class="mx-auto w-full max-w-container px-4 md:px-8">
        <h2 id="{{ id|default('home-trust-data-title') }}" class="font-display font-extrabold type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <p class="mt-3 mb-12 max-w-measure type-t4 text-fg-secondary">{{ subtitle }}</p>
        <ol class="grid w-full grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
            {% for card in cards %}
                <li class="flex flex-col gap-2 rounded-lg border border-navy-200 bg-white p-6 shadow-none transition-all duration-fast ease-out hover:border-navy-100 hover:shadow-sm motion-reduce:transition-none md:p-8">
                    <span class="mb-1 font-display text-t-code font-extrabold tabular-nums text-red-600" aria-hidden="true">{{ card.number }}</span>
                    <h3 class="font-display text-t3 font-bold tracking-tight text-navy-900">{{ card.title }}</h3>
                    <p class="font-sans text-t5 text-navy-600">{{ card.text }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
