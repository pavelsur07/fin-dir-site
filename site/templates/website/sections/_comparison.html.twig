{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-white' %}
{% set section_id = id|default('vf-comparison') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = 'comparison' %}

{% block section_content %}
    <div class="mb-8 max-w-3xl">
        {% if eyebrow|default(null) %}<p class="mb-4 text-xs leading-5 font-medium text-slate-600 uppercase">{{ eyebrow }}</p>{% endif %}
        <h2 id="{{ labelled_by }}" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">{{ title }}</h2>
        {% if text|default(null) %}<p class="mb-0 text-lg leading-7 text-slate-600">{{ text }}</p>{% endif %}
    </div>

    <div class="overflow-x-auto" data-vf-layout="comparison" role="region" aria-label="{{ table_label|default(title) }}" tabindex="0">
        <table class="min-w-96 w-full border-collapse text-left">
            <caption class="text-slate-600">{{ caption }}</caption>
            <thead>
                <tr>
                    <th class="border-b border-slate-500 p-3 align-top" scope="col">{{ criterion_label|default('Критерий') }}</th>
                    {% for alternative in alternatives %}<th class="border-b border-slate-500 p-3 align-top" scope="col">{{ alternative }}</th>{% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <th class="border-b border-slate-200 p-3 align-top" scope="row">{{ row.criterion }}</th>
                        {% for value in row.values %}<td class="border-b border-slate-200 p-3 align-top">{{ value }}</td>{% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
