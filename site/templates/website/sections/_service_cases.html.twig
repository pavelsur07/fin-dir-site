{#
    Кейсы на странице услуги: заголовок, кнопка «Все кейсы» справа и сетка карточек (components/_case_card).
    Аргументы: id, title, cases (CaseListItem[]), all_label, all_href, tone ('surface' | 'muted'; по умолчанию surface).
    Пустой список -- секция не выводится совсем. Обложки у кейса нет, поэтому карточка без изображения.
#}
{% if cases is not empty %}
    <section class="{{ tone|default('surface') == 'muted' ? 'bg-surface-muted' : 'bg-surface' }} py-16 md:py-24" id="{{ id }}" aria-labelledby="{{ id }}-title">
        <div class="mx-auto max-w-page px-4 md:px-8">
            <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <h2 class="type-t2-article text-fg md:type-t2" id="{{ id }}-title">{{ title }}</h2>
                {% include 'website/components/_button.html.twig' with {label: all_label, href: all_href, variant: 'outline', full_mobile: true} only %}
            </div>
            <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
                {% for case in cases %}
                    <li>{% include 'website/components/_case_card.html.twig' with {case: case} only %}</li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}
