{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-bg' %}
{% set section_id = 'foundations' %}
{% set labelled_by = 'foundations-title' %}
{% set section_name = 'foundations-showcase' %}

{% block section_content %}
    <div class="mb-8 max-w-content">
        <p class="text-t7 font-medium text-accent-text uppercase">Design system v2</p>
        <h2 id="foundations-title">Основа интерфейса</h2>
        <p class="mb-0 text-t4 text-fg-secondary">Inter, Manrope и семантические токены одинаковы на каждой публичной странице.</p>
    </div>

    <div class="grid gap-12" data-vf-showcase="typography">
        <div class="grid gap-4">
            <p class="mb-0 text-t7 text-fg-secondary">T1 · 36/44 mobile · 48/56 desktop</p>
            <p class="mb-0 text-t1 font-extrabold">Финансы без догадок</p>
            <p class="mb-0 text-t7 text-fg-secondary">T2 · 30/38 mobile · 36/44 desktop</p>
            <p class="mb-0 text-t2 font-extrabold">Понятная система управления</p>
            <p class="mb-0 text-t7 text-fg-secondary">T3 · 20/28</p>
            <p class="mb-0 text-t3 font-bold">Данные для решений</p>
            <p class="mb-0 text-t4">T4 — вводный текст страницы с увеличенным интерлиньяжем.</p>
            <p class="mb-0 text-t5">T5 — основной текст, в том числе русский алфавит и цифры 2 450 000 ₽.</p>
            <p class="mb-0 text-t6 text-fg-secondary">T6 — пояснения и элементы управления.</p>
            <p class="mb-0 text-t7 text-fg-secondary">T7 — короткая подпись.</p>
        </div>
        <div data-vf-showcase="colors">
            <h3>Роли цвета</h3>
            <div class="grid gap-6 md:grid-cols-2">
                <div class="rounded-lg border border-border bg-bg p-6" data-vf-color-context="light">
                    <p class="text-t7 font-semibold text-accent-text uppercase">Светлый контекст</p>
                    <h4 class="text-fg">Текст на поверхности</h4>
                    <p class="text-fg-secondary">Вторичный текст и разделение через границу.</p>
                    <div class="flex gap-2" aria-hidden="true"><span class="size-8 rounded-sm bg-accent"></span><span class="size-8 rounded-sm bg-accent-subtle"></span><span class="size-8 rounded-sm bg-bg-muted"></span><span class="size-8 rounded-sm bg-border"></span></div>
                </div>
                <div class="rounded-lg border border-border bg-bg p-6" data-vf-color-context="dark" data-theme="dark">
                    <p class="text-t7 font-semibold text-accent-text uppercase">Тёмный контекст</p>
                    <h4 class="text-fg">Текст на поверхности</h4>
                    <p class="text-fg-secondary">Те же роли, другой набор семантических значений.</p>
                    <div class="flex gap-2" aria-hidden="true"><span class="size-8 rounded-sm bg-accent"></span><span class="size-8 rounded-sm bg-accent-subtle"></span><span class="size-8 rounded-sm bg-bg-muted"></span><span class="size-8 rounded-sm bg-border"></span></div>
                </div>
            </div>
            <div class="mt-6 flex flex-wrap gap-3" data-vf-showcase="states">
                {% include 'website/components/_badge.html.twig' with {label: 'Успех', tone: 'success'} only %}
                {% include 'website/components/_badge.html.twig' with {label: 'Внимание', tone: 'warning'} only %}
                {% include 'website/components/_badge.html.twig' with {label: 'Ошибка', tone: 'error'} only %}
                {% include 'website/components/_badge.html.twig' with {label: 'Информация', tone: 'info'} only %}
            </div>
        </div>
        <div data-vf-showcase="spacing">
            <h3>Шаги расстояния</h3>
            <p class="text-fg-secondary">4 · 8 · 12 · 16 · 20 · 24 · 32 · 40 · 48 · 64 · 96 px</p>
            <div class="flex flex-wrap items-end gap-4" aria-hidden="true">
                <span class="h-4 w-1 rounded-xs bg-accent"></span><span class="h-4 w-2 rounded-xs bg-accent"></span><span class="h-4 w-3 rounded-xs bg-accent"></span><span class="h-4 w-4 rounded-xs bg-accent"></span><span class="h-4 w-5 rounded-xs bg-accent"></span><span class="h-4 w-6 rounded-xs bg-accent"></span><span class="h-4 w-8 rounded-xs bg-accent"></span><span class="h-4 w-10 rounded-xs bg-accent"></span><span class="h-4 w-12 rounded-xs bg-accent"></span><span class="h-4 w-16 rounded-xs bg-accent"></span><span class="h-4 w-24 rounded-xs bg-accent"></span>
            </div>
        </div>
    </div>
{% endblock %}
