{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-surface' %}
{% set section_id = 'foundations' %}
{% set labelled_by = 'foundations-title' %}
{% set section_name = 'foundations-showcase' %}

{% block section_content %}
    <div class="mb-8 max-w-content">
        <h2 id="foundations-title">Основы</h2>
        <p class="mb-0 text-lead text-muted">Typography, colors и spacing используют реальные design tokens.</p>
    </div>

    <div class="grid gap-8">
        <div class="border-t border-border-default py-6" id="typography" data-vf-showcase="typography">
            <h3>Typography</h3>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">H1 — 40/44 mobile, 56/60 desktop</p>
            <div class="mb-4 text-h1 font-bold">Финансы без догадок</div>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">H2</p>
            <div class="mb-4 text-h2 font-bold">Понятная система управления</div>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">H3</p>
            <div class="mb-4 text-h3 font-bold">Данные для решения</div>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">H4</p>
            <div class="mb-4 text-h4 font-bold">Единый источник правил</div>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">Lead</p>
            <p class="text-lead">Крупный вводный текст для краткого объяснения раздела.</p>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">Body</p>
            <p>Основной текст предназначен для чтения и использует шкалу 16/24.</p>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">Small</p>
            <p class="text-small">Дополнительное пояснение без потери читаемости.</p>
            <p class="text-caption font-medium tracking-caption text-muted uppercase">Caption</p>
            <p class="text-caption font-medium tracking-caption uppercase">Краткая подпись</p>
            <h4>Font weights</h4>
            <p class="font-normal">Regular 400</p>
            <p class="font-medium">Medium 500</p>
            <p class="mb-0 font-bold">Bold 700</p>
        </div>

        <div class="border-t border-border-default py-6" id="colors" data-vf-showcase="colors">
            <h3>Colors</h3>
            {% set color_groups = [
                {
                    key: 'brand',
                    label: 'Brand',
                    colors: [
                        {class: 'bg-brand-red', label: 'Brand Red', token: '--vf-color-primary', hex: '#B00020', role: 'Brand accent и action', usage: 'Primary CTA, важная ссылка, selected state'},
                        {class: 'bg-brand-red-hover', label: 'Brand Red Hover', token: '--vf-color-primary-hover', hex: '#8A0019', role: 'Hover state', usage: 'Hover primary action'},
                        {class: 'bg-brand-red-active', label: 'Brand Red Active', token: '--vf-color-primary-active', hex: '#6C0014', role: 'Pressed state', usage: 'Active primary action'},
                        {class: 'bg-brand-red-soft', label: 'Brand Red Soft', token: '--vf-color-primary-soft', hex: '#F7E6E9', role: 'Soft brand context', usage: 'Локальный selected/active context'},
                        {class: 'bg-focus', label: 'Focus', token: '--vf-color-focus', hex: '#005FCC', role: 'Functional focus', usage: 'Keyboard focus на light surface'},
                        {class: 'bg-on-primary', label: 'On Primary', token: '--vf-color-on-primary', hex: '#FFFFFF', role: 'Content on Brand Red', usage: 'Текст и focus поверх primary surface'},
                    ],
                },
                {
                    key: 'dark',
                    label: 'Dark',
                    colors: [
                        {class: 'bg-brand-dark', label: 'Brand Dark / Navy', token: '--vf-color-dark', hex: '#0B1020', role: 'Визуальный фундамент', usage: 'Dark surfaces и основной dark text'},
                        {class: 'bg-surface-dark', label: 'Dark Surface', token: '--vf-color-surface-dark', hex: '#1E2331', role: 'Neutral dark surface', usage: 'Dark Footer и локальный dark context'},
                        {class: 'bg-on-dark', label: 'Text on Dark', token: '--vf-color-text-on-dark', hex: '#FFFFFF', role: 'Primary text on dark', usage: 'Основной текст на Dark Surface'},
                        {class: 'bg-muted-on-dark', label: 'Muted on Dark', token: '--vf-color-muted-on-dark', hex: '#8E99AF', role: 'Secondary text on dark', usage: 'Вторичный текст на Dark Surface'},
                        {class: 'bg-focus-on-dark', label: 'Focus on Dark', token: '--vf-color-focus-on-dark', hex: '#FFFFFF', role: 'Focus indicator on dark', usage: 'Keyboard focus на Dark Surface'},
                    ],
                },
                {
                    key: 'neutral',
                    label: 'Neutral',
                    colors: [
                        {class: 'bg-page', label: 'Page Background', token: '--vf-color-background', hex: '#F5F6F8', role: 'Light page background', usage: 'Фон публичной страницы'},
                        {class: 'bg-surface', label: 'Surface', token: '--vf-color-surface', hex: '#FFFFFF', role: 'Light surface', usage: 'Section, Card и control surface'},
                        {class: 'bg-content', label: 'Primary Text', token: '--vf-color-text', hex: '#0B1020', role: 'Primary text on light', usage: 'Заголовки и основной текст'},
                        {class: 'bg-muted', label: 'Muted Text', token: '--vf-color-muted', hex: '#5C677D', role: 'Secondary text on light', usage: 'Пояснения и metadata'},
                        {class: 'bg-border-default', label: 'Border', token: '--vf-color-border', hex: '#D9DCE4', role: 'Decorative boundary', usage: 'Разделение поверхностей'},
                        {class: 'bg-border-strong', label: 'Strong Border', token: '--vf-color-border-strong', hex: '#767B85', role: 'Accessible control boundary', usage: 'Forms и interactive controls'},
                    ],
                },
                {
                    key: 'semantic',
                    label: 'Semantic',
                    colors: [
                        {class: 'bg-success', label: 'Success', token: '--vf-color-success', hex: '#146C43', role: 'Успешное состояние', usage: 'Успешно завершённая операция'},
                        {class: 'bg-success-soft', label: 'Success Soft', token: '--vf-color-success-soft', hex: '#E9F5EE', role: 'Success surface', usage: 'Фон success feedback'},
                        {class: 'bg-warning', label: 'Warning', token: '--vf-color-warning', hex: '#805B00', role: 'Предупреждение', usage: 'Ситуация требует внимания'},
                        {class: 'bg-warning-soft', label: 'Warning Soft', token: '--vf-color-warning-soft', hex: '#FFF3CD', role: 'Warning surface', usage: 'Фон warning feedback'},
                        {class: 'bg-danger', label: 'Danger', token: '--vf-color-danger', hex: '#B02A37', role: 'Ошибка или опасность', usage: 'Error и dangerous action'},
                        {class: 'bg-danger-soft', label: 'Danger Soft', token: '--vf-color-danger-soft', hex: '#F8D7DA', role: 'Danger surface', usage: 'Фон error feedback'},
                        {class: 'bg-info', label: 'Info', token: '--vf-color-info', hex: '#0B5CAD', role: 'Системная информация', usage: 'Нейтральное информационное состояние'},
                        {class: 'bg-info-soft', label: 'Info Soft', token: '--vf-color-info-soft', hex: '#E8F1FB', role: 'Info surface', usage: 'Фон information feedback'},
                    ],
                },
            ] %}

            <div class="grid gap-8">
                {% for group in color_groups %}
                    <div data-vf-color-group="{{ group.key }}">
                        <h4>{{ group.label }}</h4>
                        <div class="grid grid-auto-fit gap-6">
                            {% for color in group.colors %}
                                <div class="flex items-start gap-3" data-vf-color-token="{{ color.token }}">
                                    <span class="size-12 rounded-md border border-border-strong {{ color.class }}" aria-hidden="true"></span>
                                    <div class="grid min-w-0 flex-1 gap-1">
                                        <strong>{{ color.label }}</strong>
                                        <code class="text-content">{{ color.token }}</code>
                                        <span class="text-small">{{ color.hex }}</span>
                                        <p class="mb-0 text-small text-muted"><strong>Role:</strong> {{ color.role }}<br><strong>Usage:</strong> {{ color.usage }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-8 grid gap-8" data-vf-color-combinations>
                <div>
                    <h4>Primary CTA states</h4>
                    <div class="flex flex-wrap items-center gap-3">
                        {% for button in [
                            {state: 'default', label: 'Primary'},
                            {state: 'hover', label: 'Primary Hover'},
                            {state: 'active', label: 'Primary Active'},
                        ] %}
                            {% include 'website/components/_button.html.twig' with {label: button.label, state: button.state} only %}
                        {% endfor %}
                    </div>
                </div>

                <div>
                    <h4>Text and surfaces</h4>
                    <div class="grid grid-auto-fit gap-6">
                        <div class="rounded-md border border-border-default bg-surface p-6 text-content" data-vf-color-context="light">
                            <strong>Light Surface</strong>
                            <p>Text on Light</p>
                            <p class="mb-0 text-muted">Muted Text on Light</p>
                        </div>
                        <div class="rounded-md border border-surface-dark bg-surface-dark p-6 text-on-dark" data-vf-color-context="dark">
                            <strong>Dark Surface</strong>
                            <p>Text on Dark</p>
                            <p class="mb-0 text-muted-on-dark">Muted Text on Dark</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h4>Semantic states</h4>
                    <div class="grid gap-8">
                        {% include 'website/components/_alert.html.twig' with {title: 'Success', text: 'Операция завершена.', tone: 'success'} only %}
                        {% include 'website/components/_alert.html.twig' with {title: 'Warning', text: 'Требуется внимание.', tone: 'warning'} only %}
                        {% include 'website/components/_alert.html.twig' with {title: 'Danger', text: 'Обнаружена ошибка.', tone: 'danger'} only %}
                        {% include 'website/components/_alert.html.twig' with {title: 'Info', text: 'Системная информация.', tone: 'info'} only %}
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t border-border-default py-6" id="spacing" data-vf-showcase="spacing">
            <h3>Spacing</h3>
            <div class="grid gap-3">
                {% for space in [
                    {class: 'w-1', label: 4}, {class: 'w-2', label: 8}, {class: 'w-3', label: 12},
                    {class: 'w-4', label: 16}, {class: 'w-6', label: 24}, {class: 'w-8', label: 32},
                    {class: 'w-12', label: 48}, {class: 'w-16', label: 64},
                    {class: 'w-20', label: 80}, {class: 'w-24', label: 96},
                ] %}
                    <div class="flex items-center gap-3">
                        <span class="w-12 shrink-0">{{ space.label }}px</span>
                        <span class="h-4 min-w-1 rounded-sm bg-brand-red {{ space.class }}" aria-hidden="true"></span>
                    </div>
                {% endfor %}
            </div>
            <p class="mb-0 text-small text-muted">Card padding: 16/24px · Form gap: 16px · Grid gap: 24px · Section: 48/64/80px.</p>
        </div>
    </div>
{% endblock %}
