{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-white' %}
{% set section_id = id|default('vf-steps') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = marker|default('steps') %}

{% block section_content %}
    <div class="mb-8 max-w-3xl">
        {% if eyebrow|default(null) %}<p class="mb-4 text-xs leading-5 font-medium text-slate-600 uppercase">{{ eyebrow }}</p>{% endif %}
        <h2 id="{{ labelled_by }}" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">{{ title }}</h2>
        {% if text|default(null) %}<p class="mb-0 text-lg leading-7 text-slate-600">{{ text }}</p>{% endif %}
    </div>

    <ol class="grid max-w-3xl gap-6" role="list" data-vf-layout="steps">
        {% for step in steps %}
            <li class="flex gap-3">
                <span class="grid size-12 shrink-0 place-items-center rounded-md border border-slate-500 font-bold" data-vf-step-number>{{ loop.index }}</span>
                <div>
                    <h3 class="text-xl leading-7 font-bold">{{ step.title }}</h3>
                    <p class="mb-0 text-slate-600">{{ step.text }}</p>
                </div>
            </li>
        {% endfor %}
    </ol>
{% endblock %}
