{#
    Секция «Кейсы»: карточки с задачей, решением и результатом.
    Аргументы: title, subtitle, cases [{industry, problem, action, result}], note (необязательно, пометка под сеткой).
#}
<section class="bg-surface-muted py-16 md:py-24" aria-labelledby="home-cases-title">
    <div class="mx-auto max-w-container px-4 md:px-8">
        <h2 id="home-cases-title" class="type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <p class="mt-3 mb-12 max-w-measure type-t4 text-fg-secondary">{{ subtitle }}</p>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
            {% for case in cases %}
                <li class="flex flex-col gap-4 rounded-lg bg-surface p-6 shadow-sm">
                    <p class="type-t-mono-sm text-fg-muted">{{ case.industry }}</p>
                    <dl class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1">
                            <dt class="type-t6 font-semibold text-fg">Была проблема</dt>
                            <dd class="type-t6 text-fg-secondary">{{ case.problem }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="type-t6 font-semibold text-fg">Что сделали</dt>
                            <dd class="type-t6 text-fg-secondary">{{ case.action }}</dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="type-t6 font-semibold text-fg">Что увидел собственник</dt>
                            <dd class="type-t6 text-fg-secondary">{{ case.result }}</dd>
                        </div>
                    </dl>
                </li>
            {% endfor %}
        </ul>
        {% if note|default(null) %}<p class="mt-8 type-t7 text-fg-muted">{{ note }}</p>{% endif %}
    </div>
</section>
