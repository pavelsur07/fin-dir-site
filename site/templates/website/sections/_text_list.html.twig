{% extends 'website/sections/_base.html.twig' %}
{% set section_class = 'bg-bg' %}
{% set section_id = id|default('vf-text-list') %}
{% set labelled_by = section_id ~ '-title' %}
{% set section_name = marker|default('text-list') %}

{% block section_content %}
    <div class="mb-8 max-w-content">
        {% if eyebrow|default(null) %}<p class="mb-4 text-t7 font-medium text-fg-secondary uppercase">{{ eyebrow }}</p>{% endif %}
        {% if is_page_title|default(false) %}<h1 id="{{ labelled_by }}">{{ title }}</h1>{% else %}<h2 id="{{ labelled_by }}">{{ title }}</h2>{% endif %}
        {% if text|default(null) %}<p class="mb-0 text-t4 text-fg-secondary">{{ text }}</p>{% endif %}
    </div>

    {% if items|default([]) %}
        <ul class="grid max-w-content gap-3" role="list" data-vf-layout="text-list">
            {% for item in items %}
                <li class="border-t border-border pt-4">
                    {% if item.title|default(null) %}<h3 class="text-t3">{{ item.title }}</h3>{% endif %}
                    <p class="mb-0">{{ item.text }}</p>
                    {% if item.href|default(null) %}<a href="{{ item.href }}">{{ item.link_label|default('Подробнее') }}</a>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
