{#
    Полоса доверия под первым экраном, без заголовка.
    Аргументы: people [{name, photo, photo_webp}] -- фото команды для аватаров, team {text, link_label, href}.
    cards (необязательно) -- три карточки главной (глобал vf_trust_cards): industries {title, items}, ai {badge, title_sr_prefix, title, text},
    team {title, text, link_label}; team.href берётся из аргумента team. Без cards -- строка facts [{value, value_suffix?, text, note?}] и команда.
    Пробелы внутри чисел и единиц -- неразрывные (U+00A0).
#}
{% if cards|default(null) %}
<section class="bg-surface" aria-label="Почему нам можно доверять" data-vf-section="trust-strip">
    <div class="website-container pt-6">
        <ul class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-3">
            <li class="flex flex-col items-start gap-4 rounded-lg border border-border-subtle bg-surface p-5 md:col-span-2 md:p-6 lg:col-span-1" data-vf-trust-card="industries">
                <h2 class="type-t4 font-bold text-fg">{{ cards.industries.title }}</h2>
                <ul class="flex flex-wrap gap-2" aria-label="Отрасли">
                    {% for item in cards.industries.items %}
                        <li class="inline-flex min-h-control-sm items-center rounded-full border border-border-subtle bg-surface-muted px-3 type-t6 text-fg-secondary">{{ item }}</li>
                    {% endfor %}
                </ul>
            </li>
            <li class="dark relative isolate flex flex-col items-start gap-4 overflow-hidden rounded-lg bg-accent-fill p-5 text-white md:p-6" data-vf-trust-card="ai">
                <div class="absolute -top-1/5 -bottom-1/5 left-7/10 w-2/5 -skew-x-12 bg-white/10" aria-hidden="true"></div>
                <span class="inline-flex h-control-md items-center gap-1 rounded-md bg-white px-3 type-t4 font-extrabold text-cobalt-600" aria-hidden="true">
                    {% include 'website/components/_icon.html.twig' with {name: 'sparkle', class: 'size-icon-md'} only %}
                    {{ cards.ai.badge }}
                </span>
                <h2 class="type-t3 text-white"><span class="sr-only">{{ cards.ai.title_sr_prefix }}</span>{{ cards.ai.title }}</h2>
                <p class="type-t6 text-cobalt-100">{{ cards.ai.text }}</p>
            </li>
            <li class="flex flex-col items-start gap-4 rounded-lg border border-border-subtle bg-surface p-5 md:p-6" data-vf-trust-card="team">
                <h2 class="type-t4 font-bold text-fg">{{ cards.team.title }}</h2>
                <span class="flex" aria-hidden="true">
                    {% for person in people %}
                        <span class="size-control-lg overflow-hidden rounded-full border-2 border-surface bg-surface-muted not-first:-ml-2">
                            {% include 'website/components/_portrait.html.twig' with {
                                src: person.photo,
                                webp_base: person.photo_webp|default(null),
                                alt: '',
                                class: 'size-full object-cover object-top',
                                sizes: '48px',
                            } only %}
                        </span>
                    {% endfor %}
                </span>
                <p class="type-t6 text-fg-secondary">{{ cards.team.text }}</p>
                <a class="mt-auto inline-flex min-h-control-touch items-center rounded-xs type-t6 font-semibold text-accent no-underline hover:underline focus-visible:shadow-focus" href="{{ team.href }}">{{ cards.team.link_label }}</a>
            </li>
        </ul>
    </div>
</section>
{% else %}
<section class="bg-surface" aria-label="Почему нам можно доверять" data-vf-section="trust-strip">
    <div class="website-container pt-8 md:pt-10">
        <ul class="grid grid-cols-1{{ facts is not empty ? ' md:grid-cols-3' : '' }}">
            {% for fact in facts %}
                <li class="flex flex-col items-start gap-2 border-border-subtle pb-4 not-first:border-t not-first:pt-4 md:px-5 md:py-1 md:not-first:border-t-0 md:not-first:border-l md:not-first:pt-1 md:first:pl-0 lg:px-8">
                    <strong class="type-t-code text-fg lg:type-t8">{{ fact.value }}{% if fact.value_suffix|default(null) %} {{ fact.value_suffix }}{% endif %}</strong>
                    <span class="type-t6 text-fg-secondary">{{ fact.text }}</span>
                    {% if fact.note|default(null) %}<span class="type-t7 text-fg-muted">{{ fact.note }}</span>{% endif %}
                </li>
            {% endfor %}
            <li class="flex flex-col items-start gap-2{{ facts is not empty ? ' border-t border-border-subtle pt-4 md:border-t-0 md:border-l md:px-5 md:py-1 lg:px-8' : '' }}">
                <span class="flex" aria-hidden="true">
                    {% for person in people %}
                        <span class="size-control-touch overflow-hidden rounded-full border-2 border-surface bg-surface-muted not-first:-ml-3">
                            {% include 'website/components/_portrait.html.twig' with {
                                src: person.photo,
                                webp_base: person.photo_webp|default(null),
                                alt: '',
                                class: 'size-full object-cover object-top',
                                sizes: '44px',
                            } only %}
                        </span>
                    {% endfor %}
                </span>
                <span class="type-t6 text-fg-secondary">{{ team.text }} <a class="rounded-xs font-semibold text-accent no-underline hover:underline focus-visible:shadow-focus" href="{{ team.href }}">{{ team.link_label }}</a></span>
            </li>
        </ul>
    </div>
</section>
{% endif %}
