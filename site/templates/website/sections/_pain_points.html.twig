<section class="bg-surface py-16 md:py-24" aria-labelledby="home-pain-points-title">
    <div class="mx-auto max-w-container px-4 md:px-8">
        <h2 id="home-pain-points-title" class="font-display font-extrabold max-w-measure type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <p class="mt-3 mb-12 type-t4 text-fg-secondary">{{ subtitle }}</p>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-4">
            {% for point in points %}
                <li class="flex flex-col gap-4 rounded-lg bg-surface-muted p-6">
                    {% include 'website/components/_icon.html.twig' with {
                        name: point.icon,
                        class: 'size-icon-lg text-fg-secondary',
                    } only %}
                    <p class="type-t5 text-fg">{{ point.text }}</p>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
