{#
    Секция с карточками для страниц услуг.
    Аргументы: id, title, subtitle (необязательно), cards [{title, text, icon (необязательно), label (необязательно)}],
    columns (2 | 3 | 4; по умолчанию 3), tone ('surface' | 'muted'; по умолчанию surface), note (необязательно).
    Карточка контрастна фону секции: на surface -- bg-surface-muted, на muted -- bg-surface.
#}
{% set muted = tone|default('surface') == 'muted' %}
{% set grid = {2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4'}[columns|default(3)] %}
<section class="{{ muted ? 'bg-surface-muted' : 'bg-surface' }} py-16 md:py-24" id="{{ id }}" aria-labelledby="{{ id }}-title">
    <div class="mx-auto max-w-page px-4 md:px-8">
        <h2 class="type-t2-article text-fg md:type-t2" id="{{ id }}-title">{{ title }}</h2>
        {% if subtitle|default(null) %}<p class="mt-3 max-w-measure type-t4 text-fg-secondary">{{ subtitle }}</p>{% endif %}
        <ul class="mt-12 grid grid-cols-1 gap-4 md:gap-6 {{ grid }}">
            {% for card in cards %}
                <li class="flex flex-col gap-3 rounded-lg p-6 {{ muted ? 'bg-surface shadow-sm' : 'bg-surface-muted' }}">
                    {% if card.icon|default(null) %}
                        {% include 'website/components/_icon.html.twig' with {name: card.icon, class: 'size-icon-lg text-accent'} only %}
                    {% endif %}
                    {% if card.label|default(null) %}<p class="type-t-mono-sm text-fg-muted">{{ card.label }}</p>{% endif %}
                    <h3 class="type-h4 text-fg">{{ card.title }}</h3>
                    <p class="type-t6 text-fg-secondary">{{ card.text }}</p>
                </li>
            {% endfor %}
        </ul>
        {% if note|default(null) %}<p class="mt-8 max-w-measure type-t6 text-fg-secondary">{{ note }}</p>{% endif %}
    </div>
</section>
