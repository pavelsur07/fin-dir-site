{% if previous or next %}<nav class="flex flex-wrap justify-between gap-4 border-t border-border-subtle pt-6" aria-label="Последовательность инструкций">{% if previous %}<a class="text-accent underline focus-visible:shadow-focus" rel="prev" href="{{ doc_url('docs_page', previous.slug) }}">Назад: {{ previous.title }}</a>{% endif %}{% if next %}<a class="text-accent underline focus-visible:shadow-focus" rel="next" href="{{ doc_url('docs_page', next.slug) }}">Далее: {{ next.title }}</a>{% endif %}</nav>{% endif %}
