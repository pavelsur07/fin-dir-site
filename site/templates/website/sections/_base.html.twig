{% set section_class = section_class|default('') %}
{% set section_id = section_id|default(null) %}
{% set labelled_by = labelled_by|default(null) %}
{% set section_name = section_name|default('base') %}
<section class="py-12 md:py-16 lg:py-20 {{ section_class }}"{% if section_id %} id="{{ section_id }}"{% endif %}{% if labelled_by %} aria-labelledby="{{ labelled_by }}"{% endif %} data-vf-section="{{ section_name }}">
    <div class="mx-auto w-full max-w-site px-4 md:px-6">
        {% block section_content %}{% endblock %}
    </div>
</section>
