{% set section_class = section_class|default('') %}
{% set section_id = section_id|default(null) %}
{% set labelled_by = labelled_by|default(null) %}
{% set section_name = section_name|default('base') %}
{% set section_tag = catalog_embed|default(false) ? 'div' : 'section' %}
<{{ section_tag }} class="{{ catalog_embed|default(false) ? '' : 'py-12 md:py-16 lg:py-20' }} {{ section_class }}"{% if section_id and not catalog_embed|default(false) %} id="{{ section_id }}"{% endif %}{% if labelled_by and not catalog_embed|default(false) %} aria-labelledby="{{ labelled_by }}"{% endif %} data-vf-section="{{ section_name }}"{% if theme|default(null) %} data-theme="{{ theme }}"{% endif %}>
    {% if not catalog_embed|default(false) %}<div class="vf-container">{% endif %}
        {% block section_content %}{% endblock %}
    {% if not catalog_embed|default(false) %}</div>{% endif %}
</{{ section_tag }}>
