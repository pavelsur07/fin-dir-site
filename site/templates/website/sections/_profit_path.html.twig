<section class="bg-surface py-16 md:py-24" aria-labelledby="home-profit-path-title">
    <div class="mx-auto max-w-container px-4 md:px-8">
        <h2 id="home-profit-path-title" class="type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <p class="mt-3 mb-12 max-w-measure type-t4 text-fg-secondary">{{ subtitle }}</p>
        <ol class="border-t border-border-subtle">
            {% for step in steps %}
                <li class="grid grid-cols-1 gap-3 border-b border-border-subtle py-6 lg:grid-cols-12 lg:items-center lg:gap-6">
                    <span class="type-t-mono-sm text-fg-muted lg:col-span-1" aria-hidden="true">{{ step.number }}</span>
                    <h3 class="type-t3 text-fg lg:col-span-4">{{ step.title }}</h3>
                    <p class="type-t6 text-fg-secondary lg:col-span-4">{{ step.text }}</p>
                    <span class="inline-flex w-fit whitespace-nowrap rounded-xs bg-surface-muted px-2 py-1 type-t7 font-medium text-fg-secondary lg:col-span-3 lg:justify-self-end">{{ step.label }}</span>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
