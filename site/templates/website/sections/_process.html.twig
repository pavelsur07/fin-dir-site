{# Необязательный id: заголовок и якорь секции (по умолчанию home-process-title, якоря нет). #}
{% set title_id = id|default(null) ? id ~ '-title' : 'home-process-title' %}
<section class="bg-surface py-16 md:py-24"{% if id|default(null) %} id="{{ id }}"{% endif %} aria-labelledby="{{ title_id }}">
    <div class="mx-auto w-full max-w-container px-4 md:px-8">
        <h2 id="{{ title_id }}" class="font-display font-extrabold mb-12 type-t2-article text-fg md:type-t2">{{ title }}</h2>
        <ol class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 xl:gap-8">
            {% for step in steps %}
                <li class="flex flex-col gap-2 rounded-lg border border-navy-200 bg-white p-6 shadow-none transition-all duration-fast ease-out hover:border-navy-100 hover:shadow-sm motion-reduce:transition-none md:p-8">
                    <span class="mb-1 font-display text-t-code font-extrabold tabular-nums text-red-600" aria-hidden="true">{{ step.number }}</span>
                    <h3 class="font-display text-t3 font-bold tracking-tight text-navy-900">{{ step.title }}</h3>
                    <p class="font-sans text-t5 text-navy-600">{{ step.text }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
