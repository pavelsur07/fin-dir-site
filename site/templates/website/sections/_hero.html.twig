{# TODO(hero_proof_date): подставить дату актуальности показателя «230+ компаний»; пока null — подпись выводится без даты. #}
{% set hero_proof_date = null %}
{# Показатели доверия Hero: число и единица разделены неразрывным пробелом (U+00A0). #}
{% set hero_proof = [
    {value: 'с 2015', unit: 'года', text: 'помогаем собственникам выстраивать финансовое управление'},
    {value: '230+', unit: 'компаний', text: 'прошли через нас', dated: true},
    {value: 'до 8', unit: 'числа', text: 'закрываем месяц и показываем цифры собственнику'},
    {value: '15', unit: 'отраслей', text: 'где уже работает наша система финансового управления'},
] %}
<section class="overflow-hidden border-b border-border-subtle bg-surface-muted text-fg" aria-labelledby="home-hero-title">
    <div class="mx-auto grid w-full max-w-container items-center gap-8 px-3 py-10 md:px-8 lg:grid-cols-2 lg:gap-16 lg:py-16">
        <div class="relative z-10">
            <h1 class="type-t2-article text-balance text-fg md:type-t2 xl:type-t1" id="home-hero-title">Увеличиваем прибыль через систему в финансах</h1>
            <p class="mt-6 max-w-lead type-t4 text-fg-secondary">Строим систему финансового управления с предсказуемым результатом для компаний с оборотом от 2 млн до 1,5 млрд ₽ по всей России.</p>
            <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-2">
                {% for item in hero_proof %}
                    <div>
                        <dt class="type-t8 tabular-nums text-fg">{{ item.value }} <span class="text-accent">{{ item.unit }}</span></dt>
                        <dd class="mt-1 type-t6 text-fg-secondary">{{ item.text }}{% if item.dated|default(false) and hero_proof_date %}, данные на {{ hero_proof_date }}{% endif %}</dd>
                    </div>
                {% endfor %}
            </dl>
        </div>

        <div class="relative mx-auto mt-10 aspect-square w-full max-w-lead lg:mt-0">
            <div class="absolute inset-0 rounded-full bg-ink-100"></div>
            <svg class="pointer-events-none absolute -inset-14/100 size-128/100 fill-none" viewBox="0 0 100 100" aria-hidden="true">
                <circle class="stroke-ink-200" cx="50" cy="50" r="49.5" stroke-width=".25"/>
                <circle class="stroke-ink-100" cx="50" cy="50" r="44" stroke-width=".25"/>
            </svg>
            {# Внутренний круг (inset 7 %) обрезает фото: то же, что clip-path: circle(43 %) на всём контейнере. Обёртка -inset-7/86 возвращает координаты контейнера для bottom 7 % и height 88 %. #}
            <div class="absolute inset-7/100 overflow-hidden rounded-full bg-ink-200">
                <div class="absolute -inset-7/86">
                    <picture>
                        <source srcset="/assets/people/pavel-novikov-800.avif" type="image/avif" width="800" height="1000">
                        <source srcset="/assets/people/pavel-novikov-800.webp" type="image/webp" width="800" height="1000">
                        <img class="absolute bottom-7/100 left-1/2 h-88/100 w-auto max-w-none -translate-x-1/2" src="/assets/people/pavel-novikov.png" alt="Павел Новиков, управляющий партнёр" width="1122" height="1402" fetchpriority="high">
                    </picture>
                </div>
            </div>
            <div class="absolute -bottom-2 left-0 rounded-md bg-navy-900 px-4 py-3 text-white">
                <p class="type-h4">Павел Новиков</p>
                <p class="type-t6 text-ink-200">Управляющий партнёр</p>
            </div>
        </div>
    </div>
</section>
