{#
    Первый экран главной. Показатели доверия вынесены в sections/_trust_strip.
    Аргументы: chips [строки], lead, note, primary {label, href}, secondary {label, href}, badge {title, text}.
#}
<section class="overflow-hidden bg-surface text-fg" aria-labelledby="home-hero-title" data-vf-section="hero">
    <div class="mx-auto grid w-full max-w-container items-center gap-10 px-4 pt-8 pb-12 md:px-8 lg:grid-cols-2 lg:gap-12 lg:py-16">
        <div class="relative z-10 flex min-w-0 flex-col gap-6">
            {% if chips|default([]) is not empty %}
                <ul class="flex flex-wrap gap-2">
                    {% for chip in chips %}
                        <li class="rounded-full bg-surface-muted px-3 py-1 type-t7 font-semibold text-fg-secondary">{{ chip }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            <h1 class="font-display text-balance type-t2 text-fg md:type-t1" id="home-hero-title"><span class="xl:whitespace-nowrap">Финансовый директор,</span> который помогает зарабатывать <span class="text-accent">больше</span></h1>
            <p class="max-w-lead type-t4 text-fg-secondary">{{ lead }}</p>
            <div class="flex flex-col gap-3 md:flex-row md:flex-wrap">
                {% include 'website/components/_button.html.twig' with {label: primary.label, href: primary.href, variant: 'primary', full_mobile: true} only %}
                {% if secondary|default(null) %}
                    {% include 'website/components/_button.html.twig' with {label: secondary.label, href: secondary.href, variant: 'secondary', full_mobile: true} only %}
                {% endif %}
            </div>
            {% if note|default(null) %}<p class="max-w-lead type-t6 text-fg-muted">{{ note }}</p>{% endif %}
        </div>

        {# Фото на синей панели с наклонными полосами: полосы декоративные, aria-hidden. #}
        <div class="relative isolate mx-auto aspect-square w-full max-w-lead overflow-hidden rounded-xl bg-cobalt-100 lg:max-w-none">
            <div class="absolute inset-y-0 left-1/4 w-1/4 -skew-x-12 bg-cobalt-200" aria-hidden="true"></div>
            <div class="absolute inset-y-0 left-1/2 w-1/6 -skew-x-12 bg-cobalt-50" aria-hidden="true"></div>
            <picture>
                <source srcset="/assets/people/pavel-novikov-800.avif" type="image/avif" width="800" height="1000">
                <source srcset="/assets/people/pavel-novikov-800.webp" type="image/webp" width="800" height="1000">
                <img class="absolute bottom-0 left-3/5 h-11/12 w-auto max-w-none -translate-x-1/2" src="/assets/people/pavel-novikov.png" alt="Павел Новиков, управляющий партнёр" width="1122" height="1402" fetchpriority="high">
            </picture>
            {% if badge|default(null) %}
                <p class="absolute top-4 left-4 flex max-w-1/2 flex-col gap-1 rounded-lg bg-surface p-4 shadow-md md:top-6 md:left-6">
                    <span class="type-t7 font-semibold text-accent">{{ badge.title }}</span>
                    <span class="type-t6 font-semibold text-fg">{{ badge.text }}</span>
                </p>
            {% endif %}
        </div>
    </div>
</section>
