{#
    Список вкладок для секций с переключением (sections/_services_tabs, sections/_advantages).
    Аргументы: id -- префикс id секции, label -- подпись для скринридера, tabs [{short, kicker, title}].
    На мобильном -- сегменты с коротким названием (3 в ряд или 2×2), с lg -- карточки с заголовком.
    Без JS список скрыт (hidden) и видны все панели подряд; scripts/website/tabs.js показывает список и переключает панели.
#}
{% set columns = {2: 'grid-cols-2', 3: 'grid-cols-3', 4: 'grid-cols-2'}[tabs|length]|default('grid-cols-2') %}
<div class="grid {{ columns }} gap-1 rounded-lg bg-surface-muted p-1 lg:flex lg:flex-col lg:gap-3 lg:bg-transparent lg:p-0" role="tablist" aria-label="{{ label }}" hidden data-vf-tablist>
    {% for tab in tabs %}
        <button class="flex min-h-control-lg items-center justify-center rounded-md px-2 type-t6 font-semibold text-fg-secondary transition-colors duration-fast motion-reduce:transition-none focus-visible:shadow-focus aria-selected:bg-surface aria-selected:text-accent aria-selected:shadow-sm lg:flex-col lg:items-start lg:justify-start lg:gap-2 lg:rounded-lg lg:border-2 lg:border-transparent lg:bg-surface-muted lg:p-6 lg:text-left lg:text-fg lg:aria-selected:border-accent lg:aria-selected:bg-surface lg:aria-selected:shadow-none" type="button" role="tab" id="{{ id }}-tab-{{ loop.index }}" aria-controls="{{ id }}-panel-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}">
            <span class="lg:hidden">{{ tab.short }}</span>
            <span class="hidden type-t7 font-semibold text-fg-muted lg:block">{{ tab.kicker }}</span>
            <span class="hidden type-t3 lg:block">{{ tab.title }}</span>
        </button>
    {% endfor %}
</div>
