<nav aria-label="Хлебные крошки" data-vf-component="breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-small">
        {% for item in items %}
            <li class="flex items-center gap-2{% if loop.last %} text-muted{% endif %}"{% if loop.last %} aria-current="page"{% endif %}>
                {% if not loop.first %}<span class="text-muted" aria-hidden="true">/</span>{% endif %}
                {% if loop.last %}{{ item.label }}{% else %}<a href="{{ item.href }}">{{ item.label }}</a>{% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>
