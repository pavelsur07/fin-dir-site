{# Немодальное уведомление: landmark region с подписью по заголовку, фокус не перехватывает.
   sticky, а не fixed: баннер последний в body, прилипает к низу экрана и при этом занимает
   место в потоке -- в конце страницы встаёт под футер и не закрывает его (WCAG 2.4.11). #}
<div id="cookieNotice" class="pointer-events-none sticky bottom-0 z-50 opacity-0 translate-y-4 transition-all duration-base data-visible:opacity-100 data-visible:translate-y-0" role="region" aria-labelledby="cookieTitle" hidden data-vf-component="cookie">
    <div class="dark pointer-events-auto w-full border-t border-border bg-surface text-fg">
        <div class="mx-auto w-full max-w-page px-4 py-4 md:px-6">
            <div class="grid gap-4 md:flex md:items-center md:justify-between md:gap-6">
                <div class="min-w-0">
                    <h2 id="cookieTitle" class="mb-2 type-t3">На сайте используются файлы cookie</h2>
                    <p id="cookieText" class="mb-0 type-t6 text-fg-secondary">Мы используем cookie и Яндекс Метрику, включая Вебвизор, чтобы сайт работал корректно, для аналитики и оценки рекламы. Продолжая пользоваться сайтом, вы соглашаетесь с <a class="text-accent hover:text-accent-fill-hover" href="{{ privacy_href }}">политикой конфиденциальности</a>. Подробнее — в <a class="text-accent hover:text-accent-fill-hover" href="{{ privacy_href }}#privacy-cookies">разделе о cookie</a>.</p>
                </div>
                <div class="flex w-full gap-3 md:w-auto md:shrink-0">
                    {% include 'website/components/_button.html.twig' with {label: 'Принять', id: 'cookieAccept', class: 'flex-1 md:flex-none'} only %}
                    {% include 'website/components/_button.html.twig' with {label: 'Закрыть', variant: 'outline', id: 'cookieClose', aria_label: 'Закрыть уведомление о cookie', class: 'flex-1 md:flex-none'} only %}
                </div>
            </div>
        </div>
    </div>
</div>
