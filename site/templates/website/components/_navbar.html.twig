{% set navigation_id = navigation_id|default('vf-main-navigation') %}
{% set drawer_id = navigation_id ~ '-drawer' %}
{% set navigation_label = navigation_label|default('Основная навигация') %}
{% set mobile_navigation_label = mobile_navigation_label|default('Мобильная навигация') %}
{% set dialog_label = dialog_label|default('Меню') %}
{% set brand_aria_label = brand_aria_label|default(brand ~ ' — на главную') %}
{# Липкая шапка по дизайн-системе: высота 64, тень sm после начала прокрутки (data-scrolled ставит navigation.js). #}
<header class="sticky top-0 z-40 border-b border-border-subtle bg-white transition-shadow duration-base data-scrolled:shadow-sm print:static" data-vf-component="navbar">
    <nav class="mx-auto w-full max-w-container px-4 md:px-8 flex h-16 flex-nowrap items-center justify-between gap-4" aria-label="{{ navigation_label }}">
        <a class="inline-flex shrink-0 items-center no-underline" href="{{ brand_href }}" aria-label="{{ brand_aria_label }}"><img src="/assets/brand/logo-light.png" alt="" width="148" height="50"></a>
        <button class="flex size-control-touch shrink-0 items-center justify-center rounded-md border border-border-strong bg-white p-0 text-fg focus-visible:shadow-focus lg:hidden" type="button" aria-label="Открыть меню" aria-haspopup="dialog" aria-controls="{{ drawer_id }}" aria-expanded="false" data-vf-menu-open>
            <span class="grid gap-1" aria-hidden="true"><span class="w-6 border-t-2 border-current"></span><span class="w-6 border-t-2 border-current"></span><span class="w-6 border-t-2 border-current"></span></span>
        </button>
        <div class="ml-auto hidden lg:flex lg:items-center lg:gap-6" data-vf-desktop-navigation>
            <ul class="flex items-center gap-6">
                {% for item in items %}
                    <li>
                        <a class="block py-2 font-medium no-underline hover:text-accent-fill-hover focus:text-accent{% if (item.key|default(null) == active_key and active_key is not empty) %} text-accent{% else %} text-fg{% endif %}" href="{{ item.href }}"{% if (item.key|default(null) == active_key and active_key is not empty) %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    </li>
                {% endfor %}
            </ul>
            {% if cta|default(null) %}
                {% include 'website/components/_button.html.twig' with {label: cta.label, href: cta.href, variant: 'outline', class: 'ml-2'} only %}
            {% endif %}
        </div>
    </nav>

    <dialog class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-hidden border-0 bg-transparent p-0 text-fg backdrop:bg-overlay lg:hidden" id="{{ drawer_id }}" aria-label="{{ dialog_label }}" data-state="closed" data-vf-menu-dialog>
        <div class="absolute inset-y-0 right-0 flex h-dvh w-full translate-x-full flex-col overflow-y-auto overscroll-contain bg-white shadow-md transition-transform duration-base motion-reduce:transition-none" data-vf-menu-panel>
            <div class="flex h-16 shrink-0 items-center justify-between gap-4 border-b border-border-subtle px-4">
                <a class="inline-flex items-center no-underline" href="{{ brand_href }}" aria-label="{{ brand_aria_label }}"><img src="/assets/brand/logo-light.png" alt="" width="148" height="50"></a>
                <button class="flex size-control-touch shrink-0 items-center justify-center rounded-md border border-border-strong bg-white p-0 text-fg focus-visible:shadow-focus" type="button" aria-label="Закрыть меню" data-vf-menu-close>
                    <span class="type-t3" aria-hidden="true">×</span>
                </button>
            </div>
            <nav class="px-4 py-4" aria-label="{{ mobile_navigation_label }}" data-vf-mobile-navigation>
                <ul class="flex flex-col gap-2">
                    {% for item in items %}
                        <li>
                            <a class="flex min-h-control-touch items-center py-2 text-left font-medium no-underline hover:text-accent-fill-hover focus:text-accent{% if (item.key|default(null) == active_key and active_key is not empty) %} text-accent{% else %} text-fg{% endif %}" href="{{ item.href }}"{% if (item.key|default(null) == active_key and active_key is not empty) %} aria-current="page"{% endif %}>{{ item.label }}</a>
                        </li>
                    {% endfor %}
                </ul>
                {% if cta|default(null) %}
                    <div class="mt-6">
                        {% include 'website/components/_button.html.twig' with {label: cta.label, href: cta.href, variant: 'outline', full_mobile: true} only %}
                    </div>
                {% endif %}
            </nav>
        </div>
    </dialog>
</header>
