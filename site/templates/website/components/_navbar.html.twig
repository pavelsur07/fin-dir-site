{% set navigation_id = navigation_id|default('vf-main-navigation') %}
{% set drawer_id = navigation_id ~ '-drawer' %}
<header class="border-b border-border bg-bg" data-vf-component="navbar">
    <nav class="vf-container flex h-16 flex-nowrap items-center justify-between gap-4" aria-label="Основная навигация">
        <a class="inline-flex shrink-0 items-center no-underline" href="{{ brand_href }}" aria-label="{{ brand }} — на главную"><img src="/assets/brand/logo-light.png" alt="" width="148" height="50"></a>
        <button class="flex size-control shrink-0 items-center justify-center rounded-md border border-border-strong bg-bg p-0 text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus lg:hidden" type="button" aria-label="Открыть меню" aria-haspopup="dialog" aria-controls="{{ drawer_id }}" aria-expanded="false" data-vf-menu-open>
            <span class="grid gap-1" aria-hidden="true"><span class="w-6 border-t-2 border-current"></span><span class="w-6 border-t-2 border-current"></span><span class="w-6 border-t-2 border-current"></span></span>
        </button>
        <div class="ml-auto hidden lg:flex lg:items-center lg:gap-6" data-vf-desktop-navigation>
            <ul class="flex items-center gap-6">
                {% for item in items %}
                    <li>
                        <a class="block py-2 font-medium no-underline hover:text-accent focus:text-accent{% if item.active|default(false) %} text-accent{% else %} text-fg{% endif %}" href="{{ item.href }}"{% if item.active|default(false) %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    </li>
                {% endfor %}
            </ul>
            {% if cta|default(null) %}
                {% include 'website/components/_button.html.twig' with {label: cta.label, href: cta.href, variant: 'primary', class: 'ml-2'} only %}
            {% endif %}
        </div>
    </nav>

    <dialog class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-hidden border-0 bg-transparent p-0 text-fg lg:hidden" id="{{ drawer_id }}" aria-label="Меню" data-state="closed" data-vf-menu-dialog>
        <div class="navigation-drawer-width absolute inset-y-0 right-0 flex h-dvh flex-col overflow-y-auto overscroll-contain bg-bg shadow-md" data-vf-menu-panel>
            <div class="flex h-16 shrink-0 items-center justify-between gap-4 border-b border-border px-4">
                <a class="inline-flex items-center no-underline" href="{{ brand_href }}" aria-label="{{ brand }} — на главную"><img src="/assets/brand/logo-light.png" alt="" width="148" height="50"></a>
                <button class="flex size-control shrink-0 items-center justify-center rounded-md border border-border-strong bg-bg p-0 text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" type="button" aria-label="Закрыть меню" data-vf-menu-close>
                    <span class="text-t3 leading-none" aria-hidden="true">×</span>
                </button>
            </div>
            <nav class="px-4 py-4" aria-label="Мобильная навигация" data-vf-mobile-navigation>
                <ul class="flex flex-col gap-2">
                    {% for item in items %}
                        <li>
                            <a class="flex min-h-control items-center py-2 text-left font-medium no-underline hover:text-accent focus:text-accent{% if item.active|default(false) %} text-accent{% else %} text-fg{% endif %}" href="{{ item.href }}"{% if item.active|default(false) %} aria-current="page"{% endif %}>{{ item.label }}</a>
                        </li>
                    {% endfor %}
                </ul>
                {% if cta|default(null) %}
                    <div class="mt-6">
                        {% include 'website/components/_button.html.twig' with {label: cta.label, href: cta.href, variant: 'primary', full_mobile: true} only %}
                    </div>
                {% endif %}
            </nav>
        </div>
    </dialog>
</header>
