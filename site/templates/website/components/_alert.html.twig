{% set tone = tone|default('default') %}
{% set tones = {
    default: 'border-border bg-bg text-fg',
    success: 'border-success bg-success-bg text-fg',
    warning: 'border-warning bg-warning-bg text-fg',
    error: 'border-error bg-error-bg text-fg',
    info: 'border-info bg-info-bg text-fg',
} %}
<div class="rounded-md border p-4 {{ tones[tone]|default(tones.default) }}"{% if role|default(null) %} role="{{ role }}"{% endif %} data-vf-component="alert" data-vf-tone="{{ tone }}">
    <strong>{{ title }}</strong>
    <div>{{ text }}</div>
</div>
