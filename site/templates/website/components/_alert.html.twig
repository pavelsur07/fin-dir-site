{% set tone = tone|default('default') %}
{% set tones = {
    default: 'border-slate-200 bg-white text-slate-950',
    success: 'border-green-300 bg-green-50 text-slate-950',
    warning: 'border-amber-300 bg-amber-50 text-slate-950',
    error: 'border-orange-300 bg-orange-50 text-slate-950',
    info: 'border-blue-300 bg-blue-50 text-slate-950',
} %}
<div class="rounded-md border p-4 {{ tones[tone]|default(tones.default) }}"{% if role|default(null) %} role="{{ role }}"{% endif %} data-vf-component="alert" data-vf-tone="{{ tone }}">
    <strong>{{ title }}</strong>
    <div>{{ text }}</div>
</div>
