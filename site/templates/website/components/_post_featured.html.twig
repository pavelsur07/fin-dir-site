{# Главная статья списка: обложка слева (7/12), текст справа (5/12). Вход: post. #}
<a class="group grid gap-6 rounded-lg focus-visible:shadow-focus lg:grid-cols-12 lg:items-center lg:gap-12" href="{{ path('gazeta_post', {slug: post.slug}) }}" data-vf-section="article-featured">
    <div class="lg:col-span-7">
        {% include 'website/components/_post_cover.html.twig' with {label: post.rubric ? post.rubric.label : 'Газета', featured: true} only %}
    </div>
    <div class="flex flex-col items-start gap-4 lg:col-span-5">
        {% if post.rubric %}<span class="rounded-xs bg-surface-muted px-2 py-1 type-t7 font-medium text-fg-secondary">{{ post.rubric.label }}</span>{% endif %}
        <h2 class="font-display font-extrabold type-t2-article text-balance text-fg underline-offset-4 decoration-1 group-hover:underline">{{ post.title }}</h2>
        {% if post.excerpt %}<p class="type-t4 text-fg-secondary">{{ post.excerpt }}</p>{% endif %}
        {% include 'website/components/_post_meta.html.twig' with {post: post} only %}
    </div>
</a>
