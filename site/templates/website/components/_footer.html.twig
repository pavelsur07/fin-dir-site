{% set variant = variant|default('dark') %}
{% set muted_class = 'text-fg-secondary' %}
{% set border_class = variant == 'dark' ? 'border-fg-secondary/20' : 'border-border' %}
<footer class="border-t border-border bg-bg py-12 text-fg" data-vf-component="footer" data-vf-variant="{{ variant }}"{% if variant == 'dark' %} data-theme="dark"{% endif %}>
    <div class="vf-container">
        <a class="mb-6 inline-flex items-center no-underline" href="{{ brand_href|default('/') }}" aria-label="{{ brand }} — на главную">
            <img src="{{ variant == 'dark' ? '/assets/brand/logo-dark.png' : '/assets/brand/logo-light.png' }}" alt="" width="177" height="60" loading="lazy">
        </a>
        {% if socials|default([]) is not empty or contacts|default([]) is not empty or documents|default([]) is not empty %}
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-center md:text-start">
                    {% if description|default(null) %}
                        <p class="mb-4 {{ muted_class }}">{{ description }}</p>
                    {% endif %}
                    {% if socials|default([]) is not empty %}
                        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
                            {% for social in socials %}
                                <a class="inline-flex min-h-control min-w-control items-center justify-center rounded-sm border {{ border_class }} text-fg no-underline transition-colors hover:bg-bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" href="{{ social.href }}" target="{{ social.target|default('_self') }}" rel="{{ social.rel|default('') }}" aria-label="{{ social.label }}">
                                    {% include 'website/components/_icon.html.twig' with {name: social.icon, size: 18} only %}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                {% if contacts|default([]) is not empty %}
                    <div class="text-center md:text-start">
                        <h2 class="mb-4 text-t7 font-medium uppercase {{ muted_class }}">Контакты</h2>
                        <ul class="flex flex-col gap-4">
                            {% for contact in contacts %}
                                <li class="flex items-start justify-center gap-3 md:justify-start">
                                    <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border {{ border_class }}">
                                        {% include 'website/components/_icon.html.twig' with {name: contact.icon, size: 18} only %}
                                    </span>
                                    <div>
                                        <div class="text-t6 {{ muted_class }}">{{ contact.label }}</div>
                                        <a class="font-medium no-underline {{ variant == 'dark' ? 'text-fg hover:text-fg-secondary' : 'text-fg hover:text-accent' }}" href="{{ contact.href }}">{{ contact.value }}</a>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if documents|default([]) is not empty %}
                    <div class="text-center md:text-start">
                        <h2 class="mb-4 text-t7 font-medium uppercase {{ muted_class }}">Документы</h2>
                        <ul class="flex flex-col gap-3">
                            {% for document in documents %}
                                <li>
                                    <a class="no-underline {{ variant == 'dark' ? 'text-fg-secondary hover:text-fg' : 'text-fg-secondary hover:text-accent' }}" href="{{ document.href }}">{{ document.label }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
            <div class="my-8 h-px w-full {{ variant == 'dark' ? 'bg-fg-secondary/20' : 'bg-border' }}"></div>
        {% endif %}
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <p class="mb-0">© {{ "now"|date("Y") }} <strong>{{ brand }}</strong></p>
            <a class="{{ variant == 'dark' ? 'text-fg hover:text-fg-secondary focus-visible:outline-focus' : 'text-fg hover:text-accent focus-visible:outline-focus' }} no-underline focus-visible:outline-2 focus-visible:outline-offset-2" href="{{ privacy_href }}">Политика конфиденциальности</a>
        </div>
    </div>
</footer>
