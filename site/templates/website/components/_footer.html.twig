{% set variant = variant|default('dark') %}
{% set muted_class = variant == 'dark' ? 'text-slate-300' : 'text-slate-600' %}
{% set border_class = variant == 'dark' ? 'border-slate-600' : 'border-slate-200' %}
<footer class="border-t py-12 {{ variant == 'dark' ? 'border-slate-700 bg-slate-950 text-white' : 'border-slate-200 bg-white text-slate-950' }}" data-vf-component="footer" data-vf-variant="{{ variant }}">
    <div class="mx-auto w-full max-w-6xl px-4 md:px-8">
        <a class="mb-6 inline-flex items-center no-underline" href="{{ brand_href|default('/') }}" aria-label="{{ brand }} — на главную">
            <img src="{{ variant == 'dark' ? '/assets/brand/logo-dark.png' : '/assets/brand/logo-light.png' }}" alt="" width="177" height="60" loading="lazy">
        </a>
        {% if socials|default([]) is not empty or contacts|default([]) is not empty or documents|default([]) is not empty %}
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-center md:text-start">
                    {% if description|default(null) %}
                        <p class="mb-4 {{ muted_class }}">{{ description }}</p>
                    {% endif %}
                    {% if socials|default([]) is not empty %}
                        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
                            {% for social in socials %}
                                <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm border {{ border_class }} {{ variant == 'dark' ? 'text-white hover:bg-slate-800' : 'text-slate-950 hover:bg-slate-100' }} no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" href="{{ social.href }}" target="{{ social.target|default('_self') }}" rel="{{ social.rel|default('') }}" aria-label="{{ social.label }}">
                                    {% include 'website/components/_icon.html.twig' with {name: social.icon, size: 18} only %}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                {% if contacts|default([]) is not empty %}
                    <div class="text-center md:text-start">
                        <h2 class="mb-4 text-xs leading-5 font-medium uppercase {{ muted_class }}">Контакты</h2>
                        <ul class="flex flex-col gap-4">
                            {% for contact in contacts %}
                                <li class="flex items-start justify-center gap-3 md:justify-start">
                                    <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border {{ border_class }}">
                                        {% include 'website/components/_icon.html.twig' with {name: contact.icon, size: 18} only %}
                                    </span>
                                    <div>
                                        <div class="text-sm leading-6 {{ muted_class }}">{{ contact.label }}</div>
                                        <a class="font-medium no-underline {{ variant == 'dark' ? 'text-white hover:text-slate-200' : 'text-slate-950 hover:text-red-700' }}" href="{{ contact.href }}">{{ contact.value }}</a>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if documents|default([]) is not empty %}
                    <div class="text-center md:text-start">
                        <h2 class="mb-4 text-xs leading-5 font-medium uppercase {{ muted_class }}">Документы</h2>
                        <ul class="flex flex-col gap-3">
                            {% for document in documents %}
                                <li>
                                    <a class="no-underline {{ variant == 'dark' ? 'text-slate-300 hover:text-white' : 'text-slate-600 hover:text-red-700' }}" href="{{ document.href }}">{{ document.label }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
            <div class="my-8 h-px w-full {{ variant == 'dark' ? 'bg-slate-700' : 'bg-slate-200' }}"></div>
        {% endif %}
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <p class="mb-0">© {{ "now"|date("Y") }} <strong>{{ brand }}</strong></p>
            <a class="{{ variant == 'dark' ? 'text-white hover:text-slate-200 focus-visible:outline-white' : 'text-slate-950 hover:text-red-700 focus-visible:outline-red-700' }} no-underline focus-visible:outline-2 focus-visible:outline-offset-2" href="{{ privacy_href }}">Политика конфиденциальности</a>
        </div>
    </div>
</footer>
