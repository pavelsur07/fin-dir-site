<footer class="dark bg-surface py-12 text-fg-secondary md:py-16" data-vf-component="footer">
    <div class="mx-auto flex w-full max-w-container flex-col gap-10 px-4 md:px-8">
        <div class="grid gap-10 border-b border-border-subtle pb-10 md:grid-cols-2">
            <div class="flex flex-col items-start gap-5">
                <a class="inline-flex items-center no-underline focus-visible:shadow-focus" href="{{ brand_href }}" aria-label="{{ brand }} — на главную">
                    {% include 'website/components/_logo.html.twig' with {s: 28, dark: true, lazy: true} only %}
                </a>
                <p class="max-w-measure type-t6 text-fg-muted">{{ description }}</p>
                <div class="flex flex-wrap gap-4" role="group" aria-label="Социальные сети">
                    {% for social in socials %}
                        <a class="type-t6 text-fg-secondary underline-offset-4 hover:text-fg hover:underline focus-visible:shadow-focus" href="{{ social.href }}" target="_blank" rel="noopener noreferrer">{{ social.label }}</a>
                    {% endfor %}
                </div>
            </div>
            <div class="flex flex-col items-start gap-3">
                <h2 class="type-t6 font-semibold text-fg">Связаться</h2>
                {% for contact in contacts %}
                    {% if contact.href is defined %}
                        <a class="type-t6 text-fg-secondary underline-offset-4 hover:text-fg hover:underline focus-visible:shadow-focus" href="{{ contact.href }}"{% if contact.external|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ contact.value }}</a>
                    {% else %}
                        <span class="type-t6 text-fg-muted">{{ contact.value }} (демо)</span>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <nav class="grid gap-0 md:grid-cols-4 md:gap-8" aria-label="Основное меню футера">
            {% for column in menu %}
                <div class="hidden flex-col gap-2 md:flex">
                    <h2 class="mb-2 type-t6 font-semibold text-fg">{{ column.title }}</h2>
                    {% for item in column.items %}
                        {% if item.href is defined %}
                            <a class="type-t6 font-medium text-fg-muted no-underline hover:text-fg focus-visible:shadow-focus" href="{{ item.href }}">{{ item.label }}</a>
                        {% else %}
                            <span class="type-t6 font-medium text-fg-muted" title="Демо: страница пока не создана">{{ item.label }} <small class="type-t7">(демо)</small></span>
                        {% endif %}
                    {% endfor %}
                </div>
                <details class="border-b border-border-subtle md:hidden">
                    <summary class="flex min-h-control-xl cursor-pointer list-none items-center justify-between type-t5 font-semibold text-fg focus-visible:shadow-focus">
                        {{ column.title }}<span aria-hidden="true">+</span>
                    </summary>
                    <div class="flex flex-col gap-3 pb-6">
                        {% for item in column.items %}
                            {% if item.href is defined %}
                                <a class="type-t6 font-medium text-fg-muted no-underline hover:text-fg focus-visible:shadow-focus" href="{{ item.href }}">{{ item.label }}</a>
                            {% else %}
                                <span class="type-t6 font-medium text-fg-muted" title="Демо: страница пока не создана">{{ item.label }} <small class="type-t7">(демо)</small></span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </details>
            {% endfor %}
        </nav>

        <div class="flex flex-col gap-4 border-t border-border-subtle pt-8 type-t7 font-medium text-fg-muted">
            <nav class="flex flex-wrap gap-x-4 gap-y-3" aria-label="Документы и информация">
                {% for document in documents %}
                    {% if document.href is defined %}
                        <a class="text-fg-secondary underline-offset-4 hover:text-fg hover:underline focus-visible:shadow-focus" href="{{ document.href }}">{{ document.label }}</a>
                    {% else %}
                        <span title="Демо: документ пока не опубликован">{{ document.label }} (демо)</span>
                    {% endif %}
                {% endfor %}
            </nav>
            <p>ООО «Ваш Финдир» · ИНН 6140000234 · ОГРН 1156188000176</p>
            <p>© {{ "now"|date("Y") }} Ваш Финдир</p>
        </div>
    </div>
</footer>
