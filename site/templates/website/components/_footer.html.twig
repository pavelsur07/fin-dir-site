<footer class="dark border-t py-12 bg-surface text-white" data-vf-component="footer">
    <div class="mx-auto w-full max-w-page px-4 md:px-8">
        <a class="mb-6 inline-flex items-center no-underline" href="{{ brand_href|default('/') }}" aria-label="{{ brand }} — на главную">
            <img src="/assets/brand/logo-dark.png" alt="" width="177" height="60" loading="lazy">
        </a>
        {% if socials|default([]) is not empty or contacts|default([]) is not empty or documents|default([]) is not empty %}
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <div class="text-center md:text-start">
                    {% if description|default(null) %}
                        <p class="mb-4 text-fg-secondary">{{ description }}</p>
                    {% endif %}
                    {% if socials|default([]) is not empty %}
                        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
                            {% for social in socials %}
                                <a class="inline-flex min-h-control-touch items-center justify-center rounded-sm border border-border-strong px-3 text-white hover:bg-surface-raised no-underline transition-colors focus-visible:shadow-focus" href="{{ social.href }}" target="{{ social.target|default('_self') }}" rel="{{ social.rel|default('') }}">{{ social.label }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                {% if contacts|default([]) is not empty %}
                    <div class="text-center md:text-start">
                        <h2 class="mb-4 type-t7 font-medium uppercase text-fg-secondary">Контакты</h2>
                        <ul class="flex flex-col gap-4">
                            {% for contact in contacts %}
                                <li class="flex justify-center md:justify-start">
                                    <div>
                                        <div class="type-t6 text-fg-secondary">{{ contact.label }}</div>
                                        <a class="font-medium no-underline text-white hover:text-fg" href="{{ contact.href }}">{{ contact.value }}</a>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if documents|default([]) is not empty %}
                    <div class="text-center md:text-start">
                        <h2 class="mb-4 type-t7 font-medium uppercase text-fg-secondary">Документы</h2>
                        <ul class="flex flex-col gap-3">
                            {% for document in documents %}
                                <li>
                                    <a class="no-underline text-fg-secondary hover:text-white" href="{{ document.href }}">{{ document.label }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
            <div class="my-8 h-px w-full bg-surface-raised"></div>
        {% endif %}
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <p class="mb-0">© {{ "now"|date("Y") }} <strong>{{ brand }}</strong></p>
            <a class="text-white hover:text-fg focus-visible:shadow-focus no-underline" href="{{ privacy_href }}">Политика конфиденциальности</a>
        </div>
    </div>
</footer>
