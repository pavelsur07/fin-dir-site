<div class="grid min-w-0 gap-2" data-vf-component="select">
    <label class="font-medium text-slate-950" for="{{ id }}">{{ label }}</label>
    <select class="min-h-11 w-full rounded-md border border-slate-500 bg-white px-3 py-2 text-slate-950 focus:border-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 aria-invalid:border-orange-700 disabled:cursor-not-allowed disabled:opacity-50" id="{{ id }}" name="{{ name|default(id) }}"{% if required|default(false) %} required{% endif %}>
        {% for option in options %}
            <option value="{{ option.value }}"{% if option.selected|default(false) %} selected{% endif %}>{{ option.label }}</option>
        {% endfor %}
    </select>
</div>
