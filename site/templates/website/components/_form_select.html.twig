<div class="grid gap-1" data-vf-component="select">
    <label for="{{ id }}">{{ label }}</label>
    <select class="w-full border px-3 py-2 aria-invalid:border-orange-700" id="{{ id }}" name="{{ name|default(id) }}"{% if required|default(false) %} required{% endif %}>
        {% for option in options %}
            <option value="{{ option.value }}"{% if option.selected|default(false) %} selected{% endif %}>{{ option.label }}</option>
        {% endfor %}
    </select>
</div>
