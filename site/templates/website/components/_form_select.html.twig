<div class="flex flex-col gap-2" data-vf-component="select">
    <label class="type-t6 font-medium text-fg" for="{{ id }}">{{ label }}</label>
    <select class="h-control-lg w-full rounded-md border border-border-strong bg-surface px-4 type-t5 text-fg focus:border-accent focus:shadow-focus-field aria-invalid:border-error aria-invalid:shadow-error-field" id="{{ id }}" name="{{ name|default(id) }}"{% if required|default(false) %} required{% endif %}>
        {% for option in options %}
            <option value="{{ option.value }}"{% if option.selected|default(false) %} selected{% endif %}>{{ option.label }}</option>
        {% endfor %}
    </select>
</div>
