{% set state = state|default('default') %}
{% set feedback_id = id ~ '-feedback' %}
{% set states = {
    default: '',
    focus: 'border-focus outline-2 outline-offset-2 outline-focus',
    disabled: '',
    error: 'border-danger focus:border-danger',
    success: 'border-success focus:border-success',
} %}
<div class="grid min-w-0 gap-2" data-vf-component="select" data-vf-state="{{ state }}">
    <label class="font-medium text-content" for="{{ id }}">{{ label }}</label>
    <select class="min-h-control w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-content focus:border-focus focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:cursor-not-allowed disabled:opacity-disabled {{ states[state]|default('') }}" id="{{ id }}" name="{{ name|default(id) }}"{% if required|default(false) %} required{% endif %}{% if disabled|default(false) %} disabled{% endif %}{% if state in ['error', 'success'] %} aria-describedby="{{ feedback_id }}"{% endif %}{% if state == 'error' %} aria-invalid="true"{% endif %}>
        {% for option in options %}
            <option value="{{ option.value }}"{% if option.selected|default(false) %} selected{% endif %}>{{ option.label }}</option>
        {% endfor %}
    </select>
    {% if state == 'error' %}<div class="text-small text-danger" id="{{ feedback_id }}">{{ feedback|default('Выберите значение.') }}</div>{% endif %}
    {% if state == 'success' %}<div class="text-small text-success" id="{{ feedback_id }}">{{ feedback|default('Значение принято.') }}</div>{% endif %}
</div>
