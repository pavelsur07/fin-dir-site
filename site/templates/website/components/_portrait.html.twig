{# PNG остаётся fallback. webp_base задаётся только для подготовленных вариантов 320/640/960. #}
{% if webp_base|default(null) %}<picture class="contents">
    <source type="image/webp" srcset="{{ webp_base }}-320.webp 320w, {{ webp_base }}-640.webp 640w, {{ webp_base }}-960.webp 960w" sizes="{{ sizes }}">
{% endif %}
    <img class="{{ class }}" src="{{ src }}" alt="{{ alt }}" width="1122" height="1402" loading="lazy" decoding="async">
{% if webp_base|default(null) %}</picture>{% endif %}
