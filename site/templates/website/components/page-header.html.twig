{# Шапка страницы: хлебные крошки + H1. Спецификация: Design System 16.4 и раздел 22.
   Вход: crumbs — массив {label, url}, последний без url (текущая страница);
   title — H1; lead — необязательный лид; tone — 'muted' | 'default'.
   Ниже md вместо цепочки только ссылка на родителя (предпоследний пункт). #}
{% set tone = tone|default('default') %}
<section class="{{ tone == 'muted' ? 'bg-surface-muted' : 'bg-surface' }}" data-vf-component="page-header">
    <div class="mx-auto flex w-full max-w-container flex-col gap-6 px-4 pb-10 pt-6 md:px-8">
        {% include 'website/components/_breadcrumbs.html.twig' with {crumbs: crumbs} only %}
        <div>
            <h1 class="type-t2 md:type-t1 max-w-title text-balance text-fg">{{ title }}</h1>
            {% if lead|default %}<p class="type-t4 mt-6 max-w-lead text-fg-secondary">{{ lead }}</p>{% endif %}
        </div>
    </div>
</section>
