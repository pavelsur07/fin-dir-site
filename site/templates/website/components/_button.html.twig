{% set variant = variant|default('primary') %}
{% set state = state|default('default') %}
{% set disabled = disabled|default(false) %}
{% set focus_class = on_accent|default(false) ? 'focus-visible:outline-fg-on-accent' : 'focus-visible:outline-focus' %}
{% set variants = {
    primary: 'border-accent bg-accent text-fg-on-accent hover:border-accent-hover hover:bg-accent-hover active:border-accent-active active:bg-accent-active',
    secondary: 'border-border-strong bg-bg text-fg hover:bg-bg-subtle active:bg-bg-muted',
    ghost: 'border-transparent bg-transparent text-accent-text hover:bg-accent-subtle active:bg-bg-muted',
} %}
{% set states = {
    default: '',
    hover: variant == 'primary' ? 'border-accent-hover bg-accent-hover' : (variant == 'ghost' ? 'bg-accent-subtle' : 'bg-bg-subtle'),
    active: variant == 'primary' ? 'border-accent-active bg-accent-active' : 'bg-bg-muted',
    focus: 'outline-2 outline-offset-2 outline-focus',
} %}
{% set classes = 'inline-flex min-h-control items-center justify-center gap-2 rounded-sm border px-5 py-2 font-semibold text-t5 no-underline transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-disabled ' ~ focus_class ~ ' ' ~ variants[variant]|default(variants.primary) ~ ' ' ~ states[state]|default('') %}
{% if class|default(null) %}{% set classes = classes ~ ' ' ~ class %}{% endif %}
{% if full_mobile|default(false) %}{% set classes = classes ~ ' w-full md:w-auto' %}{% endif %}
{% if disabled %}{% set classes = classes ~ ' pointer-events-none opacity-disabled' %}{% endif %}

{% if href|default(null) %}
    <a class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %}{% if not disabled %} href="{{ href }}"{% else %} aria-disabled="true" tabindex="-1"{% endif %} data-vf-component="button" data-vf-state="{{ state }}" data-vf-variant="{{ variant }}">{{ label }}</a>
{% else %}
    <button class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %} type="{{ type|default('button') }}"{% if disabled %} disabled{% endif %} data-vf-component="button" data-vf-state="{{ state }}" data-vf-variant="{{ variant }}">{{ label }}</button>
{% endif %}
