{% set variant = variant|default('secondary') %}
{% set variants = {
    primary: 'bg-red-600 text-white hover:bg-red-700',
    secondary: 'border border-navy-900 bg-surface text-navy-900 hover:bg-surface-muted dark:border-white dark:bg-transparent dark:text-white dark:hover:bg-navy-700',
} %}
{# Размер текста можно менять, а минимальная высота и отступы едины для всех кнопок. #}
{% set sizes = {
    lg: 'type-t5',
    md: 'type-t6',
    md_tight: 'type-t6',
} %}
{% set classes = 'inline-flex min-h-11 items-center justify-center gap-2 rounded-md px-5 font-semibold no-underline transition-colors duration-fast motion-reduce:transition-none focus-visible:shadow-focus disabled:cursor-not-allowed disabled:opacity-50 ' ~ sizes[size|default('lg')]|default(sizes.lg) ~ ' ' ~ variants[variant]|default(variants.secondary) %}
{% if class|default(null) %}{% set classes = classes ~ ' ' ~ class %}{% endif %}
{% if full_mobile|default(false) %}{% set classes = classes ~ ' w-full md:w-auto' %}{% endif %}

{% if href|default(null) %}
    <a class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %}{% if aria_label|default(null) %} aria-label="{{ aria_label }}"{% endif %} href="{{ href }}" data-vf-component="button" data-vf-variant="{{ variant }}">{{ label }}</a>
{% else %}
    <button class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %}{% if aria_label|default(null) %} aria-label="{{ aria_label }}"{% endif %} type="{{ type|default('button') }}" data-vf-component="button" data-vf-variant="{{ variant }}">{{ label }}</button>
{% endif %}
