{% set variant = variant|default('primary') %}
{% set variants = {
    primary: 'border-red-700 bg-red-700 text-white hover:border-red-800 hover:bg-red-800 active:border-red-900 active:bg-red-900',
} %}
{% set classes = 'inline-flex min-h-11 items-center justify-center gap-2 rounded-sm border px-5 py-2 font-semibold text-base leading-7 no-underline transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-red-700 ' ~ variants[variant]|default(variants.primary) %}
{% if class|default(null) %}{% set classes = classes ~ ' ' ~ class %}{% endif %}
{% if full_mobile|default(false) %}{% set classes = classes ~ ' w-full md:w-auto' %}{% endif %}

{% if href|default(null) %}
    <a class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %} href="{{ href }}" data-vf-component="button" data-vf-variant="{{ variant }}">{{ label }}</a>
{% else %}
    <button class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %} type="{{ type|default('button') }}" data-vf-component="button" data-vf-variant="{{ variant }}">{{ label }}</button>
{% endif %}
