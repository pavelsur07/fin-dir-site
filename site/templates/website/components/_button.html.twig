{% set variant = variant|default('primary') %}
{% set state = state|default('default') %}
{% set disabled = disabled|default(false) %}
{% set focus_class = on_accent|default(false) ? 'focus-visible:outline-white' : 'focus-visible:outline-red-700' %}
{% set variants = {
    primary: 'border-red-700 bg-red-700 text-white hover:border-red-800 hover:bg-red-800 active:border-red-900 active:bg-red-900',
    secondary: 'border-slate-500 bg-white text-slate-950 hover:bg-slate-50 active:bg-slate-100',
    ghost: 'border-transparent bg-transparent text-red-700 hover:bg-red-50 active:bg-slate-100',
} %}
{% set states = {
    default: '',
    hover: variant == 'primary' ? 'border-red-800 bg-red-800' : (variant == 'ghost' ? 'bg-red-50' : 'bg-slate-50'),
    active: variant == 'primary' ? 'border-red-900 bg-red-900' : 'bg-slate-100',
    focus: 'outline-2 outline-offset-2 outline-red-700',
} %}
{% set classes = 'inline-flex min-h-11 items-center justify-center gap-2 rounded-sm border px-5 py-2 font-semibold text-base leading-7 no-underline transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 ' ~ focus_class ~ ' ' ~ variants[variant]|default(variants.primary) ~ ' ' ~ states[state]|default('') %}
{% if class|default(null) %}{% set classes = classes ~ ' ' ~ class %}{% endif %}
{% if full_mobile|default(false) %}{% set classes = classes ~ ' w-full md:w-auto' %}{% endif %}
{% if disabled %}{% set classes = classes ~ ' pointer-events-none opacity-50' %}{% endif %}

{% if href|default(null) %}
    <a class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %}{% if not disabled %} href="{{ href }}"{% else %} aria-disabled="true" tabindex="-1"{% endif %} data-vf-component="button" data-vf-state="{{ state }}" data-vf-variant="{{ variant }}">{{ label }}</a>
{% else %}
    <button class="{{ classes }}"{% if id|default(null) %} id="{{ id }}"{% endif %} type="{{ type|default('button') }}"{% if disabled %} disabled{% endif %} data-vf-component="button" data-vf-state="{{ state }}" data-vf-variant="{{ variant }}">{{ label }}</button>
{% endif %}
