{#
    Блок «Доверие»: три карточки с фактами о компании. Единственное место этих значений -- меняются здесь.
    Аргументы: compact (необязательно, true -- уменьшенный вариант для hero). Колонка на мобильном, ряд с md.
    Лет на рынке считается от года основания по текущей дате (years_since), склонение -- в CompanyAgeExtension.
#}
{% set founded_year = 2015 %}
{% set years_caption = 'на рынке' %}
{% set companies_value = '230+' %}
{% set companies_caption = 'компаний прошли через нас' %}
{% set closing_value = 'до 8 числа' %}
{% set closing_caption = 'закрываем период каждый месяц, а не раз в квартал' %}

{% set age = years_since(founded_year) %}
{% set cards = [
    {value: age.count ~ ' ' ~ age.unit, caption: years_caption},
    {value: companies_value, caption: companies_caption},
    {value: closing_value, caption: closing_caption},
] %}
{% set compact = compact|default(false) %}
<ul class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6" data-vf-component="trust-cards">
    {% for card in cards %}
        <li class="flex flex-col items-start rounded-lg border border-border-subtle bg-surface {{ compact ? 'gap-1 p-4' : 'gap-3 p-8' }}">
            <p class="{{ compact ? 'type-t3-num' : 'type-t1' }} text-accent">{{ card.value }}</p>
            <p class="{{ compact ? 'type-t6' : 'type-t5' }} text-fg-secondary">{{ card.caption }}</p>
        </li>
    {% endfor %}
</ul>
