{% set tone = tone|default('default') %}
{% set tones = {
    default: 'bg-white text-slate-950',
    accent: 'bg-red-700 text-white',
    'accent-solid': 'border-transparent bg-red-700 text-white',
    success: 'bg-green-50 text-green-800',
    warning: 'bg-amber-50 text-amber-800',
    error: 'bg-orange-50 text-orange-800',
    info: 'bg-blue-50 text-blue-800',
} %}
<span class="inline-flex rounded-sm border border-current px-2 py-1 text-xs leading-5 font-medium {{ tones[tone]|default(tones.default) }}" data-vf-component="badge" data-vf-tone="{{ tone }}">{{ label }}</span>
