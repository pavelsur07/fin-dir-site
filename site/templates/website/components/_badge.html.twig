{% set tone = tone|default('default') %}
{% set tones = {
    default: 'bg-bg text-fg',
    accent: 'bg-accent text-fg-on-accent',
    success: 'bg-success-bg text-success',
    warning: 'bg-warning-bg text-warning',
    error: 'bg-error-bg text-error',
    info: 'bg-info-bg text-info',
} %}
<span class="inline-flex rounded-sm border border-current px-2 py-1 text-t7 font-medium {{ tones[tone]|default(tones.default) }}" data-vf-component="badge" data-vf-tone="{{ tone }}">{{ label }}</span>
