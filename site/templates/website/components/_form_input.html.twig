{# attrs: дополнительные атрибуты input (data-… хуки JS); label_hidden: подпись только для скринридера. #}
{# analytics_private: вебвизор Метрики не записывает ввод в поле (класс ym-disable-keys). #}
<div class="flex flex-col gap-2" data-vf-component="form-input">
    <label class="{{ label_hidden|default(false) ? 'sr-only' : 'type-t6 font-medium text-fg' }}" for="{{ id }}">{{ label }}</label>
    <input class="h-control-lg w-full rounded-md border border-border-strong bg-surface px-4 type-t5 text-fg focus:border-accent focus:shadow-focus-field aria-invalid:border-error aria-invalid:shadow-error-field{% if analytics_private|default(false) %} ym-disable-keys{% endif %}" id="{{ id }}" name="{{ name|default(id) }}" type="{{ type|default('text') }}"{% if placeholder|default(null) %} placeholder="{{ placeholder }}"{% endif %}{% if autocomplete|default(null) %} autocomplete="{{ autocomplete }}"{% endif %}{% if value is defined %} value="{{ value }}"{% endif %}{% if required|default(false) %} required{% endif %}{% for attr, attr_value in attrs|default({}) %} {{ attr }}="{{ attr_value }}"{% endfor %}>
</div>
