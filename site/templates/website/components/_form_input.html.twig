{# attrs: дополнительные атрибуты input (data-… хуки JS); label_hidden: подпись только для скринридера. #}
{# analytics_private: вебвизор Метрики не записывает ввод в поле (класс ym-disable-keys). #}
{# tone: 'muted' -- поле на приглушённом фоне с мелкой подписью (форма brand на главной); по умолчанию -- обычное поле. #}
{% set muted = tone|default('default') == 'muted' %}
<div class="flex flex-col {{ muted ? 'gap-1' : 'gap-2' }}" data-vf-component="form-input">
    <label class="{{ label_hidden|default(false) ? 'sr-only' : (muted ? 'type-t7 font-semibold text-fg-secondary' : 'type-t6 font-medium text-fg') }}" for="{{ id }}">{{ label }}</label>
    <input class="{{ muted ? 'h-control-lg w-full rounded-md border border-border-subtle bg-surface-muted px-4 type-t5 text-fg focus:border-accent focus:bg-surface focus:shadow-focus-field aria-invalid:border-error aria-invalid:shadow-error-field' : 'h-control-lg w-full rounded-md border border-border-strong bg-surface px-4 type-t5 text-fg focus:border-accent focus:shadow-focus-field aria-invalid:border-error aria-invalid:shadow-error-field' }}{% if analytics_private|default(false) %} ym-disable-keys{% endif %}" id="{{ id }}" name="{{ name|default(id) }}" type="{{ type|default('text') }}"{% if placeholder|default(null) %} placeholder="{{ placeholder }}"{% endif %}{% if autocomplete|default(null) %} autocomplete="{{ autocomplete }}"{% endif %}{% if value is defined %} value="{{ value }}"{% endif %}{% if required|default(false) %} required{% endif %}{% for attr, attr_value in attrs|default({}) %} {{ attr }}="{{ attr_value }}"{% endfor %}>
</div>
