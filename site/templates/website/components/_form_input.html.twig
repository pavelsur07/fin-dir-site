{# analytics_private: вебвизор Метрики не записывает ввод в поле (класс ym-disable-keys). #}
<div class="grid gap-1" data-vf-component="form-input">
    <label for="{{ id }}">{{ label }}</label>
    <input class="w-full border px-3 py-2 aria-invalid:border-orange-700{% if analytics_private|default(false) %} ym-disable-keys{% endif %}" id="{{ id }}" name="{{ name|default(id) }}" type="{{ type|default('text') }}"{% if placeholder|default(null) %} placeholder="{{ placeholder }}"{% endif %}{% if autocomplete|default(null) %} autocomplete="{{ autocomplete }}"{% endif %}{% if value is defined %} value="{{ value }}"{% endif %}{% if required|default(false) %} required{% endif %}>
</div>
