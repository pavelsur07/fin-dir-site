<article class="h-full rounded-lg border border-slate-200 bg-white shadow-md" data-vf-component="card">
    <div class="p-4 md:p-6">
        {% if eyebrow|default(null) %}<p class="mb-4 text-xs leading-5 font-medium text-slate-600 uppercase">{{ eyebrow }}</p>{% endif %}
        <h3 class="mb-4 text-xl leading-7 font-bold">{{ title }}</h3>
        <p class="mb-0 text-slate-600">{{ text }}</p>
    </div>
</article>
