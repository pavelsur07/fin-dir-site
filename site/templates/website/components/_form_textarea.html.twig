{# analytics_private: вебвизор Метрики не записывает ввод в поле (класс ym-disable-keys). #}
{% set state = state|default('default') %}
{% set feedback_id = id ~ '-feedback' %}
{% set states = {
    default: '',
    focus: 'border-focus outline-2 outline-offset-2 outline-focus',
    disabled: '',
    error: 'border-error focus:border-error',
    success: 'border-success focus:border-success',
} %}
<div class="grid min-w-0 gap-2" data-vf-component="textarea" data-vf-state="{{ state }}">
    <label class="font-medium text-fg" for="{{ id }}">{{ label }}</label>
    <textarea class="min-h-textarea w-full resize-y rounded-md border border-border-strong bg-bg px-3 py-2 text-fg focus:border-focus focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus aria-invalid:border-error disabled:cursor-not-allowed disabled:opacity-disabled {{ states[state]|default('') }}{% if analytics_private|default(false) %} ym-disable-keys{% endif %}" id="{{ id }}" name="{{ name|default(id) }}"{% if placeholder|default(null) %} placeholder="{{ placeholder }}"{% endif %}{% if required|default(false) %} required{% endif %}{% if disabled|default(false) %} disabled{% endif %}{% if state in ['error', 'success'] %} aria-describedby="{{ feedback_id }}"{% endif %}{% if state == 'error' %} aria-invalid="true"{% endif %}>{{ value is defined ? value : '' }}</textarea>
    {% if state == 'error' %}<div class="text-t6 text-error" id="{{ feedback_id }}">{{ feedback|default('Добавьте описание.') }}</div>{% endif %}
    {% if state == 'success' %}<div class="text-t6 text-success" id="{{ feedback_id }}">{{ feedback|default('Текст принят.') }}</div>{% endif %}
</div>
