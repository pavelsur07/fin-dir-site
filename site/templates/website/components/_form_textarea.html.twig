{# analytics_private: вебвизор Метрики не записывает ввод в поле (класс ym-disable-keys). #}
<div class="grid min-w-0 gap-2" data-vf-component="textarea">
    <label class="font-medium text-slate-950" for="{{ id }}">{{ label }}</label>
    <textarea class="min-h-32 w-full resize-y rounded-md border border-slate-500 bg-white px-3 py-2 text-slate-950 focus:border-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 aria-invalid:border-orange-700 disabled:cursor-not-allowed disabled:opacity-50{% if analytics_private|default(false) %} ym-disable-keys{% endif %}" id="{{ id }}" name="{{ name|default(id) }}"{% if placeholder|default(null) %} placeholder="{{ placeholder }}"{% endif %}{% if required|default(false) %} required{% endif %}>{{ value is defined ? value : '' }}</textarea>
</div>
