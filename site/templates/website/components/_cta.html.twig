<div class="rounded-lg bg-red-700 p-4 text-white md:p-6" data-vf-component="cta">
    <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="max-w-3xl">
            <h2 class="mb-4 text-3xl font-bold leading-tight md:text-4xl text-white" id="{{ heading_id }}">{{ title }}</h2>
            <p class="mb-0">{{ text }}</p>
        </div>
        {% include 'website/components/_button.html.twig' with {
            label: action_label,
            href: action_href,
            variant: 'secondary',
            on_accent: true,
            full_mobile: true,
        } only %}
    </div>
</div>
