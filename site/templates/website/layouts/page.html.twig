{% extends 'website/layouts/base.html.twig' %}

{# Минимальный каркас страниц до внедрения новой дизайн-системы: контейнер выровнен с header и footer.
   По умолчанию текст в колонке max-w-3xl; страница может снять ограничение пустым блоком content_width. #}
{% block body %}
    <div class="mx-auto w-full max-w-6xl px-4 py-12 md:px-8">
        <div class="{% block content_width %}max-w-3xl{% endblock %} space-y-6">
            {% block content %}{% endblock %}
        </div>
    </div>
{% endblock %}
