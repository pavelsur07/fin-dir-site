{% set vf_asset_version = '0656809ba031' %}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ваш Финдир{% endblock %}</title>
    <meta name="description" content="{% block description %}Финансовый директор на аутсорсинге и SaaS-платформа для селлеров маркетплейсов: ДДС, ОПиУ, Баланс, планирование и unit-экономика.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ vf_site_url ~ app.request.pathinfo }}{% endblock %}">

    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="Ваш Финдир">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:url" content="{{ block('canonical') }}">
    <meta property="og:image" content="{% block og_image %}{{ vf_site_url ~ '/assets/og-image.png' }}{% endblock %}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('description') }}">
    <meta name="twitter:image" content="{{ block('og_image') }}">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="/assets/website/app.css?v={{ vf_asset_version }}" rel="stylesheet">

    <script src="/assets/website/analytics.js?v={{ vf_asset_version }}" defer></script>

    {% block json_ld %}
        {% include 'website/components/_json_ld.html.twig' with {
            schema: [
                {
                    '@context': 'https://schema.org',
                    '@type': 'Organization',
                    '@id': vf_site_url ~ '/#organization',
                    name: 'Ваш Финдир',
                    url: vf_site_url,
                    email: 'hello@vashfindir.ru',
                    logo: vf_site_url ~ '/assets/og-image.png',
                    sameAs: ['https://t.me/vashfindir_ru'],
                },
                {
                    '@context': 'https://schema.org',
                    '@type': 'WebSite',
                    name: 'Ваш Финдир',
                    url: vf_site_url,
                    inLanguage: 'ru-RU',
                    publisher: {'@id': vf_site_url ~ '/#organization'},
                },
            ],
        } only %}
    {% endblock %}
    {% block head %}{% endblock %}
    {% block analytics %}
        <script src="/assets/website/metrika.js?v={{ vf_asset_version }}" defer></script>
    {% endblock %}
</head>
<body>
    <a class="fixed top-2 left-2 z-50 -translate-y-24 rounded-sm bg-surface px-4 py-2 focus:translate-y-0" href="#main-content">Перейти к содержанию</a>

    {% block navigation %}
        {% include 'website/components/_navbar.html.twig' with {
            brand: 'Ваш Финдир',
            brand_href: path('home'),
            items: [
                {label: 'Главная', href: path('home')},
                {label: 'Услуги', href: '/services'},
                {label: 'Кейсы', href: '/cases'},
                {label: 'О компании', href: '/about'},
                {label: 'Газета', href: path('gazeta_index')},
                {label: 'Партнёрам', href: '/partners'},
            ],
            cta: {label: 'Записаться на встречу', href: '#lead-form'},
        } only %}
    {% endblock %}

    <main id="main-content">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        {% include 'website/components/_footer.html.twig' with {
            brand: 'Ваш Финдир',
            brand_href: path('home'),
            privacy_href: path('privacy'),
            description: 'Финансовый навигатор для e-commerce бизнеса. Строим системы учёта, которые помогают принимать прибыльные решения на маркетплейсах.',
            socials: [
                {label: 'Telegram', href: 'https://t.me/vashfindir', icon: 'telegram', target: '_blank', rel: 'noopener'},
                {label: 'YouTube', href: 'https://www.youtube.com/', icon: 'youtube', target: '_blank', rel: 'noopener'},
                {label: 'VK', href: 'https://vk.com/', icon: 'vk', target: '_blank', rel: 'noopener'},
            ],
            contacts: [
                {label: 'Телефон', href: 'tel:+78005551234', value: '+7 (800) 555-12-34', icon: 'telephone'},
                {label: 'Email', href: 'mailto:hello@vashfindir.ru', value: 'hello@vashfindir.ru', icon: 'envelope'},
                {label: 'Telegram', href: 'https://t.me/vashfindir', value: '@vashfindir', icon: 'telegram'},
            ],
            documents: [
                {label: 'Политика конфиденциальности', href: path('privacy')},
                {label: 'Договор оферты', href: path('offer')},
                {label: 'Согласие на обработку данных', href: path('consent')},
            ],
        } only %}
    {% endblock %}

    {% include 'website/components/_cookie.html.twig' with {privacy_href: path('privacy')} only %}

    {% block javascripts %}
        <script src="/assets/website/navigation.js?v={{ vf_asset_version }}" defer></script>
    {% endblock %}
</body>
</html>
