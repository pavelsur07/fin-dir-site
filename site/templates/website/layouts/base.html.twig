{% set vf_asset_version = 'f8a682d3b699' %}
<!doctype html>
{# Отступ якорей под липкой шапкой задаёт scroll-mt-sticky на самих целях (H2 статьи, разделы политики): 88 < 1024, 96 с lg. #}
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ваш Финдир{% endblock %}</title>
    <meta name="description" content="{% block description %}Финансовый директор на аутсорсинге и SaaS-платформа для селлеров маркетплейсов: ДДС, ОПиУ, Баланс, планирование и unit-экономика.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ vf_site_url ~ app.request.pathinfo }}{% endblock %}">

    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="Ваш Финдир">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:url" content="{{ block('canonical') }}">
    <meta property="og:image" content="{% block og_image %}{{ vf_site_url ~ '/assets/og-image-v2.png' }}{% endblock %}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('description') }}">
    <meta name="twitter:image" content="{{ block('og_image') }}">

    <link rel="icon" type="image/svg+xml" href="/favicon-v2.svg">
    {# Шрифты первого экрана: Manrope (заголовки и цифры) и IBM Plex Sans (текст, навигация; latin-ext — знак ₽). Без предзагрузки font-display: swap меняет высоту текста после загрузки шрифта и даёт сдвиг макета. #}
    <link rel="preload" href="/assets/fonts/manrope-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/ibm-plex-sans-cyrillic-400-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-400-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-ext-400-600.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/assets/website/app.css?v={{ vf_asset_version }}" rel="stylesheet">

    <script src="/assets/website/analytics.js?v={{ vf_asset_version }}" defer></script>

    {% block json_ld %}
        {% include 'website/components/_json_ld.html.twig' with {
            schema: [
                {
                    '@context': 'https://schema.org',
                    '@type': 'Organization',
                    '@id': vf_site_url ~ '/#organization',
                    name: 'Ваш Финдир',
                    url: vf_site_url,
                    email: 'hello@vashfindir.ru',
                    logo: vf_site_url ~ '/assets/brand/logo-light.png',
                    sameAs: ['https://t.me/vashfindir_ru'],
                },
                {
                    '@context': 'https://schema.org',
                    '@type': 'WebSite',
                    name: 'Ваш Финдир',
                    url: vf_site_url,
                    inLanguage: 'ru-RU',
                    publisher: {'@id': vf_site_url ~ '/#organization'},
                },
            ],
        } only %}
    {% endblock %}
    {% block head %}{% endblock %}
    {% block analytics %}
        <script src="/assets/website/metrika.js?v={{ vf_asset_version }}" defer></script>
    {% endblock %}
</head>
{# Колонка на всю высоту экрана: на короткой странице футер и баннер cookie прижаты к низу. #}
<body class="flex min-h-dvh flex-col bg-paper font-sans text-navy-900">
    <a class="fixed top-2 left-2 z-50 -translate-y-24 rounded-sm bg-white px-4 py-2 focus:translate-y-0" href="#main-content">Перейти к содержанию</a>

    {% set active_key %}{% block active_navigation %}{% endblock %}{% endset %}
    {% block navigation %}
        {# consult -- карточка разбора в меню «Услуги» и кнопка внизу мобильной панели: окно записи, без окна -- форма на главной.
           phone не передаётся: телефона для связи нет, часов работы в конфигурации нет. #}
        {% include 'website/components/_navbar.html.twig' with {
            brand: 'Ваш Финдир',
            brand_href: path('home'),
            items: [
                {key: 'services', label: 'Услуги', href: path('service_financial_director'), children: [
                    {key: 'financial_director', label: 'Финдир на аутсорсинге', text: 'Управленческий учёт, платёжный календарь и точки роста каждую неделю', icon: 'briefcase', href: path('service_financial_director')},
                    {key: 'financial_model', label: 'Финансовая модель', text: 'Прогноз прибыли и денег на 12 месяцев, сценарии решений', icon: 'chart-line', href: path('service_financial_model')},
                    {key: 'accounting', label: 'Бухгалтерские услуги', text: 'Бухгалтерия, налоги и отчётность без штрафов и сюрпризов', icon: 'calculator', href: path('service_accounting')},
                    {key: 'financial_accounting', label: 'Сервис ВФ', text: 'Онлайн-кабинет: банки, маркетплейсы и 1С в одном месте', icon: 'layout-dashboard', href: path('service_financial_accounting'), badge: 'Онлайн'},
                ], all: {label: 'Все услуги и цены', href: path('app_services_index')}},
                {key: 'cases', label: 'Кейсы', href: '/cases'},
                {key: 'gazeta', label: 'Газета', href: path('gazeta_index')},
                {key: 'partners', label: 'Партнёрам', href: '/partners'},
                {key: 'about', label: 'О Компании', href: '/about'},
            ],
            cta: {label: 'Личный кабинет', href: 'https://app.vashfindir.ru/'},
            consult: {title: 'Не знаете, что выбрать?', text: 'Бесплатный разбор ваших цифр за 45 минут', label: 'Записаться', mobile_label: 'Записаться на разбор', href: path('home') ~ '#lead-form'},
            active_key: active_key|trim,
            current_path: app.request.pathinfo,
        } only %}
    {% endblock %}

    {# tabindex="-1": цель фокуса для «Перейти к содержанию» и после закрытия баннера cookie. #}
    <main id="main-content" class="flex-1 focus:outline-hidden {% block main_class %}{% endblock %}" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        {# Только действующие контакты и страницы: вымышленные пункты и «демо» не выводятся (LEGAL_RULES.md, раздел 9). #}
        {% include 'website/components/_footer.html.twig' with {
            brand: 'Ваш Финдир',
            brand_href: path('home'),
            description: 'Финансовый навигатор для e-commerce бизнеса. Строим системы учёта, которые помогают принимать прибыльные решения на маркетплейсах.',
            socials: [
                {label: 'Telegram', href: 'https://t.me/vashfindir'},
            ],
            contacts: [
                {label: 'Email', href: 'mailto:hello@vashfindir.ru', value: 'hello@vashfindir.ru'},
                {label: 'Telegram', href: 'https://t.me/vashfindir', value: 'Написать в Telegram', external: true},
            ],
            menu: [
                {title: 'Услуги', items: [
                    {label: 'Финдир на аутсорсинге', href: path('service_financial_director')},
                    {label: 'Финансовая модель', href: path('service_financial_model')},
                    {label: 'Бухгалтерские услуги', href: path('service_accounting')},
                    {label: 'Сервис ВФ', href: path('service_financial_accounting')},
                    {label: 'Все услуги и цены', href: path('app_services_index')},
                ]},
                {title: 'Компания', items: [
                    {label: 'О компании', href: '/about'},
                    {label: 'Кейсы', href: '/cases'},
                    {label: 'Газета', href: path('gazeta_index')},
                    {label: 'Партнёрам', href: '/partners'},
                ]},
            ],
            documents: [
                {label: 'Политика обработки персональных данных', href: path('privacy')},
                {label: 'Согласие на обработку персональных данных', href: path('consent')},
                {label: 'Настройки cookie', action: 'cookie-settings'},
            ],
        } only %}
    {% endblock %}

    {# Окно записи на разбор: маркетинговые страницы включают sections/_lead_modal в этот блок; скрипт -- только вместе с окном. #}
    {% set lead_modal_html %}{% block lead_modal %}{% endblock %}{% endset %}
    {% if lead_modal_html|trim is not empty %}
        {{ lead_modal_html }}
        <script src="/assets/website/lead-modal.js?v={{ vf_asset_version }}" defer></script>
    {% endif %}

    {% include 'website/components/_cookie.html.twig' with {privacy_href: cookie_privacy_href|default(path('privacy'))} only %}

    {% block javascripts %}
        <script src="/assets/website/navigation.js?v={{ vf_asset_version }}" defer></script>
    {% endblock %}
    {# Вне блоков: страницы не могут случайно убрать чат, переопределив javascripts или analytics. #}
    <script src="/assets/website/bitrix24.js?v={{ vf_asset_version }}" defer></script>
</body>
</html>
