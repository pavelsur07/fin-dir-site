{% set vf_asset_version = '0f36e0b6045b' %}
<!doctype html>
{# Отступ якорей под липкой шапкой задаёт scroll-mt-sticky на самих целях (H2 статьи, разделы политики): 88 < 1024, 96 с lg. #}
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ваш Финдир{% endblock %}</title>
    <meta name="description" content="{% block description %}Финансовый директор на аутсорсинге и SaaS-платформа для селлеров маркетплейсов: ДДС, ОПиУ, Баланс, планирование и unit-экономика.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ vf_site_url ~ app.request.pathinfo }}{% endblock %}">

    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="Ваш Финдир">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:url" content="{{ block('canonical') }}">
    <meta property="og:image" content="{% block og_image %}{{ vf_site_url ~ '/assets/og-image-v2.png' }}{% endblock %}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('description') }}">
    <meta name="twitter:image" content="{{ block('og_image') }}">

    <link rel="icon" type="image/svg+xml" href="/favicon-v2.svg">
    {# Manrope набраны заголовки страниц: без предзагрузки H1 меняет начертание после загрузки шрифта. #}
    <link rel="preload" href="/assets/fonts/manrope-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/assets/website/app.css?v={{ vf_asset_version }}" rel="stylesheet">

    <script src="/assets/website/analytics.js?v={{ vf_asset_version }}" defer></script>

    {% block json_ld %}
        {% include 'website/components/_json_ld.html.twig' with {
            schema: [
                {
                    '@context': 'https://schema.org',
                    '@type': 'Organization',
                    '@id': vf_site_url ~ '/#organization',
                    name: 'Ваш Финдир',
                    url: vf_site_url,
                    email: 'hello@vashfindir.ru',
                    logo: vf_site_url ~ '/assets/brand/logo-light.png',
                    sameAs: ['https://t.me/vashfindir_ru'],
                },
                {
                    '@context': 'https://schema.org',
                    '@type': 'WebSite',
                    name: 'Ваш Финдир',
                    url: vf_site_url,
                    inLanguage: 'ru-RU',
                    publisher: {'@id': vf_site_url ~ '/#organization'},
                },
            ],
        } only %}
    {% endblock %}
    {% block head %}{% endblock %}
    {% block analytics %}
        <script src="/assets/website/metrika.js?v={{ vf_asset_version }}" defer></script>
    {% endblock %}
</head>
{# Колонка на всю высоту экрана: на короткой странице футер и баннер cookie прижаты к низу. #}
<body class="flex min-h-dvh flex-col">
    <a class="fixed top-2 left-2 z-50 -translate-y-24 rounded-sm bg-white px-4 py-2 focus:translate-y-0" href="#main-content">Перейти к содержанию</a>

    {% set active_key %}{% block active_navigation %}{% endblock %}{% endset %}
    {% block navigation %}
        {% include 'website/components/_navbar.html.twig' with {
            brand: 'Ваш Финдир',
            brand_href: path('home'),
            items: [
                {key: 'services', label: 'Услуги', href: '/services'},
                {key: 'cases', label: 'Кейсы', href: '/cases'},
                {key: 'gazeta', label: 'Газета', href: path('gazeta_index')},
                {key: 'partners', label: 'Партнёрам', href: '/partners'},
                {key: 'about', label: 'О Компании', href: '/about'},
            ],
            cta: {label: 'Личный кабинет', href: 'https://app.vashfindir.ru/'},
            active_key: active_key|trim,
        } only %}
    {% endblock %}

    {# tabindex="-1": цель фокуса для «Перейти к содержанию» и после закрытия баннера cookie. #}
    <main id="main-content" class="flex-1 focus:outline-hidden" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        {% include 'website/components/_footer.html.twig' with {
            brand: 'Ваш Финдир',
            brand_href: path('home'),
            description: 'Финансовый навигатор для e-commerce бизнеса. Строим системы учёта, которые помогают принимать прибыльные решения на маркетплейсах.',
            socials: [
                {label: 'Telegram', href: 'https://t.me/vashfindir'},
            ],
            contacts: [
                {label: 'Телефон', value: '+7 (800) 555-12-34'},
                {label: 'Email', href: 'mailto:hello@vashfindir.ru', value: 'hello@vashfindir.ru'},
                {label: 'Telegram', href: 'https://t.me/vashfindir', value: 'Написать в Telegram', external: true},
            ],
            menu: [
                {title: 'Продукт', items: [
                    {label: 'Бухгалтерия'},
                    {label: 'Платежи'},
                    {label: 'Зарплата и кадры'},
                ]},
                {title: 'Тарифы', items: [
                    {label: 'Клиентам'},
                    {label: 'ИП'},
                    {label: 'ООО'},
                    {label: 'Бухгалтерам'},
                    {label: 'Холдингам'},
                ]},
                {title: 'Компания', items: [
                    {label: 'О нас', href: '/about'},
                    {label: 'Команда'},
                    {label: 'Вакансии'},
                    {label: 'Блог', href: path('gazeta_index')},
                ]},
                {title: 'Поддержка', items: [
                    {label: 'Центр помощи'},
                    {label: 'Статус сервиса'},
                    {label: 'Безопасность'},
                    {label: 'Контакты', href: 'mailto:hello@vashfindir.ru'},
                ]},
            ],
            documents: [
                {label: 'Оферта', href: path('offer')},
                {label: 'Политика обработки персональных данных', href: path('privacy')},
                {label: 'Cookies', href: path('privacy') ~ '#privacy-cookies'},
                {label: 'Тарифы (PDF)'},
                {label: 'Раскрытие информации'},
            ],
        } only %}
    {% endblock %}

    {% include 'website/components/_cookie.html.twig' with {privacy_href: path('privacy')} only %}

    {% block javascripts %}
        <script src="/assets/website/navigation.js?v={{ vf_asset_version }}" defer></script>
    {% endblock %}
</body>
</html>
