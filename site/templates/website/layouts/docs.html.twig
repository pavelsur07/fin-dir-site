{% extends 'website/layouts/page.html.twig' %}
{% set cookie_privacy_href = vf_site_url ~ '/privacy' %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block title %}База знаний — Ваш Финдир{% endblock %}
{% block description %}Инструкции по работе с сервисом «Ваш Финдир».{% endblock %}
{% block navigation %}
    {% include 'website/components/_navbar.html.twig' with {brand: 'Ваш Финдир', brand_href: doc_url('docs_home'), items: [{key: 'docs', label: 'База знаний', href: doc_url('docs_home')}, {key: 'site', label: 'На основной сайт', href: vf_site_url}], cta: {label: 'Личный кабинет', href: 'https://app.vashfindir.ru/'}, active_key: 'docs'} only %}
{% endblock %}
{% block json_ld %}
    {% include 'website/components/_json_ld.html.twig' with {schema: {'@context': 'https://schema.org', '@type': 'WebPage', name: block('title'), url: canonical_url, description: block('description'), inLanguage: 'ru-RU'}} only %}
{% endblock %}
{% block content %}
    <div class="grid min-w-0 gap-8 lg:grid-cols-3">
        <aside class="min-w-0">
            {% include 'website/sections/docs/_navigation.html.twig' with {navigation: navigation, q: q|default('')} only %}
        </aside>
        <div class="min-w-0 space-y-6 break-words lg:col-span-2">{% block docs_content %}{% endblock %}</div>
    </div>
{% endblock %}
{% block footer %}
    {% include 'website/components/_footer.html.twig' with {brand: 'Ваш Финдир', brand_href: doc_url('docs_home'), description: 'Инструкции по работе с сервисом «Ваш Финдир».', socials: [], contacts: [{value: 'hello@vashfindir.ru', href: 'mailto:hello@vashfindir.ru'}], menu: [{title: 'Документация', items: [{label: 'Все разделы', href: doc_url('docs_home')}, {label: 'Поиск', href: doc_url('docs_search')}]}, {title: 'Ваш Финдир', items: [{label: 'Основной сайт', href: vf_site_url}, {label: 'Личный кабинет', href: 'https://app.vashfindir.ru/'}]}], documents: [{label: 'Политика обработки персональных данных', href: vf_site_url ~ '/privacy'}, {label: 'Согласие на обработку персональных данных', href: vf_site_url ~ '/consent'}, {label: 'Настройки cookie', action: 'cookie-settings'}]} only %}
{% endblock %}
