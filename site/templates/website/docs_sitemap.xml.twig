<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ doc_url('docs_home') }}</loc></url>
{% for section in sections %}<url><loc>{{ doc_url('docs_section', section.slug) }}</loc><lastmod>{{ section.updated_at|date('c') }}</lastmod></url>{% endfor %}
{% for page in pages %}<url><loc>{{ doc_url('docs_page', page.slug) }}</loc><lastmod>{{ page.updated_at|date('c') }}</lastmod></url>{% endfor %}
</urlset>
