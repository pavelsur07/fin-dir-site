{% extends 'website/layouts/page.html.twig' %}

{% set page = pager.currentPage %}
{# Адрес страницы списка с учётом рубрики; первая страница без ?page. #}
{% set list_query = {} %}
{% if rubric %}{% set list_query = list_query|merge({rubric: rubric.value}) %}{% endif %}

{% block title %}Газета{% if rubric %} — {{ rubric.label }}{% endif %}{% if page > 1 %} — страница {{ page }}{% endif %} — Ваш Финдир{% endblock %}
{% block description %}Материалы о финансовом учёте, управлении деньгами и unit-экономике для селлеров маркетплейсов.{% endblock %}
{# Каждая страница списка -- самостоятельный URL, canonical не склеивает их с первой. #}
{% block canonical %}{{ vf_site_url ~ path('gazeta_index', list_query|merge(page > 1 ? {page: page} : {})) }}{% endblock %}

{% block head %}
    {{ parent() }}
    {% if pager.hasPreviousPage %}<link rel="prev" href="{{ vf_site_url ~ path('gazeta_index', list_query|merge(pager.previousPage > 1 ? {page: pager.previousPage} : {})) }}">{% endif %}
    {% if pager.hasNextPage %}<link rel="next" href="{{ vf_site_url ~ path('gazeta_index', list_query|merge({page: pager.nextPage})) }}">{% endif %}
{% endblock %}

{% block active_navigation %}gazeta{% endblock %}

{% block page_header %}
    {% include 'website/components/page-header.html.twig' with {
        crumbs: [{label: 'Главная', url: '/'}, {label: 'Газета'}],
        title: 'Газета — Ваш Финдир',
        lead: 'Пишем о финансах, эффективном управлении компаниями и системном подходе',
    } only %}
{% endblock %}

{% block content %}
    <nav aria-label="Рубрики" data-vf-component="rubrics">
        <ul class="scrollbar-none flex gap-2 overflow-x-auto px-1 py-1 md:flex-wrap md:overflow-visible">
            <li class="shrink-0">
                <a class="inline-flex h-control-md items-center whitespace-nowrap rounded-full px-4 type-t6 font-medium focus-visible:shadow-focus {{ rubric ? 'border border-border-strong bg-surface-raised text-fg hover:bg-surface-muted' : 'bg-ink-950 text-white' }}" href="{{ path('gazeta_index') }}"{% if not rubric %} aria-current="true"{% endif %}>Все</a>
            </li>
            {% for item in rubrics %}
                <li class="shrink-0">
                    <a class="inline-flex h-control-md items-center whitespace-nowrap rounded-full px-4 type-t6 font-medium focus-visible:shadow-focus {{ rubric == item ? 'bg-ink-950 text-white' : 'border border-border-strong bg-surface-raised text-fg hover:bg-surface-muted' }}" href="{{ path('gazeta_index', {rubric: item.value}) }}"{% if rubric == item %} aria-current="true"{% endif %}>{{ item.label }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>

    {% if pager.nbResults > 0 %}
        {% set posts = [] %}
        {% for post in pager.currentPageResults %}{% set posts = posts|merge([post]) %}{% endfor %}
        {# Главная статья -- только на первой странице без фильтра рубрики. #}
        {% set has_featured = page == 1 and not rubric %}

        {% if has_featured %}
            {% include 'website/components/_post_featured.html.twig' with {post: posts|first} only %}
        {% endif %}

        <h2 class="sr-only">Все статьи</h2>
        <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-12" data-vf-section="article-list">
            {% for post in (has_featured ? posts|slice(1) : posts) %}
                <li>{% include 'website/components/_post_card.html.twig' with {post: post} only %}</li>
            {% endfor %}
        </ul>

        {% if pager.haveToPaginate %}
            {# С md -- номера страниц. #}
            <nav class="hidden items-center justify-center gap-1 md:flex" aria-label="Страницы списка" data-vf-component="pagination">
                {% if pager.hasPreviousPage %}
                    <a class="inline-flex size-control-touch items-center justify-center rounded-sm text-fg hover:bg-surface-muted focus-visible:shadow-focus" href="{{ path('gazeta_index', list_query|merge(pager.previousPage > 1 ? {page: pager.previousPage} : {})) }}" aria-label="Предыдущая страница" rel="prev">
                        {% include 'website/components/_icon.html.twig' with {name: 'chevron-left', class: 'size-icon-md'} only %}
                    </a>
                {% endif %}
                {% for number in 1..pager.nbPages %}
                    {% if number == 1 or number == pager.nbPages or (number - page)|abs <= 1 %}
                        <a class="inline-flex size-control-touch items-center justify-center rounded-sm type-t6 font-medium focus-visible:shadow-focus {{ number == page ? 'bg-ink-950 text-white' : 'text-fg hover:bg-surface-muted' }}" href="{{ path('gazeta_index', list_query|merge(number > 1 ? {page: number} : {})) }}"{% if number == page %} aria-current="page"{% else %} aria-label="Страница {{ number }}"{% endif %}>{{ number }}</a>
                    {% elseif (number - page)|abs == 2 %}
                        <span class="inline-flex size-control-touch items-center justify-center type-t6 text-fg-muted" aria-hidden="true">…</span>
                    {% endif %}
                {% endfor %}
                {% if pager.hasNextPage %}
                    <a class="inline-flex size-control-touch items-center justify-center rounded-sm text-fg hover:bg-surface-muted focus-visible:shadow-focus" href="{{ path('gazeta_index', list_query|merge({page: pager.nextPage})) }}" aria-label="Следующая страница" rel="next">
                        {% include 'website/components/_icon.html.twig' with {name: 'chevron-right', class: 'size-icon-md'} only %}
                    </a>
                {% endif %}
            </nav>

            {# Ниже md -- обычная ссылка на следующую страницу, без JS. #}
            <div class="flex flex-col items-center gap-3 md:hidden" data-vf-component="show-more">
                {% if pager.hasNextPage %}
                    <a class="inline-flex h-control-lg w-full items-center justify-center rounded-md border border-border-strong px-6 type-t5 font-semibold text-fg hover:bg-surface-muted focus-visible:shadow-focus" href="{{ path('gazeta_index', list_query|merge({page: pager.nextPage})) }}" rel="next">Показать ещё</a>
                {% endif %}
                <p class="type-t7 text-fg-muted">Показано {{ min(page * pager.maxPerPage, pager.nbResults) }} из {{ pager.nbResults }}</p>
            </div>
        {% endif %}
    {% elseif rubric %}
        <p class="type-t5 text-fg-secondary">Статей в этой рубрике пока нет</p>
    {% else %}
        <p class="type-t5 text-fg-secondary">Публикаций пока нет. Первые статьи появятся здесь в ближайшее время.</p>
    {% endif %}
{% endblock %}
