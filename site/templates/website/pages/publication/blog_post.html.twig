{% extends 'website/layouts/page.html.twig' %}

{% block title %}{{ post.seoTitle }} — Ваш Финдир{% endblock %}
{% block description %}{{ post.seoDescription ?? parent() }}{% endblock %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {schema: schema} only %}
{% endblock %}

{% block active_navigation %}gazeta{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/website/article-toc.js?v={{ vf_asset_version }}" defer></script>
{% endblock %}

{% block content %}
    {# Совпадает с BreadcrumbList в JSON-LD статьи. #}
    <nav aria-label="Хлебные крошки" data-vf-component="breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 type-t6 text-fg-secondary">
            <li><a class="rounded-xs text-fg-secondary hover:text-fg focus-visible:shadow-focus" href="{{ path('home') }}">Главная</a></li>
            <li class="flex" aria-hidden="true">{% include 'website/components/_icon.html.twig' with {name: 'chevron-right', class: 'size-icon-sm text-fg-disabled'} only %}</li>
            <li><a class="rounded-xs text-fg-secondary hover:text-fg focus-visible:shadow-focus" href="{{ path('gazeta_index') }}">Газета</a></li>
            <li class="flex" aria-hidden="true">{% include 'website/components/_icon.html.twig' with {name: 'chevron-right', class: 'size-icon-sm text-fg-disabled'} only %}</li>
            <li class="max-w-crumb truncate text-fg" aria-current="page" title="{{ post.title }}">{{ post.title }}</li>
        </ol>
    </nav>

    {# body_html -- выход MarkdownRenderer, безопасен для |raw. #}
    <article class="space-y-8" data-vf-section="article">
        <header class="max-w-title space-y-4">
            <h1 class="type-t2 md:type-t1 hyphens-auto text-balance text-fg">{{ post.title }}</h1>
            {% if post.excerpt %}<p class="type-t4 text-pretty text-fg-secondary">{{ post.excerpt }}</p>{% endif %}
            <p class="type-t6 tabular-nums text-fg-muted"><time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date('d.m.Y') }}</time>{% if post.wasUpdated %} · Обновлено <time datetime="{{ post.updatedAt|date('Y-m-d') }}">{{ post.updatedAt|date('d.m.Y') }}</time>{% endif %} · {{ post.readingMinutes }} мин чтения · Редакция Ваш Финдир</p>
        </header>

        {% set has_toc = article.toc|length > 1 %}
        {% if has_toc %}
            {# Ниже lg вместо панели -- аккордеон над текстом (не sticky): строка control-xl 56, пункты control-touch 44, chevron поворачивается. #}
            <details class="group max-w-measure rounded-md border max-lg:mb-6 lg:hidden" data-vf-toc-accordion>
                <summary class="flex h-control-xl cursor-pointer list-none items-center justify-between gap-2 rounded-md px-4 type-t6 font-semibold text-fg focus-visible:shadow-focus">
                    <span>Содержание</span>
                    {% include 'website/components/_icon.html.twig' with {name: 'chevron-down', class: 'size-icon-md shrink-0 text-fg-muted transition-transform duration-fast group-open:rotate-180'} only %}
                </summary>
                <nav class="border-t border-border-subtle px-4 py-2" aria-label="Содержание">
                    {% include 'website/components/_article_toc_list.html.twig' with {entries: article.toc, touch: true} only %}
                </nav>
            </details>
        {% endif %}

        {# Колонка у левого края контейнера, панель у правого; между ними минимум gap-10, остаток уходит в зазор (justify-between). #}
        <div class="lg:flex lg:items-start lg:justify-between lg:gap-10">
            <div class="type-t5 w-full min-w-0 max-w-measure text-fg" data-vf-article-body>
                {{ article.html|raw }}
            </div>

            {# Панель с lg: оглавление липкое внутри своей колонки (прокручивается вместе со страницей до формы), форма -- внизу панели.
               Оглавление и форма вместе выше невысокого экрана и обрезали бы кнопку, поэтому липко только оглавление.
               Ниже lg оглавление -- аккордеон сверху, форма -- под статьёй. #}
            <aside class="hidden lg:flex lg:w-full lg:min-w-toc lg:max-w-toc lg:shrink-0 lg:flex-col lg:gap-4 lg:self-stretch">
                <div class="grow">
                    {% if has_toc %}
                        <nav class="rounded-lg border p-5 lg:sticky lg:top-sticky" aria-label="Содержание">
                            <div class="flex items-center justify-between gap-2">
                                <span class="type-t6 font-semibold text-fg">Содержание</span>
                                <span class="js-toc-progress type-t7 tabular-nums text-fg-muted">0 из {{ article.toc|length }}</span>
                            </div>
                            {# Сегмент на каждый H2; при больше чем 7 разделах полосы нет, остаётся счётчик. #}
                            {% if article.toc|length <= 7 %}
                                <div class="mt-3 flex gap-1" aria-hidden="true">
                                    {% for entry in article.toc %}<span class="js-toc-segment h-1 flex-1 rounded-full bg-border-subtle transition-colors duration-fast ease-out"></span>{% endfor %}
                                </div>
                            {% endif %}
                            <div class="mt-3">
                                {% include 'website/components/_article_toc_list.html.twig' with {entries: article.toc} only %}
                            </div>
                        </nav>
                    {% endif %}
                </div>
                {% include 'website/sections/_article_question.html.twig' with {id: 'article-question-panel', title: question_form.title, text: question_form.text} only %}
            </aside>
        </div>

        <div class="max-w-measure lg:hidden">
            {% include 'website/sections/_article_question.html.twig' with {id: 'article-question-bottom', title: question_form.title, text: question_form.text} only %}
        </div>
    </article>

    {# Не меньше двух подтверждённых материалов; меньше -- блок не показываем. #}
    {% if related|length >= 2 %}
        <section class="max-w-measure space-y-4" id="related" aria-labelledby="related-title" data-vf-section="article-preview">
            <h2 class="type-t2-article text-fg" id="related-title">Ещё статьи о финансовом учёте</h2>
            <ul class="list-disc space-y-2 pl-6 type-t5">
                {% for item in related %}
                    <li><a class="text-accent hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('gazeta_post', {slug: item.slug}) }}">{{ item.title }}</a> — <time datetime="{{ item.publishedAt|date('Y-m-d') }}">{{ item.publishedAt|date('d.m.Y') }}</time></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
