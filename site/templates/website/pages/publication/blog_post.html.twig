{% extends 'website/layouts/page.html.twig' %}

{% block title %}{{ post.seoTitle }} — Ваш Финдир{% endblock %}
{% block description %}{{ post.seoDescription ?? parent() }}{% endblock %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {schema: schema} only %}
{% endblock %}

{% block active_navigation %}gazeta{% endblock %}

{% block content %}
    {# Совпадает с BreadcrumbList в JSON-LD статьи. #}
    <nav aria-label="Хлебные крошки" data-vf-component="breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 type-t6 text-fg-secondary">
            <li><a class="rounded-xs hover:text-accent focus-visible:shadow-focus" href="{{ path('home') }}">Главная</a></li>
            <li aria-hidden="true">/</li>
            <li><a class="rounded-xs hover:text-accent focus-visible:shadow-focus" href="{{ path('gazeta_index') }}">Газета</a></li>
            <li aria-hidden="true">/</li>
            <li class="max-w-sidebar truncate text-fg" aria-current="page">{{ post.title }}</li>
        </ol>
    </nav>

    {# body_html -- выход MarkdownRenderer, безопасен для |raw. #}
    <article class="max-w-text space-y-8" data-vf-section="article">
        <header class="space-y-4">
            <h1 class="type-t2 md:type-t1 hyphens-auto text-balance text-fg">{{ post.title }}</h1>
            {% if post.excerpt %}<p class="type-t4 text-pretty text-fg-secondary">{{ post.excerpt }}</p>{% endif %}
            <p class="type-t6 tabular-nums text-fg-muted"><time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date('d.m.Y') }}</time>{% if post.wasUpdated %} · Обновлено <time datetime="{{ post.updatedAt|date('Y-m-d') }}">{{ post.updatedAt|date('d.m.Y') }}</time>{% endif %} · {{ post.readingMinutes }} мин чтения · Редакция Ваш Финдир</p>
        </header>

        {% if article.toc|length > 1 %}
            <nav class="rounded-md bg-surface-muted p-6" aria-labelledby="article-toc-title">
                <h2 class="type-t3 text-fg" id="article-toc-title">Содержание</h2>
                <ol class="mt-4 list-decimal space-y-2 pl-6 type-t5 text-fg-secondary">
                    {% for entry in article.toc %}<li><a class="rounded-xs text-accent hover:text-accent-fill-hover focus-visible:shadow-focus" href="#{{ entry.id }}">{{ entry.title }}</a></li>{% endfor %}
                </ol>
            </nav>
        {% endif %}

        <div class="type-t5 text-fg">
            {{ article.html|raw }}
        </div>
    </article>

    {# Не меньше двух подтверждённых материалов; меньше -- блок не показываем. #}
    {% if related|length >= 2 %}
        <section class="max-w-text space-y-4" id="related" aria-labelledby="related-title" data-vf-section="article-preview">
            <h2 class="type-t2-article text-fg" id="related-title">Ещё статьи о финансовом учёте</h2>
            <ul class="list-disc space-y-2 pl-6 type-t5">
                {% for item in related %}
                    <li><a class="text-accent hover:text-accent-fill-hover focus-visible:shadow-focus" href="{{ path('gazeta_post', {slug: item.slug}) }}">{{ item.title }}</a> — <time datetime="{{ item.publishedAt|date('Y-m-d') }}">{{ item.publishedAt|date('d.m.Y') }}</time></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
