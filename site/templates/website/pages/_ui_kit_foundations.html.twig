{# Technical catalog only. Values printed here label the canonical CSS tokens; swatch fills use CSS variables. #}
<section class="vf-ui-kit-hero bg-bg text-fg" data-theme="dark" data-vf-section="hero" data-vf-ui-kit-intro>
    <div class="vf-container vf-ui-kit-hero-inner">
        {% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--hero', href: path('home'), label: 'Ваш Финдир — на главную'} only %}
        <div class="flex flex-wrap items-center gap-3">{% include 'website/components/_badge.html.twig' with {label: 'v2.0', tone: 'accent-solid'} only %}<span class="text-t6 text-fg-muted">Дизайн-система · цвет и типографика</span></div>
        <h1 class="mb-0 text-t1">Ink &amp; Crimson — полная цветовая схема на двух опорных цветах</h1>
        <p class="mb-0 text-t4 text-fg-secondary">Глубокий чернильный rgb(11 16 32) несёт текст, фон и структуру. Малиновый rgb(176 0 32) — единственный акцент: действия, ключевые числа, фокус. Всё остальное выведено из них.</p>
        <div class="vf-ui-kit-hero-swatches">
            {% for swatch in [{name: 'brand.ink', token: 'ink-950', detail: '#0B1020 · rgb(11 16 32)'}, {name: 'brand.crimson', token: 'crimson-700', detail: '#B00020 · rgb(176 0 32)'}] %}
                <div class="vf-ui-kit-hero-swatch"><span class="vf-ui-kit-hero-chip" data-vf-swatch="{{ swatch.token }}" aria-hidden="true"></span><span class="grid gap-1"><strong class="text-t3">{{ swatch.name }}</strong><span class="text-t6 text-fg-muted tabular-nums">{{ swatch.detail }}</span></span></div>
            {% endfor %}
        </div>
    </div>
</section>

<div class="vf-container vf-ui-kit-foundations" data-vf-ui-kit>
    <section id="logo" class="vf-ui-kit-section vf-ui-kit-first" aria-labelledby="logo-title" data-vf-ui-kit-section="logo">
        <div class="vf-ui-kit-heading"><p class="text-t7 text-accent-text">00 · Логотип</p><h2 id="logo-title">Ваш Финдир</h2><p>Знак — квадрат со скруглением и литерами «ВФ», словесная часть — «Ваш Финдир». Всё набрано Manrope 800, все размеры выводятся из стороны знака S. Логотип не рисуется вручную — только генерируется по формулам ниже.</p></div>
        <div class="vf-ui-kit-grid vf-ui-kit-grid--400">
            <div class="vf-ui-kit-logo-card"><span class="text-t7 text-fg-muted">Светлый фон · белый, ink 50</span><div class="vf-ui-kit-logo-center">{% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--sample'} only %}</div><div class="vf-ui-kit-logo-caption"><span>знак ink 950 · «ВФ» белые · слово ink 950</span><a href="/assets/brand/logo-light.png" aria-label="Скачать PNG логотипа для светлого фона" download>PNG</a></div></div>
            <div class="vf-ui-kit-logo-card bg-bg text-fg" data-theme="dark"><span class="text-t7 text-fg-muted">Тёмный фон · ink 950–800</span><div class="vf-ui-kit-logo-center">{% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--sample'} only %}</div><div class="vf-ui-kit-logo-caption"><span>знак crimson 700 · «ВФ» и слово белые</span><a href="/assets/brand/logo-dark.png" aria-label="Скачать PNG логотипа для тёмного фона" download>PNG</a></div></div>
        </div>
        <div class="vf-ui-kit-grid vf-ui-kit-grid--480">
            <div class="vf-ui-kit-panel"><h3>Построение</h3><div class="vf-ui-kit-construction"><span>охранное поле</span>{% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--construction'} only %}</div><p class="text-t7 text-fg-secondary">S = 76 · R 16 · «ВФ» 28 · слово 36 · зазор 24</p><p class="text-t7 text-fg-muted">Пунктир — охранное поле: в нём не размещаются текст, края блоков и другие логотипы.</p></div>
            <div class="vf-ui-kit-panel vf-ui-kit-formulas"><h3>Формулы</h3><div class="vf-ui-kit-formula-head"><span>Параметр</span><span>Формула</span><span>S = 152</span></div>{% for row in [
                {name: 'Сторона знака', formula: 'S', value: '152'}, {name: 'Скругление', formula: 'S × 8/38', value: '32'}, {name: '«ВФ», Manrope 800', formula: 'S × 14/38', value: '56'}, {name: 'Слово, Manrope 800', formula: 'S × 18/38', value: '72'}, {name: 'Зазор знак → слово', formula: 'S × 12/38', value: '48'}, {name: 'Выравнивание', formula: 'по центру знака', value: '—'}, {name: 'Охранное поле', formula: 'cap «ВФ» + S × 0,06', value: '≈ 49'}] %}<div class="vf-ui-kit-formula-row"><span>{{ row.name }}</span><code>{{ row.formula }}</code><strong>{{ row.value }}</strong></div>{% endfor %}</div>
        </div>
        <div class="vf-ui-kit-generator" data-vf-logo-generator>
            <div class="vf-ui-kit-generator-controls"><h3>Генератор</h3><fieldset><legend>Сторона знака S</legend><div class="vf-ui-kit-segment">{% for size in [24, 32, 48, 64, 96] %}<button type="button" data-vf-logo-size="{{ size }}" aria-pressed="{{ size == 64 ? 'true' : 'false' }}">{{ size }}</button>{% endfor %}</div></fieldset><fieldset><legend>Фон</legend><div class="vf-ui-kit-segment"><button type="button" data-vf-logo-theme="light" aria-pressed="true">Светлый</button><button type="button" data-vf-logo-theme="dark" aria-pressed="false">Тёмный</button></div></fieldset><dl class="vf-ui-kit-generator-output" aria-live="polite" aria-atomic="true">{% for row in [{name: 'Радиус', key: 'radius', value: '13 px'}, {name: '«ВФ»', key: 'letters', value: '24 px'}, {name: 'Слово', key: 'word', value: '30 px'}, {name: 'Зазор', key: 'gap', value: '20 px'}, {name: 'Охранное поле', key: 'margin', value: '≈ 21 px'}] %}<div><dt>{{ row.name }}</dt><dd data-vf-logo-output="{{ row.key }}">{{ row.value }}</dd></div>{% endfor %}</dl></div>
            <div class="vf-ui-kit-generator-stage" data-vf-logo-stage><div class="vf-ui-kit-generator-guide" data-vf-logo-guide>{% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--generated', preview: true} only %}</div></div>
        </div>
        <div class="vf-ui-kit-grid vf-ui-kit-grid--480"><div class="vf-ui-kit-panel vf-ui-kit-versions"><h3>Версии и размеры</h3><div class="vf-ui-kit-logo-variants"><span class="vf-ui-kit-logo-variant"><span class="vf-logo-sign vf-logo-sign--16">ВФ</span><small>16 · favicon</small></span><span class="vf-ui-kit-logo-variant"><span class="vf-logo-sign vf-logo-sign--48">ВФ</span><small>знак · аватар</small></span><span class="vf-ui-kit-logo-variant"><span class="vf-logo-sign vf-logo-sign--48 vf-logo-sign--accent">ВФ</span><small>иконка приложения</small></span><span class="vf-ui-kit-logo-variant">{% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--small'} only %}<small>минимум · S 24</small></span></div>{% for row in [{name:'Шапка сайта',value:'S 32 · моб 24'},{name:'Боковое меню кабинета',value:'S 32, тёмная версия'},{name:'Подвал',value:'S 28'},{name:'Письма',value:'S 40, PNG 2×'},{name:'PDF-документы',value:'знак 10 мм'},{name:'Favicon, аватар',value:'только знак, 16–512'},{name:'Минимум',value:'S 24 экран · 8 мм печать'}] %}<div class="vf-ui-kit-spec-row"><span>{{ row.name }}</span><strong>{{ row.value }}</strong></div>{% endfor %}</div>
            <div class="vf-ui-kit-panel vf-ui-kit-forbidden"><h3>Запрещено</h3><div class="vf-ui-kit-forbidden-examples">{% for label in ['растягивать', 'на crimson', 'менять форму знака', 'другой шрифт'] %}<div>{% include 'website/components/_formula_logo.html.twig' with {class: 'vf-logo--small'} only %}<small>{{ label }}</small></div>{% endfor %}</div>{% for rule in ['Менять цвета версий, перекрашивать знак в статусные цвета, делать градиенты.', 'Размещать на crimson и на пёстрых фото — только белый, ink 50 или ink 950–800.', 'Добавлять тени, обводки, свечение; поворачивать и наклонять.', 'Использовать словесную часть без знака или «ВФ» без квадрата.', 'Менять шрифт, насыщенность, трекинг или перенос «Ваш Финдир» на две строки.', 'Рисовать вручную или трассировать из PNG — только генерация по формулам.'] %}<p class="vf-ui-kit-forbidden-rule">{{ rule }}</p>{% endfor %}</div></div>
        <div class="vf-ui-kit-code bg-bg text-fg" data-theme="dark"><h3>Генерация в коде</h3><p>В вебе логотип собирается компонентом из формул; текст остаётся чётким на любом экране. Работающий пример — <a href="/assets/website/ui-kit-logo.js">ui-kit-logo.js</a>. PNG для писем и сторонних площадок генерируются скриптом с суперсэмплингом 4×.</p><pre>// Технический образец: сторона знака S определяет весь логотип
const radius = Math.round(S * 8 / 38);
const letters = Math.round(S * 14 / 38);
const word = Math.round(S * 18 / 38);
const gap = Math.round(S * 12 / 38);
const margin = Math.round(letters * 0.72) + Math.round(S * 0.06);

sign.width = sign.height = S;
sign.borderRadius = radius;
sign.fontSize = letters;
wordmark.fontSize = word;
logo.gap = gap;
clearSpace.padding = margin;

// Цвет версии задаёт тема: ink 950 на светлом фоне,
// crimson 700 и белое слово — на тёмном.
// PNG применяется только во внешних носителях.</pre></div>
    </section>

    <section id="palette" class="vf-ui-kit-section" aria-labelledby="palette-title" data-vf-ui-kit-section="palette"><div class="vf-ui-kit-heading"><p class="text-t7 text-accent-text">01 · Палитра</p><h2 id="palette-title">Тональные шкалы</h2><p>По 11 ступеней на каждый опорный цвет. Опорные значения закреплены: ink — 950, crimson — 700. Контраст указан к белому.</p></div>
        {% for family in [{name:'ink', note:'нейтральная шкала, холодный подтон 225°', colors:[{s:50,h:'#F4F6F9',c:'1,1:1'},{s:100,h:'#E8EBF1',c:'1,2:1'},{s:200,h:'#D2D8E2',c:'1,4:1'},{s:300,h:'#AEB7C8',c:'2,0:1'},{s:400,h:'#8490A8',c:'3,2:1'},{s:500,h:'#5E6A85',c:'5,4:1'},{s:600,h:'#434F6B',c:'8,2:1'},{s:700,h:'#2E3953',c:'11,5:1'},{s:800,h:'#1F2840',c:'14,6:1'},{s:900,h:'#141B2E',c:'17,1:1'},{s:950,h:'#0B1020',c:'18,9:1'}]}, {name:'crimson',note:'акцентная шкала, 350°',colors:[{s:50,h:'#FEF2F3',c:'1,1:1'},{s:100,h:'#FDE4E7',c:'1,2:1'},{s:200,h:'#FAC8CE',c:'1,5:1'},{s:300,h:'#F59DA8',c:'2,0:1'},{s:400,h:'#EE6B7C',c:'3,0:1'},{s:500,h:'#E23B52',c:'4,2:1'},{s:600,h:'#CC1A36',c:'5,6:1'},{s:700,h:'#B00020',c:'7,3:1'},{s:800,h:'#8A001B',c:'10,0:1'},{s:900,h:'#5E0012',c:'14,1:1'},{s:950,h:'#3D000B',c:'17,5:1'}]}] %}
            <div class="vf-ui-kit-palette-group"><div class="vf-ui-kit-palette-title"><h3>{{ family.name }}</h3><span>{{ family.note }}</span></div><div class="vf-ui-kit-palette-grid">{% for color in family.colors %}<div data-vf-palette-swatch><div class="vf-ui-kit-palette-chip" data-vf-swatch="{{ family.name }}-{{ color.s }}" aria-label="{{ family.name }} {{ color.s }}"><span>{{ color.s }}</span></div><div class="vf-ui-kit-palette-meta"><span>{{ color.h }}</span><span>{{ color.c }}</span></div></div>{% endfor %}</div></div>
        {% endfor %}
    </section>

    <section id="status-colors" class="vf-ui-kit-section" aria-labelledby="status-colors-title" data-vf-ui-kit-section="status-colors"><div class="vf-ui-kit-heading"><p class="text-t7 text-accent-text">02 · Семантика</p><h2 id="status-colors-title">Статусные цвета</h2><p>Ошибка сдвинута к оранжевому (15°), чтобы не спорить с брендовым малиновым: crimson — это действие, error — это проблема. Тексты статусов проходят AA на белом и на своей подложке.</p></div><div class="vf-ui-kit-grid vf-ui-kit-grid--240">{% for status in [{name:'Успех',key:'success',sample:'Платёж проведён',fg:'#0F6B40',bg:'#E3F3EA',border:'#A8D9BD',contrast:'6,6:1'},{name:'Внимание',key:'warning',sample:'Срок оплаты через 3 дня',fg:'#8A4B00',bg:'#FFF2DB',border:'#F5C979',contrast:'6,8:1'},{name:'Ошибка',key:'error',sample:'Счёт просрочен',fg:'#B3300A',bg:'#FDECE6',border:'#F4B39E',contrast:'6,3:1'},{name:'Инфо',key:'info',sample:'Отчёт обновлён',fg:'#1D4FA8',bg:'#E6EEFB',border:'#A9C2EE',contrast:'7,7:1'}] %}<div class="vf-ui-kit-status-card" data-vf-status-card data-vf-status="{{ status.key }}"><div class="vf-ui-kit-status-preview"><strong>{{ status.name }}</strong><span>{{ status.sample }}</span></div><div class="vf-ui-kit-status-data"><strong>{{ status.key }}</strong><dl><div><dt>fg</dt><dd>{{ status.fg }} <span>{{ status.contrast }}</span></dd></div><div><dt>bg</dt><dd>{{ status.bg }}</dd></div><div><dt>border</dt><dd>{{ status.border }}</dd></div></dl></div></div>{% endfor %}</div></section>

    <section id="roles" class="vf-ui-kit-section" aria-labelledby="roles-title" data-vf-ui-kit-section="roles" data-vf-showcase="colors"><div class="vf-ui-kit-heading"><p class="text-t7 text-accent-text">03 · Роли</p><h2 id="roles-title">Токены поверхностей и текста</h2><p>Иерархия текстовых ролей едина для светлой и тёмной темы. На ink малиновый 700 теряет контраст — там акцент берётся из ступени 400.</p></div><div class="vf-ui-kit-grid vf-ui-kit-grid--480">{% for mode in [{key:'light',name:'Светлая',bg:'#FFFFFF',rows:[{token:'foreground',role:'fg',use:'заголовки, основной текст',hex:'#0B1020',cr:'18,9:1'},{token:'foreground-secondary',role:'fg-secondary',use:'лиды, описания',hex:'#434F6B',cr:'8,2:1'},{token:'muted-foreground',role:'fg-muted',use:'подписи, плейсхолдеры',hex:'#5E6A85',cr:'5,4:1'},{token:'accent',role:'accent-text',use:'ссылки, CTA, ключевые числа',hex:'#B00020',cr:'7,3:1'},{token:'surface-muted',role:'bg-subtle',use:'подложки секций',hex:'#F4F6F9',cr:'не для текста'},{token:'border',role:'border',use:'рамки карточек, разделители',hex:'#D2D8E2',cr:'не для текста'},{token:'border-strong',role:'border-strong',use:'рамки полей и кнопок',hex:'#5E6A85',cr:'не для текста'}]}, {key:'dark',name:'Тёмная',bg:'#0B1020',rows:[{token:'foreground',role:'fg',use:'заголовки, основной текст',hex:'#FFFFFF',cr:'18,9:1'},{token:'foreground-secondary',role:'fg-secondary',use:'лиды, описания',hex:'#D2D8E2',cr:'13,2:1'},{token:'muted-foreground',role:'fg-muted',use:'подписи',hex:'#AEB7C8',cr:'9,4:1'},{token:'accent',role:'accent-text',use:'ссылки, акцентный текст',hex:'#EE6B7C',cr:'6,3:1'},{token:'surface-raised',role:'bg-subtle',use:'карточки на ink',hex:'#141B2E',cr:'не для текста'},{token:'border',role:'border',use:'рамки, разделители',hex:'#2E3953',cr:'не для текста'},{token:'accent-fill',role:'accent',use:'заливка CTA — белый текст',hex:'#B00020',cr:'не для текста'}]}] %}<div class="vf-ui-kit-role-card bg-bg text-fg" data-vf-color-context="{{ mode.key }}"{% if mode.key == 'dark' %} data-theme="dark"{% endif %}><span class="text-t7 text-fg-muted">{{ mode.name }} тема · background {{ mode.bg }}</span>{% for row in mode.rows %}<div class="vf-ui-kit-role-row" data-vf-role-row><span class="vf-ui-kit-role-chip" data-vf-role-color="{{ row.role }}" aria-hidden="true"></span><span><strong>{{ row.token }}</strong><small>{{ row.use }}</small></span><span class="vf-ui-kit-role-value">{{ row.hex }}<br>{{ row.cr }}</span></div>{% endfor %}</div>{% endfor %}</div></section>

    <section id="contrast" class="vf-ui-kit-section" aria-labelledby="contrast-title" data-vf-ui-kit-section="contrast"><div class="vf-ui-kit-heading"><p class="text-t7 text-accent-text">04 · Доступность</p><h2 id="contrast-title">Допустимые сочетания</h2></div><div class="vf-ui-kit-contrast-list">{% for row in [{key:'ink-white',name:'ink 950 на белом',cr:'18,9:1',verdict:'AAA · любой кегль'},{key:'white-ink',name:'белый на ink 950',cr:'18,9:1',verdict:'AAA · любой кегль'},{key:'ink600-white',name:'ink 600 на белом',cr:'8,2:1',verdict:'AAA · любой кегль'},{key:'crimson-white',name:'crimson 700 на белом',cr:'7,3:1',verdict:'AAA · любой кегль'},{key:'white-crimson',name:'белый на crimson 700',cr:'7,3:1',verdict:'AAA · любой кегль'},{key:'crimson800-soft',name:'crimson 800 на crimson 100',cr:'8,3:1',verdict:'AAA · любой кегль'},{key:'crimson400-ink',name:'crimson 400 на ink 950',cr:'6,3:1',verdict:'AA · любой кегль'},{key:'crimson700-ink',name:'crimson 700 на ink 950',cr:'2,6:1',verdict:'Запрещено для текста'}] %}<div class="vf-ui-kit-contrast-row" data-vf-contrast-row><span class="vf-ui-kit-contrast-sample" data-vf-contrast="{{ row.key }}">Аа 12</span><span>{{ row.name }}</span><strong>{{ row.cr }}</strong><span class="{{ row.key == 'crimson700-ink' ? 'text-error' : 'text-fg' }}">{{ row.verdict }}</span></div>{% endfor %}</div><p class="text-t5 text-fg-secondary">Белый на crimson 700 даёт 7,3:1, поэтому акцентные кнопки и плашки допускают текст любого кегля.</p></section>

    <section id="typography" class="vf-ui-kit-section" aria-labelledby="typography-title" data-vf-ui-kit-section="typography"><span id="foundations" aria-hidden="true"></span><div class="vf-ui-kit-heading"><p class="text-t7 text-accent-text">05 · Типографика</p><h2 id="typography-title">Manrope + Inter, шкала T1–T8</h2><p>Модуль 16 px. Manrope в T1–T3 — трекинг −0.02em, Inter — трекинг 0. Цифры — только табличные.</p></div><div class="vf-ui-kit-type-list" data-vf-showcase="typography">
        {% for row in [{name:'T1 Display',font:'Manrope 800',metrics:'48/56 · моб 36/44',class:'text-t1 font-extrabold',sample:'Финансы под контролем'},{name:'T2 H2',font:'Manrope 800',metrics:'36/44 · моб 30/38',class:'text-t2 font-extrabold',sample:'Как это работает'},{name:'T3 H3',font:'Manrope 700',metrics:'20/28',class:'text-t3 font-bold',sample:'Демонстрационный заголовок для раздела'},{name:'T4 Lead',font:'Inter 400',metrics:'18/28',class:'text-t4 text-fg-secondary',sample:'Образец вводного текста показывает длину строки и межстрочный интервал на странице.'},{name:'T5 Body',font:'Inter 400',metrics:'16/26',class:'text-t5',sample:'Демонстрационный текст для проверки набора. Здесь показаны несколько предложений и перенос строки при разной ширине экрана.'},{name:'T6 Small',font:'Inter 500',metrics:'14/22',class:'text-t6',sample:'Обновлено сегодня в 09:40 · Навигация · Подписи к полям'},{name:'T7 Caption',font:'Inter 500',metrics:'12/18',class:'text-t7',sample:'Популярный · Черновик · Служебная пометка'},{name:'T8 Число',font:'Manrope 800 · tnum',metrics:'30/38',class:'text-t8 font-extrabold tabular-nums',sample:'1 234 567,89 ₽'}] %}<div class="vf-ui-kit-type-row" data-vf-type-row><div class="vf-ui-kit-type-spec"><strong>{{ row.name }}</strong><span>{{ row.font }}</span><span>{{ row.metrics }}</span></div><div class="vf-ui-kit-type-sample {{ row.class }}">{% if row.name == "T5 Body" %}{{ row.sample }} <a href="#typography">Подробнее о типографике</a>{% elseif row.name == "T7 Caption" %}<span class="vf-ui-kit-type-badge">Популярный</span> <span class="vf-ui-kit-type-badge vf-ui-kit-type-badge--muted">Черновик</span> <span class="text-fg-muted">Служебная пометка</span>{% elseif row.name == "T8 Число" %}<span class="vf-ui-kit-number-samples"><span class="text-accent-text">0 ₽ · пример</span><span>12 400 ₽ · образец</span><span>1 184 · условно</span></span>{% else %}{{ row.sample }}{% endif %}</div></div>{% endfor %}
    </div></section>
</div>
