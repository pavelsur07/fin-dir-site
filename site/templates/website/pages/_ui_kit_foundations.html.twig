<section class="bg-slate-950 py-16 text-white" data-vf-section="hero" data-vf-ui-kit-intro>
    <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 md:px-8">
        <a class="inline-flex w-fit items-center" href="{{ path('home') }}" aria-label="Ваш Финдир — на главную"><img src="/assets/brand/logo-dark.png" alt="" width="177" height="60"></a>
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight md:text-5xl">Компоненты сайта</h1>
        <p class="max-w-3xl text-lg leading-7 text-slate-200">Примеры страниц, секций и элементов, оформленных стандартными классами Tailwind.</p>
    </div>
</section>
<div class="mx-auto grid w-full max-w-6xl gap-16 px-4 py-16 md:px-8" data-vf-ui-kit>
    <section id="logo" class="grid gap-6" aria-labelledby="logo-title" data-vf-ui-kit-section="logo">
        <h2 id="logo-title" class="text-3xl font-bold">Логотип</h2>
        <div class="grid gap-4 md:grid-cols-2">
            <div class="grid place-items-center rounded-xl border border-slate-200 bg-white p-8"><img src="/assets/brand/logo-light.png" alt="Ваш Финдир на светлом фоне" width="177" height="60"></div>
            <div class="grid place-items-center rounded-xl bg-slate-950 p-8"><img src="/assets/brand/logo-dark.png" alt="Ваш Финдир на тёмном фоне" width="177" height="60"></div>
        </div>
    </section>
    <section id="palette" class="grid gap-6" aria-labelledby="palette-title" data-vf-ui-kit-section="palette">
        <h2 id="palette-title" class="text-3xl font-bold">Цвета Tailwind</h2>
        <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-xl bg-slate-950 p-8 text-white">Slate 950</div>
            <div class="rounded-xl bg-red-700 p-8 text-white">Red 700</div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-8 text-slate-950">Slate 50</div>
        </div>
    </section>
    <section id="status-colors" class="grid gap-6" aria-labelledby="status-colors-title" data-vf-ui-kit-section="status-colors">
        <h2 id="status-colors-title" class="text-3xl font-bold">Состояния</h2>
        <div class="grid gap-4 md:grid-cols-2">
            {% include 'website/components/_alert.html.twig' with {title: 'Информация', text: 'Сообщение с пояснением.', tone: 'info'} only %}
            {% include 'website/components/_alert.html.twig' with {title: 'Ошибка', text: 'Проверьте данные формы.', tone: 'error'} only %}
        </div>
    </section>
    <section id="typography" class="grid gap-6" aria-labelledby="typography-title" data-vf-ui-kit-section="typography">
        <h2 id="typography-title" class="text-3xl font-bold">Типографика Tailwind</h2>
        <p class="text-4xl font-extrabold leading-tight md:text-5xl">Заголовок страницы</p>
        <p class="text-lg leading-7 text-slate-600">Вводный текст помогает прочитать содержание раздела.</p>
        <p class="text-base leading-7">Основной текст страницы.</p>
        <p class="text-sm leading-6 text-slate-500">Вспомогательный текст.</p>
    </section>
</div>
