{% extends 'website/layouts/page.html.twig' %}

{% block title %}Газета{% if pager.currentPage > 1 %} — страница {{ pager.currentPage }}{% endif %} — Ваш Финдир{% endblock %}
{% block description %}Материалы о финансовом учёте, управлении деньгами и unit-экономике для селлеров маркетплейсов.{% endblock %}
{# Каждая страница списка -- самостоятельный URL, canonical не склеивает их с первой. #}
{% block canonical %}{{ vf_site_url ~ (pager.currentPage > 1 ? path('gazeta_index', {page: pager.currentPage}) : path('gazeta_index')) }}{% endblock %}

{% block navigation %}
    {% include 'website/pages/_blog_navigation.html.twig' %}
{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold">Газета</h1>
    <p>Разборы финансового учёта для селлеров: ДДС, ОПиУ, Баланс, unit-экономика и управленческие решения.</p>

    {% if pager.nbResults > 0 %}
        <ul class="space-y-6" data-vf-section="article-list">
            {% for post in pager.currentPageResults %}
                <li>
                    <h2 class="text-xl font-bold"><a class="underline" href="{{ path('gazeta_post', {slug: post.slug}) }}">{{ post.title }}</a></h2>
                    <p><time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date('d.m.Y') }}</time></p>
                    {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
                </li>
            {% endfor %}
        </ul>

        {% if pager.haveToPaginate %}
            <nav aria-label="Страницы списка" data-vf-component="pagination">
                {% if pager.hasPreviousPage %}<a class="underline" href="{{ pager.previousPage > 1 ? path('gazeta_index', {page: pager.previousPage}) : path('gazeta_index') }}">← Новее</a> · {% endif %}
                Страница {{ pager.currentPage }} из {{ pager.nbPages }}
                {% if pager.hasNextPage %} · <a class="underline" href="{{ path('gazeta_index', {page: pager.nextPage}) }}">Раньше →</a>{% endif %}
            </nav>
        {% endif %}
    {% else %}
        <p>Публикаций пока нет. Первые статьи появятся здесь в ближайшее время.</p>
    {% endif %}
{% endblock %}
