{% extends 'website/layouts/base.html.twig' %}

{% block title %}Газета{% if pager.currentPage > 1 %} — страница {{ pager.currentPage }}{% endif %} — Ваш Финдир{% endblock %}
{% block description %}Материалы о финансовом учёте, управлении деньгами и unit-экономике для селлеров маркетплейсов.{% endblock %}
{# Каждая страница списка -- самостоятельный URL, canonical не склеивает их с первой. #}
{% block canonical %}{{ vf_site_url ~ (pager.currentPage > 1 ? path('gazeta_index', {page: pager.currentPage}) : path('gazeta_index')) }}{% endblock %}

{% block navigation %}
    {% include 'website/pages/_blog_navigation.html.twig' %}
{% endblock %}

{% block body %}
    {% include 'website/sections/_hero.html.twig' with {
        id: 'blog-hero',
        title: 'Газета',
        text: 'Разборы финансового учёта для селлеров: ДДС, ОПиУ, Баланс, unit-экономика и управленческие решения.',
    } only %}

    {% if pager.nbResults > 0 %}
        {% set items = [] %}
        {% for post in pager.currentPageResults %}
            {% set items = items|merge([{
                title: post.title,
                href: path('gazeta_post', {slug: post.slug}),
                meta: post.publishedAt|date('d.m.Y'),
                meta_datetime: post.publishedAt|date('Y-m-d'),
                text: post.excerpt,
            }]) %}
        {% endfor %}

        {% include 'website/sections/_grid.html.twig' with {
            id: 'blog-articles',
            marker: 'article-list',
            title: 'Публикации',
            items: items,
            pagination: pager.haveToPaginate ? {
                current: pager.currentPage,
                pages: pager.nbPages,
                prev_href: pager.hasPreviousPage ? (pager.previousPage > 1 ? path('gazeta_index', {page: pager.previousPage}) : path('gazeta_index')) : null,
                next_href: pager.hasNextPage ? path('gazeta_index', {page: pager.nextPage}) : null,
            } : null,
        } only %}
    {% else %}
        {% include 'website/sections/_text_list.html.twig' with {
            id: 'blog-empty',
            title: 'Публикаций пока нет',
            text: 'Первые статьи появятся здесь в ближайшее время.',
        } only %}
    {% endif %}
{% endblock %}
