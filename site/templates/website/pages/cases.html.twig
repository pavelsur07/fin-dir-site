{% extends 'website/layouts/base.html.twig' %}

{% block title %}Кейсы — Ваш Финдир{% endblock %}
{% block description %}Как порядок в цифрах влияет на решения в e-commerce.{% endblock %}

{% block navigation %}
    {% include 'website/components/_navbar.html.twig' with {
        brand: 'Ваш Финдир',
        brand_href: path('home'),
        items: [
            {label: 'Главная', href: path('home')},
            {label: 'Услуги', href: '/services'},
            {label: 'Кейсы', href: '/cases', active: true},
            {label: 'О компании', href: '/about'},
            {label: 'Газета', href: path('gazeta_index')},
            {label: 'Партнёрам', href: '/partners'},
        ],
        cta: {label: 'Записаться на встречу', href: path('home') ~ '#lead-form'},
    } only %}
{% endblock %}

{% block body %}
    <section class="py-12 md:py-16 lg:py-20" data-vf-section="cases">
        <div class="vf-container">
            <h1 class="mb-4 text-t1">Кейсы</h1>
            <p class="max-w-content text-t4 text-fg-secondary">Раздел в разработке. Скоро здесь появятся кейсы клиентов.</p>
        </div>
    </section>
{% endblock %}
