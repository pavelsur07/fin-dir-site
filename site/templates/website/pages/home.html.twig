{% extends 'website/layouts/page.html.twig' %}

{% block title %}Финансовый директор на аутсорсинге для селлеров маркетплейсов — Ваш Финдир{% endblock %}
{% block description %}ДДС, ОПиУ, Баланс, планирование и unit-экономика для селлеров Wildberries и Ozon. Финансовый директор на аутсорсинге и SaaS-платформа «Ваш Финдир».{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [
            {
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'Финансовый директор на аутсорсинге',
                serviceType: 'Управленческий учёт и финансовое планирование для e-commerce',
                provider: {'@id': vf_site_url ~ '/#organization'},
                areaServed: 'RU',
                url: vf_site_url,
                description: 'ДДС, ОПиУ, Баланс, планирование и unit-экономика для селлеров маркетплейсов Wildberries и Ozon.',
            },
        ],
    } only %}
{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold">Финансовый директор на аутсорсинге для селлеров маркетплейсов</h1>

    {% include 'website/sections/_lead_form.html.twig' with {
        id: 'lead-form',
        title: 'Получить консультацию',
        form: 'consultation',
        action_label: 'Получить консультацию',
    } only %}
{% endblock %}

{% block footer %}
    {% include 'website/components/_footer.html.twig' with {
        brand: 'Ваш Финдир',
        brand_href: path('home'),
        privacy_href: path('privacy'),
        description: 'Финансовый навигатор для e-commerce бизнеса. Строим системы учёта, которые помогают принимать прибыльные решения на маркетплейсах.',
        socials: [
            {label: 'Telegram', href: 'https://t.me/vashfindir', target: '_blank', rel: 'noopener'},
            {label: 'YouTube', href: 'https://www.youtube.com/', target: '_blank', rel: 'noopener'},
            {label: 'VK', href: 'https://vk.com/', target: '_blank', rel: 'noopener'},
        ],
        contacts: [
            {label: 'Телефон', href: 'tel:+78005551234', value: '+7 (800) 555-12-34'},
            {label: 'Email', href: 'mailto:hello@vashfindir.ru', value: 'hello@vashfindir.ru'},
            {label: 'Telegram', href: 'https://t.me/vashfindir', value: '@vashfindir'},
        ],
        documents: [
            {label: 'Политика конфиденциальности', href: path('privacy')},
            {label: 'Договор оферты', href: path('offer')},
            {label: 'Согласие на обработку данных', href: path('consent')},
        ],
    } only %}
{% endblock %}
