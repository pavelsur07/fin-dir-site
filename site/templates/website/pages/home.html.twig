{% set faq_items = [
    {
        title: 'Чем финансовый директор на аутсорсинге отличается от штатного?',
        text: 'Задачи те же — управленческий учёт, планирование, контроль денег, — но без найма в штат: вы платите за результат и вовлечённость в нужном объёме, а не за полную ставку специалиста.',
    },
    {
        title: 'С чего начинается работа?',
        text: 'С диагностики: подключаемся к данным маркетплейса и банка, собираем исходные цифры и определяем, какие отчёты нужны бизнесу в первую очередь.',
    },
    {
        title: 'Какие отчёты входят в систему?',
        text: 'ДДС, ОПиУ, Баланс, платёжный календарь и unit-экономика товаров. Точный состав зависит от масштаба бизнеса и текущих задач.',
    },
    {
        title: 'Сколько стоит работа?',
        text: 'Стоимость зависит от объёма задач и количества направлений бизнеса. Точную оценку даём после первичной диагностики.',
    },
] %}

{% extends 'website/layouts/base.html.twig' %}

{% block title %}Финансовый директор на аутсорсинге для селлеров маркетплейсов — Ваш Финдир{% endblock %}
{% block description %}ДДС, ОПиУ, Баланс, планирование и unit-экономика для селлеров Wildberries и Ozon. Финансовый директор на аутсорсинге и SaaS-платформа «Ваш Финдир».{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [
            {
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'Финансовый директор на аутсорсинге',
                serviceType: 'Управленческий учёт и финансовое планирование для e-commerce',
                provider: {'@id': vf_site_url ~ '/#organization'},
                areaServed: 'RU',
                url: vf_site_url,
                description: 'ДДС, ОПиУ, Баланс, планирование и unit-экономика для селлеров маркетплейсов Wildberries и Ozon.',
            },
            {
                '@context': 'https://schema.org',
                '@type': 'FAQPage',
                mainEntity: faq_items|map(item => {
                    '@type': 'Question',
                    name: item.title,
                    acceptedAnswer: {'@type': 'Answer', text: item.text},
                }),
            },
        ],
    } only %}
{% endblock %}

{% block navigation %}
    {% include 'website/components/_navbar.html.twig' with {
        brand: 'Ваш Финдир',
        brand_href: path('home'),
        items: [
            {label: 'Главная', href: path('home'), active: true},
            {label: 'Услуги', href: '/services'},
            {label: 'Кейсы', href: '/cases'},
            {label: 'О компании', href: '/about'},
            {label: 'Газета', href: path('gazeta_index')},
            {label: 'Партнёрам', href: '/partners'},
        ],
    } only %}
{% endblock %}

{% block body %}
    {% include 'website/sections/_hero.html.twig' with {
        id: 'hero',
        eyebrow: 'Финансовый директор на аутсорсинге + SaaS-платформа',
        title: 'Финансовый директор на аутсорсинге для селлеров маркетплейсов',
        text: 'ДДС, ОПиУ, Баланс, планирование и unit-экономика — управляйте бизнесом по цифрам, а не по ощущениям.',
        primary_action: {label: 'Получить консультацию', href: '#lead-form'},
        secondary_action: {label: 'Читать канал', href: 'https://t.me/vashfindir_ru'},
    } only %}

    {% include 'website/sections/_text_list.html.twig' with {
        id: 'problems',
        marker: 'problem',
        eyebrow: 'Боли собственника',
        title: 'Знакомо?',
        text: 'Когда цифры живут в разных таблицах, бизнес растёт вслепую: оборот есть, а управляемости нет.',
        items: [
            {text: 'Не понимаю, зарабатываю я или нет'},
            {text: 'Выручка растёт, а денег нет'},
            {text: 'Unit-экономику считаю на глаз'},
            {text: 'Решения принимаю по ощущениям, а не по цифрам'},
        ],
    } only %}

    {% include 'website/sections/_grid.html.twig' with {
        id: 'services',
        marker: 'benefits',
        eyebrow: 'Система управления финансами',
        title: 'Что вы получите',
        text: 'Не набор отчётов ради отчётов, а рабочая система, которая помогает видеть прибыль, деньги, риски и решения.',
        items: [
            {title: 'ДДС', text: 'Движение денежных средств: видно, куда уходят деньги и где возникает кассовый разрыв.'},
            {title: 'ОПиУ', text: 'Отчёт о прибылях и убытках: реальная прибыль, а не оборот в личном кабинете маркетплейса.'},
            {title: 'Баланс', text: 'Полная картина активов, обязательств, запасов, денег и капитала собственника.'},
            {title: 'Планирование', text: 'Финансовые планы, бюджеты, платёжный календарь и прогноз денег на ближайшие периоды.'},
            {title: 'Unit-экономика', text: 'Прибыльность каждого товара, направления и канала с учётом комиссий, логистики и себестоимости.'},
            {title: 'Интеграция с маркетплейсами', text: 'Автоматический сбор данных с Wildberries и Ozon: меньше ручного труда и ошибок в таблицах.'},
        ],
    } only %}

    {% include 'website/sections/_steps.html.twig' with {
        id: 'how-it-works',
        eyebrow: 'Процесс',
        title: 'Как это работает',
        text: 'Внедряем финансовую систему без лишней бюрократии: подключаем данные, строим отчёты, превращаем цифры в управленческие решения.',
        steps: [
            {title: 'Подключаемся', text: 'Настраиваем интеграцию с вашим маркетплейсом и банком, собираем исходные данные.'},
            {title: 'Строим учёт', text: 'Формируем ДДС, ОПиУ, Баланс, настраиваем аналитику и правила распределения.'},
            {title: 'Вы управляете', text: 'Принимаете решения на основе цифр, моделируете последствия и контролируете прибыль.'},
        ],
    } only %}

    {% include 'website/sections/_case_preview.html.twig' with {
        id: 'case',
        eyebrow: 'Кейс',
        title: 'Результат клиента',
        text: 'Селлер на Wildberries с оборотом около 5 млн ₽ в месяц: как финансовая система превращает разрозненные цифры маркетплейса в понятную картину бизнеса.',
        items: [
            {label: 'Проблема', text: 'Оборот рос, но собственник не видел реальную прибыль, кассовые разрывы и товары с отрицательной маржинальностью.'},
            {label: 'Что сделали', text: 'Собрали ДДС, ОПиУ, баланс, unit-экономику SKU и правила контроля платежей.'},
            {label: 'Результат', text: 'Нашли слабые SKU, пересобрали закупки и сделали прогноз денег на 30 дней вперёд.'},
        ],
    } only %}

    {% include 'website/sections/_faq.html.twig' with {
        id: 'faq',
        eyebrow: 'FAQ',
        title: 'Частые вопросы',
        items: faq_items,
    } only %}

    {% include 'website/sections/_lead_form.html.twig' with {
        id: 'lead-form',
        eyebrow: 'Заявка',
        title: 'Получить консультацию',
        text: 'Обсудим, как навести порядок в финансах вашего бизнеса и какие отчёты нужны в первую очередь.',
        context_items: [
            'Диагностика текущего состояния учёта',
            'План внедрения отчётов и интеграций',
            'Оценка стоимости после первого разговора',
        ],
        action_label: 'Получить консультацию',
        note: 'Онлайн-форма работает в демо-режиме. Сейчас быстрее всего связаться с нами в Telegram: @vashfindir_ru.',
    } only %}

    {% include 'website/sections/_cta.html.twig' with {
        id: 'telegram',
        title: 'Разбираю реальные кейсы финучёта',
        text: 'Показываю, как читать ДДС, ОПиУ, Баланс и unit-экономику без сложной теории. Практические разборы для собственников маркетплейс-бизнеса.',
        action_label: 'Подписаться на канал',
        action_href: 'https://t.me/vashfindir_ru',
    } only %}
{% endblock %}

{% block footer %}
    {% include 'website/components/_footer.html.twig' with {
        brand: 'Ваш Финдир',
        privacy_href: path('privacy'),
        variant: 'dark',
    } only %}
{% endblock %}
