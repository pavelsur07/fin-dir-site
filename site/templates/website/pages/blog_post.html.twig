{% extends 'website/layouts/base.html.twig' %}

{% block title %}{{ post.seoTitle }} — Ваш Финдир{% endblock %}
{% block description %}{{ post.seoDescription ?? parent() }}{% endblock %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {schema: schema} only %}
{% endblock %}

{% block navigation %}
    {% include 'website/pages/_blog_navigation.html.twig' %}
{% endblock %}

{% block body %}
    {% include 'website/sections/_article.html.twig' with {
        title: post.title,
        lead: post.excerpt,
        published_datetime: post.publishedAt|date('Y-m-d'),
        published_label: post.publishedAt|date('d.m.Y'),
        byline: 'Редакция Ваш Финдир',
        breadcrumbs: [
            {label: 'Главная', href: path('home')},
            {label: 'Газета', href: path('gazeta_index')},
            {label: post.title},
        ],
        toc: article.toc,
        body_html: article.html,
    } only %}

    {# Article Preview по контракту -- 2–4 подтверждённых материала; меньше -- блок не показываем. #}
    {% if related|length >= 2 %}
        {% set items = [] %}
        {% for item in related %}
            {% set items = items|merge([{
                title: item.title,
                href: path('gazeta_post', {slug: item.slug}),
                meta: item.publishedAt|date('d.m.Y'),
                meta_datetime: item.publishedAt|date('Y-m-d'),
                text: item.excerpt,
            }]) %}
        {% endfor %}
        {% include 'website/sections/_grid.html.twig' with {
            id: 'related',
            marker: 'article-preview',
            eyebrow: 'Читайте также',
            title: 'Ещё статьи о финансовом учёте',
            items: items,
        } only %}
    {% endif %}

    {% include 'website/sections/_cta.html.twig' with {
        id: 'telegram',
        title: 'Разбираю реальные кейсы финучёта',
        text: 'Показываю, как читать ДДС, ОПиУ, Баланс и unit-экономику без сложной теории. Практические разборы для собственников маркетплейс-бизнеса.',
        action_label: 'Подписаться на канал',
        action_href: 'https://t.me/vashfindir_ru',
    } only %}
{% endblock %}
