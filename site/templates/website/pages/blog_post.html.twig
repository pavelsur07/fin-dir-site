{% extends 'website/layouts/page.html.twig' %}

{% block title %}{{ post.seoTitle }} — Ваш Финдир{% endblock %}
{% block description %}{{ post.seoDescription ?? parent() }}{% endblock %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {schema: schema} only %}
{% endblock %}

{% block navigation %}
    {% include 'website/pages/_blog_navigation.html.twig' %}
{% endblock %}

{% block content %}
    {# Совпадает с BreadcrumbList в JSON-LD статьи. #}
    <nav aria-label="Хлебные крошки" data-vf-component="breadcrumb">
        <ol class="flex flex-wrap gap-2">
            <li><a class="underline" href="{{ path('home') }}">Главная</a> /</li>
            <li><a class="underline" href="{{ path('gazeta_index') }}">Газета</a> /</li>
            <li aria-current="page">{{ post.title }}</li>
        </ol>
    </nav>

    {# body_html -- выход MarkdownRenderer, безопасен для |raw. #}
    <article class="space-y-6" data-vf-section="article">
        <header class="space-y-2">
            <h1 class="text-3xl font-bold">{{ post.title }}</h1>
            {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
            <p><time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date('d.m.Y') }}</time> · Редакция Ваш Финдир</p>
        </header>

        {% if article.toc|length > 1 %}
            <nav aria-labelledby="article-toc-title">
                <h2 class="text-xl font-bold" id="article-toc-title">Содержание</h2>
                <ol class="list-decimal pl-6">
                    {% for entry in article.toc %}<li><a class="underline" href="#{{ entry.id }}">{{ entry.title }}</a></li>{% endfor %}
                </ol>
            </nav>
        {% endif %}

        <div class="space-y-4">
            {{ article.html|raw }}
        </div>
    </article>

    {# Не меньше двух подтверждённых материалов; меньше -- блок не показываем. #}
    {% if related|length >= 2 %}
        <section class="space-y-4" id="related" aria-labelledby="related-title" data-vf-section="article-preview">
            <h2 class="text-2xl font-bold" id="related-title">Ещё статьи о финансовом учёте</h2>
            <ul class="list-disc pl-6">
                {% for item in related %}
                    <li><a class="underline" href="{{ path('gazeta_post', {slug: item.slug}) }}">{{ item.title }}</a> — <time datetime="{{ item.publishedAt|date('Y-m-d') }}">{{ item.publishedAt|date('d.m.Y') }}</time></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
