                                            id: 'blogLeadName',
                                            name: 'name',
                                            label: 'Ваше имя',
                                            placeholder: 'Александр',
                                            required: true,
                                        } only %}
                                        {% include 'website/components/_form_input.html.twig' with {
                                            id: 'blogLeadContact',
                                            name: 'contact',
                                            label: 'Telegram или телефон',
                                            placeholder: '@username или +7 999 000-00-00',
                                            required: true,
                                        } only %}
                                        {% include 'website/components/_form_input.html.twig' with {
                                            id: 'blogLeadEmail',
                                            name: 'email',
                                            label: 'Email',
                                            placeholder: 'hello@example.ru',
                                            type: 'email',
                                        } only %}
                                        {% include 'website/components/_form_checkbox.html.twig' with {
                                            id: 'blogLeadConsent',
