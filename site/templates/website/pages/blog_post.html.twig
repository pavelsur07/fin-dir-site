                </div>
                <div class="lg:col-span-5">
                    <div class="overflow-hidden rounded-xl border border-border-default bg-surface shadow-card" aria-label="Иллюстрация сравнения маркетплейса и интернет-магазина">
                        <div class="flex items-center gap-2 border-b border-border-default bg-page px-4 py-2">
