                        <div class="flex flex-wrap gap-2">
                            <a class="inline-flex items-center gap-2 rounded-full border border-border-default bg-page px-3 py-1.5 text-small font-medium text-content transition-colors hover:border-brand-red hover:text-brand-red" href="https://chat.openai.com/" target="_blank" rel="noopener">
                                {% include 'website/components/_icon.html.twig' with {name: 'stars', size: 14} only %}
                                ChatGPT
                            </a>
                            <a class="inline-flex items-center gap-2 rounded-full border border-border-default bg-page px-3 py-1.5 text-small font-medium text-content transition-colors hover:border-brand-red hover:text-brand-red" href="https://perplexity.ai/" target="_blank" rel="noopener">
                                {% include 'website/components/_icon.html.twig' with {name: 'search', size: 14} only %}
                                Perplexity
