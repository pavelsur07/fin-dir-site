                url: vf_site_url ~ path('gazeta_post_1'),
                datePublished: '2026-05-27',
                author: [
                    {'@type': 'Person', name: 'Александр Кумар'},
                    {'@type': 'Organization', name: 'Редакция Ваш Финдир'},
                ],
                publisher: {'@id': vf_site_url ~ '/#organization'},
            },
        ],
    } only %}
{% endblock %}

