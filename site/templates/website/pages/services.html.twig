{% extends 'website/layouts/base.html.twig' %}

{% block title %}Услуги — Ваш Финдир{% endblock %}
{% block description %}Финансовый учёт, отчётность и планирование для селлеров маркетплейсов.{% endblock %}

{% block navigation %}
    {% include 'website/components/_navbar.html.twig' with {
        brand: 'Ваш Финдир',
        brand_href: path('home'),
        items: [
            {label: 'Главная', href: path('home')},
            {label: 'Услуги', href: '/services', active: true},
            {label: 'Кейсы', href: '/cases'},
            {label: 'О компании', href: '/about'},
            {label: 'Газета', href: path('gazeta_index')},
            {label: 'Партнёрам', href: '/partners'},
        ],
        cta: {label: 'Записаться на встречу', href: '#lead-form'},
    } only %}
{% endblock %}

{% block body %}
    <section class="py-12 md:py-16 lg:py-20" data-vf-section="services">
        <div class="mx-auto w-full max-w-site px-4 md:px-6">
            <h1 class="mb-4 text-h1">Услуги</h1>
            <p class="max-w-content text-lead text-muted">Раздел в разработке. Скоро здесь появится описание услуг.</p>
        </div>
    </section>
{% endblock %}
