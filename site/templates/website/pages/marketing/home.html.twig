{% extends 'website/layouts/page.html.twig' %}

{% block title %}Финансовое управление бизнесом и финдир на аутсорсинге — Ваш Финдир{% endblock %}
{% block description %}Управленческий учёт, ДДС, ОПиУ и финансовое планирование для бизнеса с оборотом от 2 млн ₽ в месяц. Бесплатная онлайн-экскурсия — 45 минут.{% endblock %}

{# «2 млн ₽» разделены неразрывными пробелами (U+00A0). #}
{% set vf_faq = [
    {question: 'Чем вы отличаетесь от бухгалтера?', answer: 'Бухгалтер ведёт учёт и сдаёт отчётность по требованиям закона. Финансовый директор строит управленческий учёт и помогает принимать решения: куда направить деньги, где теряется прибыль и как расти к цели собственника.'},
    {question: 'Кому вы подходите?', answer: 'Бизнесу от 2 млн ₽ оборота в месяц: строительство, торговля, маркетплейсы, услуги, производство и IT. Быстрее всего даём результат продавцам на Ozon и Wildberries. Не подойдём, если нужна только бухгалтерия и сдача отчётности.'},
    {question: 'Когда будет первый результат?', answer: 'Первый отчёт о движении денег и платёжный календарь — через 7 рабочих дней после диагностики. Отчёт о прибылях и убытках и баланс — следующим этапом, после согласования их структуры.'},
    {question: 'Как проходит работа?', answer: 'Дистанционно. Еженедельная встреча и отчётная по итогам месяца, обычно 5–7 числа следующего месяца. Между встречами вы видите цифры в кабинете и можете задать вопрос в мессенджере.'},
    {question: 'Нужно ли менять 1С или учётную систему?', answer: 'Нет, менять учётную систему не нужно. Управленческий учёт выстраиваем на ваших данных: банковских выписках и выгрузках из учётной системы.'},
    {question: 'Сколько это стоит?', answer: 'Стоимость зависит от оборота, количества юридических лиц, глубины погружения и сложности отрасли. Назовём цену на бесплатной экскурсии после разбора вашей ситуации.'},
    {question: 'Можно ли подключить услуги на проект или срок?', answer: 'Да. Мы за гибкие условия сотрудничества: подключаем услуги финансового директора на нужный вам период или под конкретную задачу.'},
    {question: 'Почему финансовый директор на аутсорсинге лучше, чем штатный финансист?', columns: [
        {title: 'Штатный специалист', items: [
            'высокие затраты на содержание (зарплата, налоги, социальные выплаты, бонусы, обучение);',
            'ограниченный опыт, так как специализируется на узком сегменте;',
            'может сосредоточиться на рутине и не предлагать новых решений;',
            'зависимость от одного человека, при увольнении риск потери ключевых знаний.',
        ]},
        {title: 'Финдир на аутсорсе', items: [
            'экономическая эффективность, оплата только за конкретные услуги;',
            'свежий взгляд, новые идеи и решения;',
            'фокус на стратегии, а не на операционной рутине;',
            'постоянный обмен знаниями между финансовыми директорами;',
            'гибкое масштабирование, специалиста можно привлекать по мере необходимости, без долгосрочных обязательств и долгого найма.',
        ]},
    ]},
] %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/website/tabs.js?v={{ vf_asset_version }}" defer></script>
{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [
            {
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'Финансовый директор на аутсорсинге',
                serviceType: 'Управленческий учёт и финансовое планирование для бизнеса',
                provider: {'@id': vf_site_url ~ '/#organization'},
                areaServed: 'RU',
                url: vf_site_url,
                description: 'Финансовый директор на аутсорсинге для собственников, которые хотят расти в прибыли, а не только в выручке.',
            },
        ],
    } only %}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [{
            '@context': 'https://schema.org',
            '@type': 'FAQPage',
            mainEntity: vf_faq|map(item => {
                '@type': 'Question',
                name: item.question,
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: item.answer is defined ? item.answer : item.columns|map(column => column.title ~ ': ' ~ column.items|join(' '))|join(' '),
                },
            }),
        }],
    } only %}
{% endblock %}

