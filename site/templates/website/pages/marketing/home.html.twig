{% extends 'website/layouts/page.html.twig' %}

{% block title %}Ваш финансовый директор на аутсорсинге — Ваш Финдир{% endblock %}
{% block description %}Для собственников, которые хотят расти в прибыли, а не только в выручке. Разберём ваши цифры на 45-минутной экскурсии.{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [
            {
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'Финансовый директор на аутсорсинге',
                serviceType: 'Управленческий учёт и финансовое планирование для e-commerce',
                provider: {'@id': vf_site_url ~ '/#organization'},
                areaServed: 'RU',
                url: vf_site_url,
                description: 'Финансовый директор на аутсорсинге для собственников, которые хотят расти в прибыли, а не только в выручке.',
            },
        ],
    } only %}
{% endblock %}

{% block body %}
    {% include 'website/sections/_hero.html.twig' with {} only %}
    {% include 'website/sections/_pain_points.html.twig' with {
        title: 'Из всей этой схемы непонятно, куда надо надавить — и прибыль вырастет',
        subtitle: 'Так чаще всего говорят собственники на диагностике. Обычно за этим стоит одно из этого:',
        points: [
            {icon: 'wallet', text: 'По бухгалтерии прибыль есть, а денег на счёте нет'},
            {icon: 'trending-up', text: 'Выручка растёт, а кассовые разрывы случаются всё чаще'},
            {icon: 'chart-no-axes-column', text: 'Упёрлись в потолок: работаете много, а выручка и прибыль не растут'},
            {icon: 'user-plus', text: 'Непонятно, можно ли нанимать людей в штат или это опасно для денег'},
            {icon: 'file-check', text: 'Отчёты есть, но им не доверяете и не знаете, что с ними делать'},
            {icon: 'circle-help', text: 'Решения принимаются на интуиции, а не на цифрах'},
            {icon: 'list-todo', text: 'Много мелких решений и суеты, а до важного руки не доходят'},
            {icon: 'calendar-check', text: 'Планы ставятся на глаз, и непонятно, как контролировать их выполнение'},
        ],
    } only %}
    {# «2 млн ₽» разделены неразрывными пробелами (U+00A0). #}
    {% include 'website/sections/_fit.html.twig' with {
        title: 'Кому мы подходим',
        fit: {
            title: 'Подойдём, если',
            items: [
                'Вы собственник и сами принимаете решения по деньгам',
                'Оборот от 2 млн ₽ в месяц',
                'Ваша отрасль — строительство, торговля, маркетплейсы, услуги, производство или IT',
                'Готовы регулярно разбирать цифры вместе с финдиром',
            ],
        },
        not_fit: {
            title: 'Скорее не подойдём, если',
            items: [
                'Нужна только бухгалтерия и сдача отчётности',
                'У бизнеса пока нет регулярной выручки',
                'Нужен отчёт «для галочки», а не решения',
            ],
        },
    } only %}
    {% include 'website/sections/_process.html.twig' with {
        title: 'Как мы работаем',
        steps: [
            {number: '01', title: 'Диагностика', text: 'Разбираем, как сейчас устроены деньги в бизнесе и где они теряются.'},
            {number: '02', title: 'Настройка учёта', text: 'Подключаем банки и 1С, выстраиваем управленческий учёт. Менять 1С не нужно.'},
            {number: '03', title: 'Финдир в работе', text: 'Бюджет, платёжный календарь, регулярные встречи и решения по деньгам вместе с вами.'},
            {number: '04', title: 'Цифры всегда под рукой', text: 'Между встречами вы видите ОПиУ, ДДС и прогноз остатков в своём кабинете, с телефона или компьютера.'},
        ],
    } only %}
    <div class="mx-auto w-full max-w-page px-4 py-16 md:px-8 md:py-24">
        {% include 'website/sections/_lead_form.html.twig' with {
            id: 'lead-form',
            title: 'Записаться на экскурсию',
            form: 'consultation',
            action_label: 'Отправить заявку',
            note: '45 минут. Разберём на ваших цифрах. Без продажи с порога.',
        } only %}
    </div>
{% endblock %}
