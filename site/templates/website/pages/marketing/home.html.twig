{% extends 'website/layouts/page.html.twig' %}

{% block title %}Ваш финансовый директор на аутсорсинге — Ваш Финдир{% endblock %}
{% block description %}Для собственников, которые хотят расти в прибыли, а не только в выручке. Разберём ваши цифры на 45-минутной экскурсии.{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [
            {
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'Финансовый директор на аутсорсинге',
                serviceType: 'Управленческий учёт и финансовое планирование для e-commerce',
                provider: {'@id': vf_site_url ~ '/#organization'},
                areaServed: 'RU',
                url: vf_site_url,
                description: 'Финансовый директор на аутсорсинге для собственников, которые хотят расти в прибыли, а не только в выручке.',
            },
        ],
    } only %}
{% endblock %}

{% block body %}
    {% include 'website/sections/_hero.html.twig' with {} only %}
    <div class="mx-auto w-full max-w-page px-4 py-16 md:px-8 md:py-24">
        {% include 'website/sections/_lead_form.html.twig' with {
            id: 'lead-form',
            title: 'Записаться на экскурсию',
            form: 'consultation',
            action_label: 'Отправить заявку',
            note: '45 минут. Разберём на ваших цифрах. Без продажи с порога.',
        } only %}
    </div>
{% endblock %}
