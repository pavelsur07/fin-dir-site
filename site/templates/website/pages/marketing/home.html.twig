            alt: 'Павел Новиков, управляющий партнёр',
        },
        form_title: 'Записаться на экскурсию',
        action_label: 'Записаться на экскурсию',
        note: 'Свяжемся в течение рабочего часа и предложим 2–3 слота',
    } only %}
{% endblock %}
