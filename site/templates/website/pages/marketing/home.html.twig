{% extends 'website/layouts/page.html.twig' %}

{% block title %}Ваш финансовый директор на аутсорсинге — Ваш Финдир{% endblock %}
{% block description %}Для собственников, которые хотят расти в прибыли, а не только в выручке. Разберём ваши цифры на 45-минутной экскурсии.{% endblock %}

{# «2 млн ₽» разделены неразрывными пробелами (U+00A0). #}
{% set vf_faq = [
    {question: 'У моего бизнеса узкая сфера. Какие отрасли вы обслуживаете?', answer: 'Мы работаем с бизнесом от 2 млн ₽ оборота в месяц: строительство, торговля, маркетплейсы, услуги, производство и IT. Если вашей отрасли нет в списке, напишите нам — обсудим, подойдёт ли наш метод.'},
    {question: 'Как осуществляется работа?', answer: 'Работаем дистанционно. Все процессы прозрачны: вы получаете отчёты, рекомендации и реальную картину по движению денежных средств. Используем современные онлайн-сервисы: удобно, быстро и без бюрократии.'},
    {question: 'Можно ли подключить услуги на проект или срок?', answer: 'Да. Мы за гибкие условия сотрудничества: подключаем услуги финансового директора на нужный вам период или под конкретную задачу.'},
    {question: 'Какие результаты я получу?', answer: 'Вы увидите, сколько реально денег проходит по бизнесу, увеличите прибыль, наладите систему управления и будете принимать решения на основе данных, а не догадок. Сэкономите время, снизите риски и сделаете управление компанией прозрачным и предсказуемым.'},
    {question: 'Почему финансовый директор на аутсорсинге лучше, чем штатный финансист?', columns: [
        {title: 'Штатный специалист', items: [
            'высокие затраты на содержание (зарплата, налоги, социальные выплаты, бонусы, обучение);',
            'ограниченный опыт, так как специализируется на узком сегменте;',
            'может сосредоточиться на рутине и не предлагать новых решений;',
            'зависимость от одного человека, при увольнении риск потери ключевых знаний.',
        ]},
        {title: 'Финдир на аутсорсе', items: [
            'экономическая эффективность, оплата только за конкретные услуги;',
            'свежий взгляд, новые идеи и решения;',
            'фокус на стратегии, а не на операционной рутине;',
            'постоянный обмен знаниями между финансовыми директорами;',
            'гибкое масштабирование, специалиста можно привлекать по мере необходимости, без долгосрочных обязательств и долгого найма.',
        ]},
    ]},
] %}

{% block json_ld %}
    {{ parent() }}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: [
            {
                '@context': 'https://schema.org',
                '@type': 'Service',
                name: 'Финансовый директор на аутсорсинге',
                serviceType: 'Управленческий учёт и финансовое планирование для e-commerce',
                provider: {'@id': vf_site_url ~ '/#organization'},
                areaServed: 'RU',
                url: vf_site_url,
                description: 'Финансовый директор на аутсорсинге для собственников, которые хотят расти в прибыли, а не только в выручке.',
            },
        ],
    } only %}
    {% include 'website/components/_json_ld.html.twig' with {
        schema: {
            '@context': 'https://schema.org',
            '@type': 'FAQPage',
            mainEntity: vf_faq|map(item => {
                '@type': 'Question',
                name: item.question,
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: item.answer is defined ? item.answer : item.columns|map(column => column.title ~ ': ' ~ column.items|join(' '))|join(' '),
                },
            }),
        },
    } only %}
{% endblock %}

{% block body %}
    {% include 'website/sections/_hero.html.twig' with {} only %}
    {# Факты о компании: данные в config/packages/twig.yaml (глобал vf_company_facts), общие с «О компании». #}
    {% include 'website/sections/_company_facts.html.twig' with {
        title: vf_company_facts.title,
        facts: vf_company_facts.facts,
    } only %}
    {% include 'website/sections/_pain_points.html.twig' with {
        title: 'Из всей этой схемы непонятно, куда надо надавить — и прибыль вырастет',
        subtitle: 'Так чаще всего говорят собственники на диагностике. Обычно за этим стоит одно из этого:',
        points: [
            {icon: 'wallet', text: 'По бухгалтерии прибыль есть, а денег на счёте нет'},
            {icon: 'trending-up', text: 'Выручка растёт, а кассовые разрывы случаются всё чаще'},
            {icon: 'chart-no-axes-column', text: 'Упёрлись в потолок: работаете много, а выручка и прибыль не растут'},
            {icon: 'user-plus', text: 'Непонятно, можно ли нанимать людей в штат или это опасно для денег'},
            {icon: 'file-check', text: 'Отчёты есть, но им не доверяете и не знаете, что с ними делать'},
            {icon: 'circle-help', text: 'Решения принимаются на интуиции, а не на цифрах'},
            {icon: 'list-todo', text: 'Много мелких решений и суеты, а до важного руки не доходят'},
            {icon: 'calendar-check', text: 'Планы ставятся на глаз, и непонятно, как контролировать их выполнение'},
        ],
    } only %}
    {# «2 млн ₽» разделены неразрывными пробелами (U+00A0). #}
    {% include 'website/sections/_fit.html.twig' with {
        title: 'Кому мы подходим',
        fit: {
            title: 'Подойдём, если',
            items: [
                'Вы собственник и сами принимаете решения по деньгам',
                'Оборот от 2 млн ₽ в месяц',
                'Ваша отрасль — строительство, торговля, маркетплейсы, услуги, производство или IT',
                'Готовы регулярно разбирать цифры вместе с финдиром',
            ],
        },
        not_fit: {
            title: 'Скорее не подойдём, если',
            items: [
                'Нужна только бухгалтерия и сдача отчётности',
                'У бизнеса пока нет регулярной выручки',
                'Нужен отчёт «для галочки», а не решения',
            ],
        },
    } only %}
    {% include 'website/sections/_process.html.twig' with {
        title: 'Как мы работаем',
        steps: [
            {number: '01', title: 'Диагностика', text: 'Разбираем, как сейчас устроены деньги в бизнесе и где они теряются.'},
            {number: '02', title: 'Настройка учёта', text: 'Подключаем банки и 1С, выстраиваем управленческий учёт. Менять 1С не нужно.'},
            {number: '03', title: 'Финдир в работе', text: 'Бюджет, платёжный календарь, регулярные встречи и решения по деньгам вместе с вами.'},
            {number: '04', title: 'Цифры всегда под рукой', text: 'Между встречами вы видите ОПиУ, ДДС и прогноз остатков в своём кабинете, с телефона или компьютера.'},
        ],
    } only %}
    {% include 'website/sections/_trust_data.html.twig' with {
        title: 'Цифры, которым можно доверять',
        subtitle: 'Сначала наводим порядок в данных. Иначе любое решение строится на песке.',
        cards: [
            {number: '01', title: 'Сверяем с банком и учётом', text: 'Остатки в кабинете сходятся с выписками и учётной системой. Расхождения видны сразу.'},
            {number: '02', title: 'Фиксируем правила учёта', text: 'Договариваемся, что куда относится, чтобы цифры можно было сравнивать месяц к месяцу.'},
            {number: '03', title: 'Каждое число раскрывается', text: 'От итоговой прибыли можно дойти до конкретной операции и понять, откуда цифра.'},
        ],
    } only %}
    {% include 'website/sections/_profit_path.html.twig' with {
        title: 'Путь к прибыли',
        subtitle: 'Мы не продаём отчёты. Мы помогаем принимать решения, которые двигают прибыль, и держать курс, пока они не дадут результат.',
        steps: [
            {number: '01', title: 'Понять, где вы зарабатываете, а где теряете', text: 'Раскладываем прибыль по направлениям, клиентам и продуктам. Видно, что кормит бизнес, а что его съедает.', label: 'Разбор и кабинет'},
            {number: '02', title: 'Найти, куда надавить, чтобы прибыль выросла', text: 'Считаем, какой показатель сильнее всего двигает прибыль: цена, маржа, расходы или оборачиваемость.', label: 'Расчёт чувствительности'},
            {number: '03', title: 'Просчитать решение до того, как его принять', text: 'Найм, кредит, новое направление: заранее видно, что будет с прибылью и деньгами.', label: 'Финмодель'},
            {number: '04', title: 'Ставить план и контролировать его выполнение', text: 'Ставим план на месяц и год, регулярно сверяем с фактом и поправляем, пока не поздно.', label: 'Встречи и разборы'},
            {number: '05', title: 'Получать ответ, когда он нужен', text: 'Вопрос о деньгах посреди недели решается в тот же день, без ожидания следующей встречи.', label: 'Мессенджер и кабинет'},
        ],
    } only %}
    {# image — имя файла в /assets/screens/ с версией; при замене скриншота увеличить v. #}
    {% include 'website/sections/_cabinet_preview.html.twig' with {
        title: 'Кабинет, который понятен собственнику',
        subtitle: 'Не Excel раз в месяц, а живые цифры каждый день. Финдир объясняет, что с ними делать.',
        cards: [
            {image: 'forecast-balance-v1', caption: 'Прогноз остатков: разрыв видно за месяц, а не за день', alt: 'Прогноз остатков на счёте: график с точкой кассового разрыва'},
            {image: 'profit-by-segment-v1', caption: 'Прибыль по направлениям: видно, кто кормит бизнес, а кто съедает деньги', alt: 'Прибыль по направлениям: опт, розница, маркетплейсы, новый проект'},
            {image: 'payment-calendar-v1', caption: 'Платёжный календарь: что, кому и когда платим', alt: 'Платёжный календарь: даты, получатели и суммы платежей'},
        ],
        note: 'Данные демо-компании.',
    } only %}
    {# Демо-данные: заменить на реальные кейсы после согласования с клиентами. #}
    {% include 'website/sections/_cases.html.twig' with {
        title: 'Как это выглядит на практике',
        subtitle: 'Примеры задач, с которыми к нам приходят собственники',
        cases: [
            {industry: 'Торговля', problem: 'Выручка растёт, а денег на счёте не хватает.', action: 'Платёжный календарь по неделям и ОПиУ по товарным группам.', result: 'Кассовые разрывы видны за несколько недель вперёд.'},
            {industry: 'Строительство', problem: 'Непонятно, какие объекты приносят прибыль.', action: 'ОПиУ по проектам.', result: 'Убыточный объект найден до закрытия сметы.'},
            {industry: 'Маркетплейсы', problem: 'Оборот большой, маржа неясна.', action: 'ABC-анализ по товарам.', result: 'Нерентабельные позиции убраны из закупки.'},
        ],
        note: 'Демо-данные. Реальные кейсы появятся после согласования с клиентами.',
    } only %}
    {# Команда: данные в config/packages/twig.yaml (глобал vf_team), общие с «О компании». #}
    {% include 'website/sections/_team.html.twig' with {
