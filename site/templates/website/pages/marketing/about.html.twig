{% extends 'website/layouts/page.html.twig' %}

{% block title %}О компании — Ваш Финдир{% endblock %}
{% block description %}Финансовый навигатор для e-commerce бизнеса.{% endblock %}

{% block active_navigation %}about{% endblock %}

{% block page_header %}
    {% include 'website/components/page-header.html.twig' with {
        crumbs: [{label: 'Главная', url: '/'}, {label: 'О компании'}],
        title: 'О компании',
        lead: 'Ваш Финдир — финансовый директор на аутсорсинге. Мы работаем в собственном сервисе вместо Excel-таблиц, чтобы собственник видел реальную прибыль и понимал, как расти к своей цели.',
        tone: 'muted',
    } only %}
{% endblock %}

{# Как на главной: секции сами задают фон и контейнер, поэтому body без контейнера layout. #}
{% block body %}
    {{ block('page_header') }}
    <div class="mx-auto w-full max-w-container px-4 md:px-8">
        {% include 'website/components/mission-block.html.twig' with {
            text: 'Создать <span class="text-accent">культуру эффективного использования</span> инструментов управленческого учёта в&nbsp;малом и среднем бизнесе',
        } only %}
    </div>
    {% include 'website/sections/_company_facts.html.twig' with {
        title: vf_company_facts.title,
        facts: vf_company_facts.facts,
    } only %}
    {% include 'website/sections/_trust_data.html.twig' with {
        id: 'about-process-title',
        title: 'Как мы работаем',
        subtitle: 'От порядка в деньгах к решениям, которые увеличивают прибыль.',
        cards: [
            {number: '01', title: 'Первый месяц: основа', text: 'Загружаем движение денег, выстраиваем структуру и платёжный календарь по неделям. Кассовые разрывы видны уже в первые недели.'},
            {number: '02', title: 'Затем: реальная прибыль', text: 'Считаем ОПиУ по направлениям, товарам и проектам, делаем ABC-анализ и показываем, что приносит деньги, а что съедает.'},
            {number: '03', title: 'Постоянно: решения', text: 'Помогаем с закупками, проектами и распределением ресурсов. Еженедельная встреча и отчётная встреча по итогам месяца.'},
        ],
    } only %}
    {# «2 млн ₽» разделены неразрывными пробелами (U+00A0). #}
    {% include 'website/sections/_audience.html.twig' with {
        label: 'Для кого мы работаем',
        value: 'от 2 млн ₽',
        caption: 'оборота в месяц',
        tags: ['Строительство', 'Торговля', 'Маркетплейсы', 'Услуги', 'Производство', 'IT'],
    } only %}
    {% include 'website/sections/_team.html.twig' with {
        id: 'about-team-title',
        title: vf_team.title,
        subtitle: vf_team.subtitle,
        people: vf_team.people,
    } only %}
    {% include 'website/sections/_requisites.html.twig' with {
        title: 'Реквизиты компании',
        subtitle: 'Сторона, с которой заключается договор.',
        items: [
            {label: 'Наименование', value: 'ИП Новикова Наталья Анатольевна'},
            {label: 'ИНН', value: '860224303900'},
            {label: 'ОГРНИП', value: '323619600098384'},
            {label: 'Адрес', value: '346781, Россия, Ростовская область, г. Азов, ул. Севастопольская, 81, кв. 76'},
            {label: 'Расчётный счёт', value: '40802810426140004223'},
            {label: 'Банк', value: 'Филиал «Ростовский» АО «Альфа-Банк» (ИНН банка 7728168971)'},
            {label: 'БИК / Корр. счёт', value: '046015207 / 30101810500000000207'},
            {label: 'Связь', value: 'hello@vashfindir.ru'},
        ],
    } only %}
    {% include 'website/sections/_cta_banner.html.twig' with {
        title: 'Обсудим ваши цифры',
        text: 'Оставьте заявку — расскажем, с чего начать и что вы увидите в первые недели.',
        button: {label: 'Оставить заявку', href: path('home') ~ '#lead-form'},
    } only %}
{% endblock %}
