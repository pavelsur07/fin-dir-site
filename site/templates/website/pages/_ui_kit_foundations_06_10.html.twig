{% set radius_samples = [
    {token: 'none', px: '0', use: 'Ячейки таблиц, разделители, полноширинные баннеры'},
    {token: 'xs', px: '4', use: 'Бейджи, чекбоксы, столбцы графиков, теги'},
    {token: 'sm', px: '8', use: 'Тултипы, меню, мелкие кнопки, вложенные блоки'},
    {token: 'md', px: '12', use: 'Кнопки 48 px, поля ввода, селекты, алерты'},
    {token: 'lg', px: '16', use: 'Карточки, тарифы, контейнеры таблиц'},
    {token: 'xl', px: '24', use: 'Модалки, нижние панели, вводные блоки'},
    {token: 'full', px: '∞', use: 'Аватары, переключатели, статусные точки, чипы'}
] %}
{% set radius_map = [
    ['Кнопка 48 / поле ввода', 'md', '12'], ['Кнопка 32–40', 'sm', '8'], ['Бейдж, тег', 'xs', '4'],
    ['Чекбокс', 'xs', '4'], ['Радио, тумблер, аватар', 'full', '∞'], ['Тултип, выпадающее меню', 'sm', '8'],
    ['Карточка, тариф', 'lg', '16'], ['Контейнер таблицы', 'lg', '16'], ['Модальное окно', 'xl', '24'],
    ['Нижняя панель (верхние углы)', 'xl', '24 24 0 0']
] %}
{% set radius_rules = [
    ['01', 'Сдержанная форма', 'Рабочие поверхности — не больше lg 16. Крупный xl оставляем модальным и вводным блокам.'],
    ['02', 'Один ряд — один радиус', 'Кнопка и поле в одной строке имеют одинаковую высоту 48 px и радиус md 12.'],
    ['03', 'Радиус растёт с размером', 'Бейдж 4 → кнопка 12 → карточка 16 → модальное окно 24.'],
    ['04', 'Действие — не pill', 'Для основных действий используем прямоугольный md. Круглая форма подходит фильтрам и статусам.'],
    ['05', 'Данные — ровные', 'Скругляем контейнер таблицы, а не строки, ячейки и ось графика.'],
    ['06', 'Фокус повторяет форму', 'Кольцо фокуса повторяет контур элемента и остаётся видимым при работе с клавиатурой.']
] %}
<section id="radii" class="vf-ui-kit-reference-section" aria-labelledby="radii-title" data-vf-ui-kit-section="radii">
    <div class="vf-ui-kit-reference-heading"><p>06 · Скругления</p><h2 id="radii-title">Шкала радиусов</h2><p>Шаг — 4 px, все значения кратны сетке. Для финансового продукта скругление умеренное: мягкость снимает тревогу, прямые углы данных сохраняют ощущение точности.</p></div>
    <div class="vf-ui-kit-radius-grid">
        {% for radius in radius_samples %}
            <div class="vf-ui-kit-radius-item" data-vf-ui-kit-radius-sample><span class="vf-ui-kit-radius-shape" data-radius="{{ radius.token }}" aria-hidden="true"></span><div><div class="vf-ui-kit-radius-label"><strong>{{ radius.token }}</strong><span>{{ radius.px }}</span></div><small>{{ radius.use }}</small></div></div>
        {% endfor %}
    </div>
    <div class="vf-ui-kit-two-col">
        <div class="vf-ui-kit-reference-card"><h3>Соответствие компонентам</h3><table class="vf-ui-kit-radius-map"><thead><tr><th scope="col">Компонент</th><th scope="col">Токен</th><th scope="col">px</th></tr></thead><tbody>{% for row in radius_map %}<tr data-vf-ui-kit-radius-map-row><th scope="row">{{ row[0] }}</th><td><strong>{{ row[1] }}</strong></td><td>{{ row[2] }}</td></tr>{% endfor %}</tbody></table><p class="vf-ui-kit-demo-note">Целевая шкала макета. Действующие Button и Badge пока используют sm 8; высота Button — минимум 44 px. При выравнивании production-компонентов сверять их отдельно.</p></div>
        <div class="vf-ui-kit-stack">
            <div class="vf-ui-kit-reference-card vf-ui-kit-nesting" data-theme="dark"><h3>Правило вложенности</h3><p>Внутренний радиус = внешний − отступ. Иначе углы расходятся.</p><div class="vf-ui-kit-nesting-pair"><div><span class="vf-ui-kit-nesting-frame"><span class="vf-ui-kit-nesting-correct"></span></span><small>Верно: 24 − 16 = 8</small></div><div><span class="vf-ui-kit-nesting-frame"><span class="vf-ui-kit-nesting-wrong"></span></span><small>Неверно: 24 внутри 24</small></div></div></div>
            <div class="vf-ui-kit-reference-card"><h3>Данные — прямые углы</h3><div class="vf-ui-kit-radius-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><p>Столбцы графика скругляются только сверху. Ячейки таблиц остаются ровными.</p></div>
        </div>
    </div>
    <div><h3>Практические правила</h3><div class="vf-ui-kit-rule-grid">{% for rule in radius_rules %}<div class="vf-ui-kit-rule-card" data-vf-ui-kit-radius-rule><div><b>{{ rule[0] }}</b><strong>{{ rule[1] }}</strong></div><p>{{ rule[2] }}</p></div>{% endfor %}</div></div>
</section>

{% set spacing_rows = [
    ['0.5', '2', 'Обводка и зазор кольца фокуса'], ['1', '4', 'Подпись → значение, иконка в бейдже'],
    ['2', '8', 'Иконка → текст, элементы в группе'], ['3', '12', 'Чипы, пункты списка, строки формы'],
    ['4', '16', 'Опорный модуль, отступы на мобильном'], ['6', '24', 'Карточки, промежуток сетки'],
    ['8', '32', 'Крупные карточки, группы полей'], ['12', '48', 'Заголовок секции → контент'],
    ['16', '64', 'Между секциями на мобильном'], ['24', '96', 'Между секциями на десктопе']
] %}
{% set spacing_roles = [
    ['Иконка → подпись', '8'], ['Кнопка: горизонтальный отступ', '24 (48 px) · 16 (40 px)'],
    ['Поле: отступ / label → поле', '16 / 8'], ['Карточка: отступ', '24 моб · 32 деск'],
    ['Строка таблицы: высота / отступ', '48 / 12 (компактная 40)'], ['Секция: сверху и снизу', '64 моб · 96 деск']
] %}
{% set breakpoints = [
    ['mobile', '< 768', '4', '16', '16', 'резиновый'],
    ['tablet · md', '768–1023', '8', '32', '24', 'резиновый'],
    ['desktop · lg', '1024–1439', '12', '32', '24', 'резиновый'],
    ['wide · xl', '≥ 1440', '12', 'авто', '32', '1200 макс.']
] %}
<section id="spacing" class="vf-ui-kit-reference-section" aria-labelledby="spacing-title" data-vf-ui-kit-section="spacing" data-vf-showcase="spacing">
    <div class="vf-ui-kit-reference-heading"><p>07 · Отступы и сетка</p><h2 id="spacing-title">Пространство</h2><p>Шаг — 4 px, опорный модуль — 16. Отступы берутся только из шкалы. Правило близости: расстояние внутри группы всегда меньше, чем между группами.</p></div>
    <div class="vf-ui-kit-two-col"><div class="vf-ui-kit-reference-card vf-ui-kit-spacing-table"><table><caption class="sr-only">Шкала отступов</caption><thead><tr><th scope="col">Токен</th><th scope="col">px</th><th scope="col">Применение</th></tr></thead><tbody>{% for row in spacing_rows %}<tr data-vf-ui-kit-spacing-row><th scope="row">{{ row[0] }}</th><td>{{ row[1] }}</td><td><i data-spacing="{{ row[0] }}" aria-hidden="true"></i><small>{{ row[2] }}</small></td></tr>{% endfor %}</tbody></table></div>
        <div class="vf-ui-kit-stack"><div class="vf-ui-kit-reference-card vf-ui-kit-muted-card"><h3>Семантические отступы</h3><dl class="vf-ui-kit-role-list">{% for row in spacing_roles %}<div data-vf-ui-kit-spacing-role><dt>{{ row[0] }}</dt><dd>{{ row[1] }}</dd></div>{% endfor %}</dl></div><div class="vf-ui-kit-reference-card"><h3>Близость на примере</h3><div class="vf-ui-kit-proximity"><div><small>Получатель · демо</small><strong>Демонстрационная компания</strong></div><div><small>Сумма · демо</small><strong>48 000 ₽</strong></div></div><small>Подпись → значение: 4 · между полями: 16 · внутренний отступ: 16</small></div></div>
    </div>
    <div class="vf-ui-kit-stack"><h3>Сетка и брейкпоинты</h3><div class="vf-ui-kit-grid-scroll" tabindex="0" role="region" aria-label="Двенадцатиколоночная сетка"><div class="vf-ui-kit-columns">{% for column in 1..12 %}<span data-vf-ui-kit-grid-column>{{ column }}</span>{% endfor %}</div></div><div class="vf-ui-kit-breakpoint-scroll" tabindex="0" role="region" aria-label="Таблица брейкпоинтов"><table><thead><tr><th scope="col">Брейкпоинт</th><th scope="col">Ширина</th><th scope="col">Колонки</th><th scope="col">Поля</th><th scope="col">Gutter</th><th scope="col">Контейнер</th></tr></thead><tbody>{% for row in breakpoints %}<tr data-vf-ui-kit-breakpoint-row><th scope="row">{{ row[0] }}</th>{% for cell in row|slice(1) %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><p>Текстовые блоки — не шире 720 px. Контентная область кабинета меняет ширину вместе с экраном; мобильные T1/T2 включаются ниже 768 px.</p></div>
</section>

{% set shadows = [
    ['flat', 'Карточки, таблицы и поля по умолчанию', 'none'],
    ['sm', 'Hover карточки, закреплённая шапка', '0 1px 2px ink/6%, 0 1px 3px ink/10%'],
    ['md', 'Выпадающие меню, подсказки, тосты', '0 4px 12px −2px ink/12%, 0 2px 4px ink/6%'],
    ['lg', 'Модальные окна и нижние панели', '0 24px 48px −12px ink/28%']
] %}
{% set shadow_rules = [
    'Одна тень на элемент; цветная обводка с тенью не сочетается.',
    'Важное выделяют цветом и типографикой, не глубиной.',
    'Hover карточки: flat → sm за 120 ms, без движения по вертикали.',
    'Внутренние тени допустимы только для кольца фокуса в таблице.'
] %}
<section id="elevation" class="vf-ui-kit-reference-section" aria-labelledby="elevation-title" data-vf-ui-kit-section="elevation">
    <div class="vf-ui-kit-reference-heading"><p>08 · Тени и глубина</p><h2 id="elevation-title">Уровни высоты</h2><p>Тени тонированы ink, а не чистым чёрным. Базовая поверхность плоская — карточка отделяется обводкой. Тень означает «элемент поверх контента», а не украшение.</p></div>
    <div class="vf-ui-kit-shadow-grid">{% for shadow in shadows %}<div data-vf-ui-kit-shadow-sample><div class="vf-ui-kit-shadow-tile" data-shadow="{{ shadow[0] }}">{{ shadow[0] }}</div><strong>{{ shadow[1] }}</strong><code>{{ shadow[2] }}</code></div>{% endfor %}</div>
    <div class="vf-ui-kit-two-col"><div class="vf-ui-kit-reference-card vf-ui-kit-dark-levels" data-theme="dark"><h3>Тёмная тема: глубина через поверхность</h3><p>На тёмном фоне тень малозаметна. Каждый следующий уровень светлее и выделен обводкой.</p><div>{% for level in ['950 · фон', '900 · карточка', '800 · меню', '700 · модальное окно'] %}<span data-vf-ui-kit-dark-level data-level="{{ loop.index }}">{{ level }}</span>{% endfor %}</div></div><div class="vf-ui-kit-reference-card"><h3>Правила</h3><ul class="vf-ui-kit-bullet-list">{% for rule in shadow_rules %}<li data-vf-ui-kit-shadow-rule>{{ rule }}</li>{% endfor %}</ul></div></div>
</section>

{% set icon_samples = [
    ['wallet', 'Счёт'], ['credit-card', 'Карта'], ['arrow-left-right', 'Перевод'], ['receipt', 'Счёт-фактура'],
    ['file-text', 'Документ'], ['landmark', 'Банк'], ['piggy-bank', 'Накопления'], ['trending-up', 'Рост'],
    ['calendar', 'Календарь'], ['shield-check', 'Безопасность'], ['bell', 'Уведомления'], ['download', 'Скачать']
] %}
{% set social_rules = [
    'Знаки площадок — исключение из Lucide: узнаваемые глифы Simple Icons; MAX в эталоне показан знаком Arcticons.',
    'Монохромно: ink 950 на светлом, ink 300 → белый при наведении на ink. Фирменные цвета площадок не используем.',
    'Глиф 20–24 px в зоне касания 44 × 44. Порядок: Telegram, MAX, ВКонтакте.',
    'Иконка без подписи в рабочей ссылке — только с понятным aria-label.',
    'На рабочих страницах показываем только подтверждённые каналы. Этот набор — технический образец.'
] %}
<section id="icons" class="vf-ui-kit-reference-section" aria-labelledby="icons-title" data-vf-ui-kit-section="icons">
    <div class="vf-ui-kit-reference-heading"><p>09 · Иконки</p><h2 id="icons-title">Lucide, линейный стиль</h2><p>Один набор на все поверхности — Lucide (открытая лицензия ISC). Сетка 24, контур 2 px, скруглённые окончания — перекликаются с Manrope и радиусами. Заливные иконки не используем.</p></div>
    <div class="vf-ui-kit-icon-grid">{% for icon in icon_samples %}<div data-vf-ui-kit-icon-sample><img src="/assets/ui-kit/lucide/{{ icon[0] }}.svg?v=0.460.0" alt="" width="24" height="24" loading="lazy"><span>{{ icon[1] }}</span></div>{% endfor %}</div>
    <div class="vf-ui-kit-two-col"><div class="vf-ui-kit-reference-card"><h3>Размеры</h3><div class="vf-ui-kit-icon-sizes">{% for size in [16, 20, 24, 32] %}<div><img src="/assets/ui-kit/lucide/wallet.svg?v=0.460.0" alt="" width="{{ size }}" height="{{ size }}"><small>{{ size }}</small></div>{% endfor %}</div><p>16 — с T6/T7 и в таблицах · 20 — с T5 и в полях · 24 — навигация · 32 — пустые состояния. Область касания — не меньше 44×44 px.</p></div><div class="vf-ui-kit-reference-card"><h3>Цвет и пара с текстом</h3><div class="vf-ui-kit-icon-pairs"><div><span data-vf-icon-mask="wallet"></span>Счёт — цвет текста</div><div class="vf-ui-kit-icon-muted"><span data-vf-icon-mask="wallet"></span>Вторичное — muted</div><div class="vf-ui-kit-icon-accent"><span data-vf-icon-mask="arrow-left-right"></span>Действие — crimson</div><div class="vf-ui-kit-icon-warning"><span data-vf-icon-mask="bell"></span>Статус — цвет статуса</div></div><p>Отступ иконка → текст: 8 px. Смысл всегда сопровождается подписью или доступным именем.</p></div></div>
    <div class="vf-ui-kit-stack"><h3>Соцсети и мессенджеры</h3><div class="vf-ui-kit-two-col"><div class="vf-ui-kit-reference-card"><div class="vf-ui-kit-socials"><div data-vf-ui-kit-social-icon><span class="vf-ui-kit-social-mark" data-brand="telegram" aria-hidden="true"></span><small>Telegram</small></div><div data-vf-ui-kit-social-icon><span class="vf-ui-kit-social-mark" data-brand="max" aria-hidden="true"></span><small>MAX</small></div><div data-vf-ui-kit-social-icon><span class="vf-ui-kit-social-mark" data-brand="vk" aria-hidden="true"></span><small>ВКонтакте</small></div></div><div class="vf-ui-kit-socials-dark" data-theme="dark" role="group" aria-label="Знаки на тёмном фоне"><span class="vf-ui-kit-social-mark" data-brand="telegram" aria-hidden="true"></span><span class="vf-ui-kit-social-mark" data-brand="max" aria-hidden="true"></span><span class="vf-ui-kit-social-mark" data-brand="vk" aria-hidden="true"></span></div><small>Демонстрация композиции, не перечень действующих каналов. Знак MAX — <a href="https://github.com/Arcticons-Team/Arcticons">Arcticons</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</small></div><div class="vf-ui-kit-reference-card vf-ui-kit-muted-card"><ul class="vf-ui-kit-bullet-list">{% for rule in social_rules %}<li data-vf-ui-kit-social-rule>{{ rule }}</li>{% endfor %}</ul></div></div></div>
</section>

{% set state_rows = [
    ['Primary', 'Оплатить', 'primary'], ['Secondary', 'Выписка', 'secondary'],
    ['Outline', 'Отмена', 'outline'], ['Поле ввода', 'Сумма', 'input'], ['Строка таблицы', 'Аренда', 'row']
] %}
{% set state_rules = [
    ['Защита от двойного платежа', 'После нажатия кнопка сразу переходит в loading, блокируется и сохраняет ширину. Повторный клик игнорируется до ответа сервера.'],
    ['Фокус всегда виден', 'Кольцо 2 px белого + 2 px crimson через box-shadow; на ink — 2 px ink + 2 px crimson 400. Показывается при :focus-visible; outline: none без замены запрещён.'],
    ['Disabled объясняет причину', 'Недоступная кнопка сопровождается подсказкой: «Заполните ИНН получателя». Контраст disabled не нормируется, но он не выглядит активным.'],
    ['Скелетоны вместо спиннеров', 'Таблицы и карточки показывают скелетоны в форме контента. Спиннер — только внутри кнопки или поля. Скелетон пульсирует 1,5 s; при reduced motion он статичен.'],
    ['Цвет не единственный сигнал', 'Ошибка поля — красная обводка, иконка и текст под полем. Состояние выбора — цвет и отметка.'],
    ['Active без сдвига', 'Нажатие темнит заливку на ступень. Без scale и смещения: в интерфейсе с суммами ничего не «прыгает».']
] %}
<section id="components" class="vf-ui-kit-reference-section" aria-labelledby="interactive-states-title" data-vf-ui-kit-section="interactive-states">
    <div class="vf-ui-kit-reference-heading"><p>10 · Состояния</p><h2 id="interactive-states-title">Интерактивные состояния</h2><p>Шесть состояний у каждого интерактивного элемента. Переход — 120 ms ease-out. Hover и active смещают цвет на одну–две ступени шкалы, форма и размер не меняются.</p></div>
    <div class="vf-ui-kit-state-scroll" tabindex="0" role="region" aria-label="Матрица состояний элементов">
        <table class="vf-ui-kit-state-matrix">
            <thead><tr><th scope="col">Элемент</th>{% for state in ['Default', 'Hover', 'Active', 'Focus', 'Disabled', 'Loading'] %}<th scope="col">{{ state }}</th>{% endfor %}</tr></thead>
            <tbody>{% for row in state_rows %}<tr data-vf-ui-kit-state-row><th scope="row">{{ row[0] }}</th>{% for state in ['default', 'hover', 'active', 'focus', 'disabled', 'loading'] %}<td><span class="vf-ui-kit-state-cell" data-vf-ui-kit-state-cell data-kind="{{ row[2] }}" data-state="{{ state }}">{% if state == 'loading' and row[2] == 'row' %}<span class="vf-ui-kit-skeleton-pair" role="img" aria-label="Загрузка строки таблицы"><i class="vf-ui-kit-skeleton" aria-hidden="true"></i><i class="vf-ui-kit-skeleton" aria-hidden="true"></i></span>{% else %}{% if state == 'loading' and row[2] != 'row' %}<i class="vf-ui-kit-spinner" aria-hidden="true"></i>{% endif %}{% if row[2] == 'row' %}<span>{{ row[1] }}</span><span>−84&nbsp;000</span>{% elseif row[2] == 'input' %}{{ state in ['active', 'focus', 'loading'] ? '12 400 ₽' : row[1] }}{% else %}{{ state == 'loading' ? 'Загрузка' : row[1] }}{% endif %}{% endif %}</span></td>{% endfor %}</tr>{% endfor %}</tbody>
        </table>
    </div>
    <p class="vf-ui-kit-demo-note">Матрица показывает внешний вид состояний. Суммы и операции — демонстрационные; образцы статичны.</p>
    <div class="vf-ui-kit-rule-grid">{% for rule in state_rules %}<div class="vf-ui-kit-rule-card" data-vf-ui-kit-state-rule><strong>{{ rule[0] }}</strong><p>{{ rule[1] }}</p></div>{% endfor %}</div>
</section>
