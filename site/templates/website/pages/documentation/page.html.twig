{% extends 'website/layouts/docs.html.twig' %}
{% block title %}{{ page.meta_title ?: page.title }} — Ваш Финдир{% endblock %}
{% block description %}{{ page.meta_description ?: page.description }}{% endblock %}
{% block docs_content %}
{% include 'website/components/_breadcrumbs.html.twig' with {crumbs: [{label: 'База знаний', url: doc_url('docs_home')}, {label: page.section_title, url: doc_url('docs_section', page.section_slug)}, {label: page.title}]} only %}
<article>
    <h1 class="type-t2 md:type-t1">{{ page.title }}</h1>
    <p class="mt-4 text-fg-secondary">{{ page.description }}</p>
    <p class="my-4 type-t7 text-fg-muted">Обновлено <time datetime="{{ page.updated_at|date('c') }}">{{ page.updated_at|date('d.m.Y') }}</time></p>
    {% include 'website/sections/docs/_toc.html.twig' with {toc: article.toc} only %}
    <div class="mt-6 min-w-0 break-words">{{ article.html|raw }}</div>
</article>
{% include 'website/sections/docs/_related.html.twig' with {related: related} only %}
{% include 'website/sections/docs/_sequence.html.twig' with {previous: previous, next: next} only %}
{% endblock %}
