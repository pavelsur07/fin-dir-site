{% extends 'website/layouts/page.html.twig' %}

{# Результат отправки формы без JavaScript. Техническая страница: не индексируется. #}
{% block title %}{{ success ? 'Заявка отправлена' : 'Заявка не отправлена' }} — Ваш Финдир{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold">{{ success ? 'Спасибо, заявка отправлена' : 'Заявка не отправлена' }}</h1>
    <p>{{ success
        ? 'Мы свяжемся с вами в ближайшее время по указанному контакту.'
        : 'Исправьте данные и отправьте форму ещё раз. Быстрее всего связаться с нами в Telegram: @vashfindir_ru.' }}</p>
    {% if errors %}
        <ul class="list-disc pl-6">
            {% for message in errors %}<li>{{ message }}</li>{% endfor %}
        </ul>
    {% endif %}
    <p><a class="underline" href="{{ back_url }}">Вернуться на страницу</a></p>
{% endblock %}
