{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "environment", "resourceAudience", "clients"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,60}$"},
    "environment": {"enum": ["dev", "smoke", "staging", "production"]},
    "resourceAudience": {"type": "string", "minLength": 4, "maxLength": 2048, "pattern": "^(https://|urn:)[^ *]+$"},
    "clients": {"type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["clientId", "type", "allowedScopes", "secretRef"],
        "properties": {
          "clientId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,100}$"},
          "type": {"const": "m2m"},
          "allowedScopes": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"}},
          "secretRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,100}$"}
        }
      }
    }
  }
}
