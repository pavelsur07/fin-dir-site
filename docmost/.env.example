# Generate a private file with make docmost-init. Never commit actual values.
DOCMOST_APP_SECRET=
DOCMOST_DB_PASSWORD=

# Keep false until the initial workspace owner has been created via SSH tunnel.
DOCMOST_PUBLIC=false

# Optional SMTP: invitations and password reset require working email delivery.
DOCMOST_SMTP_HOST=
DOCMOST_SMTP_PORT=587
DOCMOST_SMTP_USERNAME=
DOCMOST_SMTP_PASSWORD=
DOCMOST_SMTP_SECURE=false
DOCMOST_MAIL_FROM_ADDRESS=
